---
import horoscopeData from '../data/horoscope.json'; 

const allHoroscopes = horoscopeData.predictions;

const getZodiacSymbol = (signName: string) => {
    const symbols: Record<string, string> = {
        "dashi": "♈",
        "demi": "♉",
        "binjakët": "♊",
        "binjaket": "♊",
        "gaforrja": "♋",
        "luani": "♌",
        "virgjëresha": "♍",
        "virgjeresha": "♍",
        "peshorja": "♎",
        "akrepi": "♏",
        "shigjetari": "♐",
        "bricjapi": "♑",
        "ujori": "♒",
        "peshqit": "♓"
    };
    return symbols[signName.toLowerCase()] || "✨";
};

const randomSign = allHoroscopes[Math.floor(Math.random() * allHoroscopes.length)];
const symbol = getZodiacSymbol(randomSign.sign);
---

<section class="w-full bg-white py-16 md:py-24 px-4 flex justify-center border-t border-slate-200">
    <div class="w-full max-w-2xl text-center flex flex-col items-center relative mt-4">

        <div class="bg-[#FAFAFA] border border-slate-200 p-6 md:p-14 rounded-2xl shadow-sm relative w-full hover:shadow-md transition-shadow duration-500">
            
            <div class="absolute -top-3 md:-top-3.5 left-1/2 -translate-x-1/2 bg-[#0f172a] px-4 md:px-5 py-1 md:py-1.5 rounded-full shadow-md whitespace-nowrap z-20">
                <span class="text-white font-black text-[9px] md:text-[10px] uppercase tracking-widest">
                    Horoskopi i Ditës
                </span>
            </div>

            <div class="flex items-center justify-center gap-2 md:gap-3 mb-4 md:mb-6 mt-2">
                <span class="text-2xl md:text-4xl text-slate-300 font-sans leading-none select-none">{symbol}</span>
                <h3 class="font-bookerly font-black text-2xl md:text-4xl text-[#DC2626] capitalize tracking-wide m-0">
                    {randomSign.sign}
                </h3>
                <span class="text-2xl md:text-4xl text-slate-300 font-sans leading-none select-none">{symbol}</span>
            </div>
            
            <p class="font-serif text-[15px] md:text-xl text-slate-700 leading-relaxed italic px-2 md:px-8">
                "{randomSign.text}"
            </p>

        </div>

    </div>
</section>