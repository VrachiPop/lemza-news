---
import horoscopeData from '../data/horoscope.json'; 

const allHoroscopes = horoscopeData.predictions;

const getZodiacSymbol = (signName: string) => {
    const symbols: Record<string, string> = {
        "dashi": "♈",
        "demi": "♉",
        "binjakët": "♊",
        "binjaket": "♊",
        "gaforrja": "♋",
        "luani": "♌",
        "virgjëresha": "♍",
        "virgjeresha": "♍",
        "peshorja": "♎",
        "akrepi": "♏",
        "shigjetari": "♐",
        "bricjapi": "♑",
        "ujori": "♒",
        "peshqit": "♓"
    };
    return symbols[signName.toLowerCase()] || "✨";
};

const randomSign = allHoroscopes[Math.floor(Math.random() * allHoroscopes.length)];
const symbol = getZodiacSymbol(randomSign.sign);
---

<div class="relative bg-white border border-slate-200 p-5 md:p-8 min-h-[220px] flex flex-col justify-center rounded-xl shadow-sm group hover:shadow-md transition-all mt-4 md:mt-0">
        
    <div class="absolute -top-3.5 left-4 md:left-6 bg-[#0f172a] px-3 md:px-4 py-1 rounded-full shadow-sm whitespace-nowrap z-20">
        <span class="text-white font-black text-[10px] md:text-xs tracking-widest uppercase">
            Horoskopi
        </span>
    </div>

    <div class="flex items-center gap-3 mb-2 mt-1">
        <span class="text-3xl md:text-4xl text-slate-300 font-sans leading-none select-none">{symbol}</span>
        <h3 class="font-bookerly font-black text-xl md:text-2xl text-[#DC2626] capitalize tracking-wide m-0">
            {randomSign.sign}
        </h3>
    </div>
    
    <p class="font-serif text-[14px] md:text-[15px] text-slate-700 leading-relaxed italic">
        "{randomSign.text}"
    </p>

</div>