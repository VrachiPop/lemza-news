---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import FormattedDate from "../FormattedDate.astro";
import "../../app.css";

import { getDisplayTag, getPostUrl } from "../../utils/helpers";

const allPosts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const mainPost = allPosts[0];
const titleText = mainPost.data.title;
---

<section class="relative w-full h-[100dvh] overflow-hidden bg-slate-900 group">
    <a href={getPostUrl(mainPost.slug)} class="block w-full h-full">
        {
            mainPost.data.heroImage && (
                <Image
                    src={mainPost.data.heroImage}
                    alt={mainPost.data.title}
                    width={2000}
                    height={1125}
                    loading="eager"
                    fetchpriority="high"
                    class="absolute inset-0 w-full h-full object-cover transition-transform duration-[2000ms] group-hover:scale-105"
                />
            )
        }

        <div
            class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"
        >
        </div>

        <div
            class="absolute bottom-0 left-0 right-0 flex flex-col items-center justify-end p-5 pb-20 md:p-8 md:pb-24 text-center z-20 mx-auto max-w-[1300px]"
        >
            <span
                class="bg-[#DC2626] text-white px-3 md:px-4 py-1 md:py-1.5 text-[10px] md:text-xs font-black uppercase tracking-widest rounded-full shadow-lg mb-3 md:mb-6"
            >
                {
                    mainPost.data.tags && mainPost.data.tags.length > 0
                        ? getDisplayTag(mainPost.data.tags[0])
                        : "LAJME"
                }
            </span>

            {/* Madhësi fikse dhe responsive e titullit, e integruar direkt në klasat e HTML */}
            <h1
                class="font-bookerly font-black leading-tight text-white drop-shadow-2xl mb-3 md:mb-5 group-hover:text-slate-100 transition-colors px-2 md:px-4 line-clamp-4 mx-auto text-xl sm:text-2xl md:text-3xl lg:text-4xl max-w-6xl"
            >
                {titleText}
            </h1>

            <div
                class="text-white/80 text-[10px] md:text-sm font-black uppercase tracking-widest flex items-center gap-2 mt-2 md:mt-3"
            >
                <FormattedDate date={mainPost.data.pubDate} />
            </div>
        </div>
    </a>
</section>