---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import FormattedDate from "../FormattedDate.astro";
import "../../app.css";

// Importi i trurit qendror për kategoritë dhe linqet
import { getDisplayTag, getPostUrl } from "../../utils/helpers";

// 1. Merr VETËM postimin e fundit
const allPosts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const mainPost = allPosts[0];
---

{/* Ndryshuam përmasat: Hoqëm lartësinë fikse dhe vendosëm 'aspect-video' (16:9) */}
<section class="relative w-full aspect-video min-h-[350px] sm:min-h-0 overflow-hidden bg-slate-900 group rounded-2xl mb-12 shadow-md">
    <a href={getPostUrl(mainPost.slug)} class="block w-full h-full">
        {
            mainPost.data.heroImage && (
                <Image
                    src={mainPost.data.heroImage}
                    alt={mainPost.data.title}
                    width={1600}
                    height={900}
                    loading="eager"
                    fetchpriority="high"
                    class="absolute inset-0 w-full h-full object-cover transition-transform duration-[2000ms] group-hover:scale-105"
                />
            )
        }

        <div
            class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent opacity-90"
        >
        </div>

        {/* Rregulluam padding-un (hapësirat) që teksti të përshtatet perfekt në 16:9 edhe në celular */}
        <div
            class="absolute bottom-0 left-0 right-0 flex flex-col items-center justify-end p-4 pb-8 md:p-8 md:pb-12 text-center z-20 h-full"
        >
            <span
                class="bg-[#DC2626] text-white px-4 py-1.5 text-[10px] md:text-xs font-black uppercase tracking-widest rounded-sm shadow-lg mb-3 md:mb-5"
            >
                {
                    mainPost.data.tags && mainPost.data.tags.length > 0
                        ? getDisplayTag(mainPost.data.tags[0])
                        : "LAJME"
                }
            </span>

            <h1
                class="font-bookerly max-w-full text-2xl sm:text-2xl md:text-3xl lg:text-3xl font-black leading-tight text-white drop-shadow-2xl mb-2 md:mb-4 group-hover:text-slate-100 transition-colors px-2 line-clamp-4"
            >
                {mainPost.data.title}
            </h1>

            <div
                class="text-white/80 text-[10px] md:text-sm font-bold uppercase tracking-widest flex items-center gap-2 mt-1 md:mt-2"
            >
                <FormattedDate date={mainPost.data.pubDate} />
            </div>
        </div>
    </a>
</section>