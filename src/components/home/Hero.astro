---
import { getCollection } from 'astro:content';

// 1. Fetch posts specifically for Hero (Top 4)
const allPosts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const heroPosts = allPosts.slice(0, 4);

// Helper for Tags
const tagNames = {
   'politike': 'Politikë', 'ekonomi': 'Ekonomi', 'showbiz': 'Showbiz',
   'sport': 'Sport', 'kulture': 'Kulturë', 'kronike': 'Kronikë',
   'sociale': 'Sociale', 'tekno-shkence': 'Tekno & Shkencë',
   'shendeti': 'Shëndeti', 'rajoni': 'Rajoni', 'bota': 'Bota'
};

// Helper for URL
function getPostUrl(slug: string) {
    const fileName = slug.split('/').pop() || '';
    const cleanSlug = fileName.replace(/\.md$/, '');
    return `/${cleanSlug}/`;
}
---

<style>
    /* Styles specific to Hero only */
    .slider-dot {
        width: 40px;
        height: 4px;
        background-color: rgba(255, 255, 255, 0.3);
        transition: all 0.3s;
        cursor: pointer;
    }
    .slider-dot.active {
        background-color: #DC2626;
    }
</style>

<section class="relative w-full h-screen overflow-hidden bg-slate-900 group/slider">
            
    {heroPosts.map((post, index) => (
        <div 
            class={`hero-slide absolute inset-0 w-full h-full transition-opacity duration-1000 ease-in-out ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
            data-index={index}
        >
            <a href={getPostUrl(post.slug)} class="block w-full h-full cursor-pointer">
                <img 
                    src={post.data.heroImage} 
                    alt={post.data.title} 
                    class="absolute inset-0 h-full w-full object-cover" 
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent opacity-80"></div>

                <div class="absolute bottom-0 left-0 right-0 flex flex-col items-center justify-end p-6 pb-24 text-center z-20">
                    <span class="mb-6 inline-block bg-[#DC2626] px-3 py-1 text-[12px] font-black uppercase tracking-widest text-white shadow-lg rounded-md">
                        {post.data.tags && post.data.tags.length > 0 ? (tagNames as any)[post.data.tags[0]] : 'Kryesore'}
                    </span>
                    <h1 class="max-w-6xl font-['Literata',serif] text-4xl font-bold leading-tight text-white! drop-shadow-lg md:text-6xl lg:text-7xl">
                        {post.data.title}
                    </h1>
                </div>
            </a>
        </div>
    ))}

    <button 
        onclick="prevSlide()" 
        class="hero-arrow absolute left-2 md:left-4 top-1/2 z-30 -translate-y-1/2 rounded-full bg-white/10 p-2 md:p-3 text-white backdrop-blur-sm transition-all hover:bg-white/20 hover:scale-110 active:scale-95 flex items-center justify-center cursor-pointer"
        aria-label="Previous Slide"
    >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-6 md:size-8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
        </svg>
    </button>

    <button 
        onclick="nextSlideManual()" 
        class="hero-arrow absolute right-2 md:right-4 top-1/2 z-30 -translate-y-1/2 rounded-full bg-white/10 p-2 md:p-3 text-white backdrop-blur-sm transition-all hover:bg-white/20 hover:scale-110 active:scale-95 flex items-center justify-center cursor-pointer"
        aria-label="Next Slide"
    >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-6 md:size-8">
            <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
        </svg>
    </button>

    <div class="absolute bottom-8 left-0 right-0 z-30 flex justify-center gap-2">
        {heroPosts.map((_, index) => (
            <button 
                class={`slider-dot rounded-full ${index === 0 ? 'active' : ''}`} 
                onclick={`manualChangeSlide(${index})`}
                aria-label={`Go to slide ${index + 1}`}
            ></button>
        ))}
    </div>

</section>

<script is:inline>
    // Logic encapsulated for the Hero Slider
    let currentSlide = 0;
    const slides = document.querySelectorAll('.hero-slide');
    const dots = document.querySelectorAll('.slider-dot');
    const totalSlides = slides.length;
    const slideDuration = 8000; 
    let slideInterval;

    function showSlide(index) {
        slides.forEach(slide => {
            slide.classList.remove('opacity-100', 'z-10');
            slide.classList.add('opacity-0', 'z-0');
        });
        dots.forEach(dot => dot.classList.remove('active'));

        slides[index].classList.remove('opacity-0', 'z-0');
        slides[index].classList.add('opacity-100', 'z-10');
        dots[index].classList.add('active');
        
        currentSlide = index;
    }

    function nextSlide() {
        let next = (currentSlide + 1) % totalSlides;
        showSlide(next);
    }

    function prevSlide() {
        let prev = (currentSlide - 1 + totalSlides) % totalSlides;
        resetTimer();
        showSlide(prev);
    }

    function nextSlideManual() {
        resetTimer();
        nextSlide();
    }

    function manualChangeSlide(index) {
        resetTimer();
        showSlide(index);
    }

    function resetTimer() {
        clearInterval(slideInterval);
        slideInterval = setInterval(nextSlide, slideDuration);
    }

    if(totalSlides > 0) {
        slideInterval = setInterval(nextSlide, slideDuration);
    }
</script>