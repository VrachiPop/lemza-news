---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from '../FormattedDate.astro';
import  '../../app.css';

// 1. Merr VETËM postimin e fundit
const allPosts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const mainPost = allPosts[0]; 

const tagNames = {
   'politike': 'Politikë', 'ekonomi': 'Ekonomi', 'showbiz': 'Showbiz',
   'sport': 'Sport', 'kulture': 'Kulturë', 'kronike': 'Kronikë',
   'sociale': 'Sociale', 'tekno-shkence': 'Tekno & Shkencë',
   'shendeti': 'Shëndeti', 'rajoni': 'Rajoni', 'bota': 'Bota'
};

function getPostUrl(slug: string) {
    const fileName = slug.split('/').pop() || '';
    const cleanSlug = fileName.replace(/\.md$/, '');
    return `/${cleanSlug}/`;
}
---

<section class="relative w-full h-[100dvh] overflow-hidden bg-slate-900 group">
    
    <a href={getPostUrl(mainPost.slug)} class="block w-full h-full">
        
        {mainPost.data.heroImage && (
            <Image 
                src={mainPost.data.heroImage} 
                alt={mainPost.data.title}
                width={1600}
                height={900}
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-[2000ms] group-hover:scale-105" 
            />
        )}
        
        <div class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent opacity-90"></div>

        <div class="absolute bottom-0 left-0 right-0 flex flex-col items-center justify-end p-6 pb-16 md:p-6 md:pb-24 text-center z-20">
            
            <span class="bg-[#DC2626] text-white px-3 py-1 text-[10px] md:text-xs font-black uppercase tracking-widest rounded-sm shadow-lg mb-4 md:mb-6">
                {
                    mainPost.data.tags && mainPost.data.tags.length > 0 
                    ? (tagNames as any)[mainPost.data.tags[0]] || mainPost.data.tags[0] 
                    : 'LAJME'
                }
            </span>

            <h1 class="font-bookerly max-w-full md:max-w-6xl text-3xl md:text-4xl lg:text-4xl font-bold leading-tight text-white drop-shadow-2xl mb-3 md:mb-6 group-hover:text-slate-100 transition-colors px-2">
                {mainPost.data.title}
            </h1>
            
            <div class="text-white/80 text-[10px] md:text-sm font-bold uppercase tracking-widest flex items-center gap-2 mt-1 md:mt-2">
                <FormattedDate date={mainPost.data.pubDate} />
            </div>
        </div>
    </a>

</section>