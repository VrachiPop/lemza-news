---
import { getCollection } from 'astro:content';
import FormattedDate from '../FormattedDate.astro';
import  '../../app.css';

// 1. Merr VETËM postimin e fundit
const allPosts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const mainPost = allPosts[0]; 

const tagNames = {
   'politike': 'Politikë', 'ekonomi': 'Ekonomi', 'showbiz': 'Showbiz',
   'sport': 'Sport', 'kulture': 'Kulturë', 'kronike': 'Kronikë',
   'sociale': 'Sociale', 'tekno-shkence': 'Tekno & Shkencë',
   'shendeti': 'Shëndeti', 'rajoni': 'Rajoni', 'bota': 'Bota'
};

function getPostUrl(slug: string) {
    const fileName = slug.split('/').pop() || '';
    const cleanSlug = fileName.replace(/\.md$/, '');
    return `/${cleanSlug}/`;
}

function getTag(post: any) {
    return post.data.tags && post.data.tags.length > 0 ? (tagNames as any)[post.data.tags[0]] : 'KRYESORE';
}
---

<section class="relative w-full h-screen overflow-hidden bg-slate-900 group">
    
    <a href={getPostUrl(mainPost.slug)} class="block w-full h-full">
        
        <img 
            src={mainPost.data.heroImage} 
            alt={mainPost.data.title} 
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-[2000ms] group-hover:scale-105" 
        />
        
        <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent opacity-90"></div>

        <div class="absolute bottom-0 left-0 right-0 flex flex-col items-center justify-end p-6 pb-24 text-center z-20">
            
            <span class="mb-6 inline-block bg-[#DC2626] px-3 py-1 text-[12px] font-black uppercase tracking-widest text-white shadow-lg rounded-xs transform group-hover:-translate-y-1 transition-transform duration-300">
                {getTag(mainPost)}
            </span>

            <h1 class="font-news max-w-6xl text-5xl! md:text-6xl lg:text-7xl font-bold leading-tight text-white! drop-shadow-2xl mb-4 group-hover:text-slate-100 transition-colors">
                {mainPost.data.title}
            </h1>
            
            <div class="text-white/80 text-sm font-bold uppercase tracking-widest flex items-center gap-2 mt-4">
                <FormattedDate date={mainPost.data.pubDate} />
            </div>
        </div>
    </a>

</section>