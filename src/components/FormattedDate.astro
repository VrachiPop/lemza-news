---
interface Props {
	date: Date | string; // Pranojmë edhe tekst, edhe datë
}

const { date } = Astro.props;
// Kjo rresht e kthen çdo gjë në Datë reale, kështu që nuk del më error
const myDate = new Date(date);
---

<time datetime={myDate.toISOString()}>
	{
		myDate.toLocaleDateString('en-us', {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		})
	}
</time>