---
// src/components/EditorialBanner.astro
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  subtitle?: string; 
}

const { title, subtitle } = Astro.props;
const normalizedTitle = title.toLowerCase();

const fileMap: Record<string, string> = {
    "lemza news": "home",
    "të fundit": "te-fundit",
    "politikë": "politike",
    "ekonomi": "ekonomi",
    "sociale": "sociale",
    "kronikë": "kronike",
    "shëndeti": "shendeti",
    "rajoni": "rajoni",
    "bota": "bota",
    "sport": "sport",
    "kulturë": "kulture",
    "udhëtime": "udhetime",
    "showbiz": "showbiz",
    "shkencë": "shkence",
    "teknologji": "teknologji",
    "rreth nesh": "about",
    "politika e privatësisë": "privacy",
    "sondazhi i ditës": "sondazh",
    "kërko": "kerko",
    "op-ed": "op-ed",
};

const fileName = fileMap[normalizedTitle];
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/banners/*.{jpeg,jpg,png,webp}');

const matchingKey = Object.keys(images).find(key => key.includes(`/${fileName}.`));
const defaultKey = Object.keys(images).find(key => key.includes(`/default-banner.`));

let bgImageUrl = "";
if (fileName && matchingKey) {
    const imgModule = await images[matchingKey]();
    bgImageUrl = imgModule.default.src;
} else if (defaultKey) {
    const imgModule = await images[defaultKey]();
    bgImageUrl = imgModule.default.src;
}

const overlayColorClass = "bg-[#0f172a]";
---

<section class={`relative w-full h-[50vh] min-h-[400px] flex items-center justify-center overflow-hidden font-bookerly ${bgImageUrl === "" ? overlayColorClass : ""}`}>
    
    {bgImageUrl !== "" && (
        <div 
            class="absolute inset-0 w-full h-full bg-cover bg-center z-0"
            style={`background-image: url('${bgImageUrl}');`}
        ></div>
    )}

    <div class={`absolute inset-0 ${overlayColorClass} ${bgImageUrl !== "" ? "opacity-80" : "opacity-100"} mix-blend-multiply z-10`}></div>

    {/* NDRYSHIMI KËTU: items-start, text-left, justify-end, dhe pb-12 md:pb-16 */}
    <div class="relative z-20 max-w-[1600px] mx-auto px-4 md:px-8 flex flex-col items-start text-left text-white pt-[80px] pb-12 md:pb-16 justify-end h-full w-full">
        <h1 class="fade-up-title font-black text-4xl md:text-5xl lg:text-6xl uppercase tracking-tight mb-4 drop-shadow-xl">
            {title}
        </h1>

        {subtitle && (
            <p 
                class="fade-up-subtitle text-xl md:text-2xl font-serif uppercase tracking-[0.1em] drop-shadow-sm leading-relaxed"
                set:html={subtitle} 
            />
        )}
    </div>
</section>

<style is:global>
    /* ========================================= */
    /* 1. ANIMACIONET E HYRJES (FADE UP)         */
    /* ========================================= */
    .fade-up-title {
        animation: fadeUpAnim 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
        will-change: transform, opacity;
    }

    .fade-up-subtitle {
        animation: fadeUpAnim 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
        will-change: transform, opacity;
    }

    @keyframes fadeUpAnim {
        0% {
            opacity: 0;
            transform: translateY(30px);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ========================================= */
    /* 2. LOGJIKA E STRIKETHROUGH                */
    /* ========================================= */
    .strike-text {
        position: relative;
        display: inline-block;
        animation: fadeOutText 0.4s ease 1.2s both;
    }

    .strike-text::after {
        content: "";
        position: absolute;
        left: -5%;
        top: 50%;
        height: 4px;
        background-color: #DC2626;
        transform: translateY(-50%) rotate(-2deg);
        border-radius: 2px;
        box-shadow: 0 0 8px rgba(220, 38, 38, 0.4);
        animation: drawStrike 0.2s cubic-bezier(0.65, 0, 0.35, 1) 0.8s both;
    }

    /* ========================================= */
    /* 3. SHFAQJA E "RRENA" (KUTIA E JASHTME)    */
    /* ========================================= */
    .reveal-text {
        display: inline-block;
        overflow: hidden;
        vertical-align: bottom;
        color: white; 
        text-shadow: 0 0 15px rgba(220, 38, 38, 0.3);
        white-space: nowrap; /* E mban fjalën në një rresht */
        /* Kutia hapet butësisht (0.4s) për t'i bërë vend shkronjave */
        animation: expandBox 0.4s ease-out 1s both;
    }

    /* ========================================= */
    /* 4. TYPEWRITER EFFECT PËR SHKRONJAT        */
    /* ========================================= */
    .type-letter {
        opacity: 0;
        display: inline-block;
    }

    /* Viza mbaron në 1.4s. Fillojmë të shkruajmë direkt! */
    .type-letter:nth-child(1) { animation: typePop 0.05s both 1.4s; }  /* rr */
    .type-letter:nth-child(2) { animation: typePop 0.05s both 1.5s; }  /* e */
    .type-letter:nth-child(3) { animation: typePop 0.05s both 1.6s; }  /* n */
    .type-letter:nth-child(4) { animation: typePop 0.05s both 1.7s; }  /* a. */

    /* KEYFRAMES */
    @keyframes fadeOutText {
        0% { color: rgba(255, 255, 255, 1); }
        100% { color: rgba(255, 255, 255, 0.4); }
    }

    @keyframes drawStrike {
        0% { width: 0; }
        100% { width: 110%; }
    }

    @keyframes expandBox {
        0% {
            max-width: 0;
            opacity: 0;
        }
        100% {
            max-width: 150px;
            opacity: 1;
        }
    }

    @keyframes typePop {
        0% { opacity: 0; }
        100% { opacity: 1; }
    }
</style>