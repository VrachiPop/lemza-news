---
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
const normalizedTitle = title.toLowerCase();

// 1. Lidh titujt me emrat bazë të skedarëve
const fileMap: Record<string, string> = {
    "të fundit": "te-fundit",
    "politikë": "politike",
    "ekonomi": "ekonomi",
    "sociale": "sociale",
    "kronikë": "kronike",
    "shëndeti": "shendeti",
    "rajoni": "rajoni",
    "bota": "bota",
    "sport": "sport",
    "kulturë": "kulture",
    "showbiz": "showbiz",
    "shkencë": "shkence",
    "teknologji": "teknologji",
    "rreth nesh": "about",
    "politika e privatësisë": "privacy",
    "sondazh": "sondazh",
};

const fileName = fileMap[normalizedTitle];

// 2. Skanon dosjen për të gjitha fotot e mundshme
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/banners/*.{jpeg,jpg,png,webp}');

// 3. LOGJIKA E RE: Gjej shtegun e saktë pavarësisht prapashtesës (.png, .jpg, etj)
// Kërkojmë nëse ndonjë nga files që gjeti mbaron me "/te-fundit.png" ose "/te-fundit.jpg" etj.
const matchingKey = Object.keys(images).find(key => key.includes(`/${fileName}.`));
const defaultKey = Object.keys(images).find(key => key.includes(`/default-banner.`));

let bgImageUrl = "";

// 4. Ngarko foton nëse u gjet
if (fileName && matchingKey) {
    const imgModule = await images[matchingKey]();
    bgImageUrl = imgModule.default.src;
} else if (defaultKey) {
    const imgModule = await images[defaultKey]();
    bgImageUrl = imgModule.default.src;
}

const overlayColorClass = "bg-[#0f172a]";
---

<section class={`relative w-full h-[50vh] min-h-[400px] flex items-center justify-center overflow-hidden font-bookerly ${bgImageUrl === "" ? overlayColorClass : ""}`}>
    
    {bgImageUrl !== "" && (
        <div 
            class="absolute inset-0 w-full h-full bg-cover bg-center z-0"
            style={`background-image: url('${bgImageUrl}');`}
            role="img"
            aria-label={title}
        ></div>
    )}

    <div class={`absolute inset-0 ${overlayColorClass} ${bgImageUrl !== "" ? "opacity-80" : "opacity-100"} z-10`}></div>

    <div class="relative z-20 max-w-[1600px] mx-auto px-4 md:px-8 flex flex-col items-start justify-end text-left text-white pt-[80px] pb-16 h-full w-full">
        <h1 class="font-black text-4xl md:text-5xl lg:text-7xl uppercase tracking-tight mb-3 drop-shadow-md">
            {title}
        </h1>

        {subtitle && (
            <p class="text-lg md:text-xl max-w-2xl font-medium opacity-90 drop-shadow-sm leading-relaxed">
                {subtitle}
            </p>
        )}
    </div>
</section>