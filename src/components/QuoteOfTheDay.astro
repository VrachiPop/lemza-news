---
import { getCollection } from 'astro:content';
import { getPostUrl } from '../utils/helpers';

const allPosts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const quotePost = allPosts.find(post => post.data.quoteOfTheDay);

const quoteText = quotePost?.data.quoteOfTheDay || "Sot të gjithë heshtën. Ose po gënjejnë në heshtje.";
const quoteUrl = quotePost ? getPostUrl(quotePost.slug || "") : "/";
---

<div class="relative bg-white border border-slate-200 p-6 md:p-10 rounded-xl shadow-sm group hover:shadow-md hover:border-slate-300 transition-all mt-4 md:mt-6 mb-6 md:mb-8">
    
    <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-[#DC2626] px-3 md:px-4 py-0.5 md:py-1 rounded-full shadow-sm whitespace-nowrap">
        <span class="text-white font-black text-[10px] md:text-sm tracking-widest uppercase">
            Thënia e Ditës
        </span>
    </div>

    <div class="relative z-10 flex flex-col items-center text-center mt-2 md:mt-0">
        
        <span class="text-[#DC2626] text-5xl md:text-6xl font-serif leading-none mb-1 md:mb-2">&ldquo;</span>

        <p class="font-serif text-[15px] md:text-lg font-normal text-slate-800 leading-relaxed mb-5 md:mb-6 italic px-2 md:px-0">
            {quoteText}
        </p>
        
        <div class="w-10 md:w-12 h-[2px] bg-slate-200 mb-4 md:mb-5 transition-all duration-300 group-hover:bg-[#DC2626] group-hover:w-16"></div>
        
        <a href={quoteUrl} class="flex items-center gap-1.5 md:gap-2 text-[10px] md:text-xs font-bold text-slate-500 tracking-widest uppercase hover:text-[#DC2626] transition-colors no-underline">
            Lexoni më shumë <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
        </a>
    </div>
</div>