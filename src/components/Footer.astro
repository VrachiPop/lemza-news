<style>
	/* --- COLORS --- */
	:root {
		--footer-bg: #373D49;
		--footer-text: #B0B3B8;
		--footer-heading: #FFFFFF;
		--input-bg: #4E545F;
		--border-color: #4E545F;
	}

	footer {
		background: var(--footer-bg);
		color: var(--footer-text);
		padding: 4rem 1rem 1rem 1rem;
		margin-top: auto;
		font-family: 'Helvetica Neue', Arial, sans-serif;
	}

	/* --- NEWSLETTER --- */
	.newsletter-section {
		text-align: center;
		max-width: 700px;
		margin: 0 auto 4rem auto;
		border-bottom: 1px solid var(--border-color);
		padding-bottom: 3rem;
	}
	.newsletter-section h2 {
		color: var(--footer-heading);
		font-size: 2rem;
		margin-bottom: 0.5rem;
	}
	.newsletter-section p { margin-bottom: 1.5rem; line-height: 1.5; }

	.newsletter-form { display: flex; gap: 10px; justify-content: center; max-width: 500px; margin: auto; }
	.newsletter-form input { background: var(--input-bg); border: none; padding: 12px 15px; color: white; border-radius: 4px; flex: 1; }
	.newsletter-form input::placeholder { color: var(--footer-text); }
	.newsletter-form button { background-color: #ff0033; color: white; border: none; padding: 12px 24px; font-weight: bold; border-radius: 4px; cursor: pointer; text-transform: uppercase; transition: background 0.2s; }
	.newsletter-form button:hover { background-color: #cc0029; }


	/* --- MAIN COLUMNS --- */
	.footer-content {
		display: grid;
		grid-template-columns: 2fr 2fr 1fr 1fr; /* Made 2nd column wider to fit 2 sub-columns */
		gap: 2rem;
		max-width: 1200px;
		margin: 0 auto 3rem auto;
	}

	/* Brand & Social */
	.footer-logo { display: flex; align-items: center; gap: 10px; margin-bottom: 1rem; }
	.logo-box { background-color: #ff0033; color: white; font-weight: 900; font-size: 1.2rem; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; border-radius: 2px; }
	.logo-text { color: var(--footer-heading); font-weight: 800; font-size: 1.2rem; text-transform: uppercase; }
	.brand-desc { font-size: 0.9rem; line-height: 1.5; margin-bottom: 1.5rem; max-width: 300px; }
	
	.social-links { display: flex; gap: 1rem; }
	.social-links a { color: var(--footer-text); transition: color 0.2s; display: flex; align-items: center; text-decoration: none; }
	.social-links svg { width: 24px; height: 24px; }
	.social-links a:hover { color: var(--footer-heading); }

	/* --- HEADERS & LINKS --- */
	.footer-col h4 {
		color: var(--footer-text);
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 1px;
		margin-bottom: 1.5rem;
		font-weight: bold;
	}

	.footer-col ul { list-style: none; padding: 0; margin: 0; }
	.footer-col ul li { margin-bottom: 0.8rem; }
	.footer-col ul li a { color: var(--footer-heading); text-decoration: none; font-size: 0.95rem; transition: color 0.2s; }
	.footer-col ul li a:hover { color: #ff0033; }

	/* --- NEW: 2-COLUMN CATEGORY LIST --- */
	.category-grid {
		display: grid;
		grid-template-columns: 1fr 1fr; /* Split into 2 columns */
		gap: 0 20px; /* Horizontal space between columns */
	}

	/* --- BOTTOM BAR --- */
	.footer-bottom {
		max-width: 1200px; margin: auto; padding-top: 2rem; border-top: 1px solid var(--border-color); display: flex; justify-content: space-between; font-size: 0.85rem;
	}
	.disclaimer { font-style: italic; opacity: 0.8; }

/* --- MOBILE RESPONSIVE --- */
	@media (max-width: 900px) {
		.footer-content {
			/* 1. Create a 2-column grid for mobile */
			grid-template-columns: 1fr 1fr;
			gap: 2rem 1rem; /* 2rem vertical gap, 1rem horizontal gap */
			text-align: left; /* NEATER: Left align text so lists look clean */
		}

		/* 2. Brand Section: Force it to be Full Width (Span 2 columns) */
		.brand-col {
			grid-column: 1 / -1; /* Spans from start to end */
			text-align: center;  /* Keep logo centered */
			border-bottom: 1px solid rgba(255,255,255,0.1); /* Nice divider */
			padding-bottom: 2rem;
			margin-bottom: 1rem;
		}
		/* Ensure internal flex items in brand are centered */
		.footer-logo, .social-links, .brand-desc {
			justify-content: center;
			margin-left: auto;
			margin-right: auto;
		}

		/* 3. Categories: Force it to be Full Width */
		.wide-col {
			grid-column: 1 / -1; /* Spans full width */
		}
		
		/* 4. Kompania & Ligjore:
		   They are NOT mentioned here, so they naturally fall into 
		   the 1fr 1fr grid (Side-by-Side), which is exactly what you want. */

		/* 5. General Cleanup */
		.footer-bottom {
			flex-direction: column;
			gap: 1rem;
			text-align: center;
		}
		.newsletter-form {
			flex-direction: column;
		}
		.newsletter-form input {
			width: 100%;
			box-sizing: border-box;
		}
		.newsletter-form button { width: 100%; }
		
		/* Remove the centering constraint from before */
		.category-grid { 
			text-align: left; 
			max-width: none; 
			margin: 0;
		}
	}
</style>