<style>
	/* --- NGJYRAT E REJA (DARK THEME) --- */
	:root {
		--footer-bg: #0f172a;      /* Slate 900 - E errët */
		--footer-text: #94a3b8;    /* Slate 400 - Gri e lehtë */
		--footer-heading: #ffffff; /* E bardhë */
		--footer-border: #1e293b;  /* Slate 800 - Vijat ndarëse */
		--accent-red: #DC2626;     /* E kuqja e re */
	}

	footer {
		background: var(--footer-bg);
		color: var(--footer-text);
		padding: 4rem 1rem 1rem 1rem;
		margin-top: auto;
		border-top: 1px solid var(--footer-border);
		font-family: 'Helvetica Neue', Arial, sans-serif;
	}

	/* --- NEWSLETTER --- */
	.newsletter-section {
		text-align: center;
		max-width: 700px;
		margin: 0 auto 4rem auto;
		border-bottom: 1px solid var(--footer-border);
		padding-bottom: 3rem;
	}
	.newsletter-section h2 {
		color: var(--footer-heading);
		font-size: 2rem;
		margin-bottom: 0.5rem;
		font-weight: 900;
		text-transform: uppercase;
		letter-spacing: -1px;
	}
	.newsletter-section p { margin-bottom: 1.5rem; line-height: 1.6; font-size: 1.1rem; }

	.newsletter-form { display: flex; gap: 10px; justify-content: center; max-width: 500px; margin: auto; }
	
	/* Inputi tani është i bardhë që të duket mbi sfondin e zi */
	.newsletter-form input { 
		background: #ffffff; 
		border: none; 
		padding: 12px 20px; 
		color: #333; 
		border-radius: 4px; 
		flex: 1; 
		font-size: 0.95rem;
	}
	.newsletter-form input:focus { outline: 2px solid var(--accent-red); }
	
	.newsletter-form button { 
		background-color: var(--accent-red); 
		color: white; border: none; 
		padding: 12px 24px; 
		font-weight: 900; 
		border-radius: 4px; 
		cursor: pointer; 
		text-transform: uppercase; 
		transition: all 0.2s; 
		letter-spacing: 1px;
	}
	.newsletter-form button:hover { background-color: #b91c1c; transform: translateY(-2px); }


	/* --- MAIN COLUMNS --- */
	.footer-content {
		display: grid;
		grid-template-columns: 2fr 2fr 1fr 1fr;
		gap: 3rem;
		max-width: 1400px; /* E zgjeruar pak */
		margin: 0 auto 3rem auto;
	}

	/* Brand */
	.footer-logo { display: flex; align-items: center; gap: 12px; margin-bottom: 1.2rem; }
	.logo-box { background-color: var(--accent-red); color: white; font-weight: 900; font-size: 1.4rem; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; border-radius: 4px; }
	.logo-text { color: var(--footer-heading); font-weight: 900; font-size: 1.4rem; text-transform: uppercase; letter-spacing: -1px; }
	.brand-desc { font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.5rem; max-width: 320px; color: var(--footer-text); }
	
	.social-links { display: flex; gap: 1rem; }
	.social-links a { 
		color: var(--footer-text); 
		background: var(--footer-border); 
		width: 36px; height: 36px; 
		display: flex; align-items: center; justify-content: center; 
		border-radius: 4px; 
		transition: all 0.2s; 
	}
	.social-links svg { width: 18px; height: 18px; }
	.social-links a:hover { color: white; background: var(--accent-red); transform: translateY(-3px); }

	/* --- HEADERS & LINKS --- */
	.footer-col h4 {
		color: var(--footer-heading);
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 2px;
		margin-bottom: 1.5rem;
		font-weight: 900;
		opacity: 0.7;
	}

	.footer-col ul { list-style: none; padding: 0; margin: 0; }
	.footer-col ul li { margin-bottom: 0.8rem; }
	.footer-col ul li a { 
		color: var(--footer-text); 
		text-decoration: none; 
		font-size: 0.95rem; 
		font-weight: 500;
		transition: color 0.2s; 
	}
	.footer-col ul li a:hover { color: var(--accent-red); padding-left: 5px; }

	/* Category Grid */
	.category-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0 30px;
	}

	/* --- BOTTOM BAR --- */
	.footer-bottom {
		max-width: 1400px; margin: auto; padding-top: 2rem; border-top: 1px solid var(--footer-border); display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem;
	}
	.copyright { font-weight: bold; }
	.disclaimer { font-style: italic; opacity: 0.6; }

	/* --- MOBILE --- */
	@media (max-width: 900px) {
		.footer-content {
			grid-template-columns: 1fr; /* Një kolonë në celular */
			gap: 3rem;
			text-align: center;
		}

		.brand-col, .wide-col { grid-column: auto; }
		
		.footer-logo, .social-links, .brand-desc {
			justify-content: center;
			margin-left: auto;
			margin-right: auto;
		}

		.category-grid { text-align: center; }

		.footer-bottom {
			flex-direction: column;
			gap: 1rem;
			text-align: center;
		}
		
		.newsletter-form { flex-direction: column; }
		.newsletter-form input, .newsletter-form button { width: 100%; }
	}
</style>