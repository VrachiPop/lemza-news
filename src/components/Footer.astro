<style>
    /* --- NGJYRAT (DARK THEME) --- */
    :root {
        --footer-bg: #0f172a;
        --footer-text: #d7dce3; /* Slate 400 */
        --footer-heading: #ffffff;
        --footer-border: #1e293b;
        --accent-red: #DC2626;
    }

    footer {
        background: var(--footer-bg);
        color: var(--footer-text);
        padding: 5rem 1rem 0 1rem; /* Padding vetëm lart dhe anash */
        margin-top: auto;
        border-top: 1px solid var(--footer-border);
        font-family: 'Literata', 'Georgia', sans-serif;
    }

    /* --- NEWSLETTER --- */
    .newsletter-section {
        text-align: center;
        max-width: 700px;
        margin: 0 auto 4rem auto;
        border-bottom: 2px solid var(--footer-border);
        padding-bottom: 5rem;
    }
    .newsletter-section h2 {
        color: var(--footer-heading);
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: -1px;
    }
    .newsletter-section p { margin-bottom: 1.5rem; line-height: 1.6; font-size: 1.1rem; }

    .newsletter-form { display: flex; gap: 10px; justify-content: center; max-width: 500px; margin: auto; }
    
    .newsletter-form input { 
        background: #ffffff; border: none; padding: 12px 20px; 
        color: #333; border-radius: 4px; flex: 1; font-size: 0.95rem;
    }
    .newsletter-form input:focus { outline: 2px solid var(--accent-red); }
    
    .newsletter-form button { 
        background-color: var(--accent-red); color: white; border: none; 
        padding: 12px 24px; font-weight: 900; border-radius: 4px; 
        cursor: pointer; text-transform: uppercase; transition: all 0.2s; letter-spacing: 1px;
    }
    .newsletter-form button:hover { background-color: #b91c1c; transform: translateY(-2px); }


    /* --- MAIN COLUMNS --- */
    .footer-content {
        display: grid;
        /* Ndarja: Brand (i gjerë), Kategori, Kompani (e vogël) */
        grid-template-columns: 1fr 1fr; 
        gap: 2rem;
        max-width: 1400px; 
        margin: 0 auto 2rem auto;
    }

    /* Brand Column */
    .brand-desc { font-size: 0.95rem; line-height: 1.7; color: var(--footer-text); max-width: 450px; text-align: justify; }
    .footer-logo { display: flex; align-items: center; gap: 12px; margin-bottom: 1.5rem; }
    
    .social-links { display: flex; gap: 1rem; }
    .social-links a { 
        color: var(--footer-text); background: var(--footer-border); 
        width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; 
        border-radius: 4px; transition: all 0.2s; 
    }
    .social-links svg { width: 18px; height: 18px; }
    .social-links a:hover { color: white; background: var(--accent-red); transform: translateY(-3px); }

    /* Headers & Lists */
    .footer-col h4 {
        color: var(--footer-heading); font-size: 0.8rem; text-transform: uppercase; 
        letter-spacing: 2px; margin-bottom: 1.5rem; font-weight: 900; opacity: 0.7;
    }

    .footer-col ul { list-style: none; padding: 0; margin: 0; }
    .footer-col ul li { margin-bottom: 0.8rem; }
    .footer-col ul li a { 
        color: var(--footer-text); text-decoration: none; font-size: 0.95rem; font-weight: 500;
        position: relative; transition: color 0.2s;
    }
    
    /* Efekti Hover tek linqet */
    .footer-col ul li a::after {
        content: ''; position: absolute; left: 0; bottom: -4px; 
        width: 100%; height: 2px; background-color: var(--accent-red); display: none;
    }
    .footer-col ul li a:hover::after { display: block; }
    .footer-col ul li a:hover { color: white; }

    /* Category Grid */
    .category-grid { 
        margin-top: 6rem;
        display: grid; 
        grid-template-columns: repeat(3, 1fr); 
        gap: 0.5rem 1.5rem; /* Hapësira: 0.5rem lart/poshtë, 1.5rem anash */
    }

    .wide-col {
        padding-top: 2rem; /* Rrite ose zvogëloje këtë numër sipas dëshirës */
    }


    /* --- BOTTOM BAR --- */
    .footer-bottom {
        background-color: var(--footer-bg-dark); /* Pak më e errët se pjesa tjetër */
        border-top: 1px solid var(--footer-border);
        padding: 1rem 0;
        margin-left: -1rem; margin-right: -1rem; /* Full width correction */
    }

    .bottom-container {
        max-width: 1400px; margin: auto; padding: 0 2rem;
        display: flex; justify-content: space-between; align-items: center;
        font-size: 0.85rem;
    }

    .copyright { font-weight: bold; color: #64748b; }
    
    .legal-links { display: flex; align-items: center; gap: 1rem; }
    .legal-links a { color: var(--footer-text); text-decoration: none; transition: color 0.2s; }
    .legal-links a:hover { color: white; text-decoration: underline; }
    .separator { color: #334155; }

    .disclaimer { font-style: italic; opacity: 0.5; color: #64748b; }

    /* --- MOBILE --- */
    @media (max-width: 900px) {
        .footer-content {
            grid-template-columns: 1fr;
            gap: 3rem;
            text-align: left;
        }

        .category-grid { grid-template-columns: 1fr 1fr 1fr; }
        
        .bottom-container {
            flex-direction: column;
            gap: 1rem;
            text-align: center;
        }
        
        .newsletter-form { flex-direction: column; }
        .newsletter-form input, .newsletter-form button { width: 100%; }
        
        /* Në celular rreshtojmë Brand-in në qendër */
        .brand-col { text-align: center; }
        .footer-logo, .social-links { justify-content: center; }
        .brand-desc { margin: 0 auto; text-align: center; }
    }
</style>