<style>
	.site-footer {
		background-color: #343a46;
		color: #9ca3af;
		padding: 4rem 1rem 1rem;
		font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
		margin-top: auto;
	}
	
	.footer-content {
		max-width: 1200px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1.5fr 1fr 1fr 1fr;
		gap: 3rem;
		border-bottom: 1px solid #4b5563;
		padding-bottom: 3rem;
		margin-bottom: 2rem;
	}

	/* BRAND COLUMN */
	.logo-container { display: flex; align-items: center; gap: 10px; margin-bottom: 1rem; }
	.logo-box { background-color: #ff0033; color: white; font-size: 20px; font-weight: 900; width: 35px; height: 35px; display: flex; align-items: center; justify-content: center; border-radius: 2px; }
	.brand-name { color: white; font-weight: 900; font-size: 1.2rem; text-transform: uppercase; }
	.brand-desc { font-size: 0.9rem; line-height: 1.6; margin-bottom: 1.5rem; max-width: 300px; }
	
	.social-links { display: flex; gap: 1rem; }
	.social-links a { color: #9ca3af; transition: color 0.2s; width: 24px; height: 24px; }
	.social-links a:hover { color: #ff0033; }
	.social-links svg { width: 24px; height: 24px; }

	/* LINKS COLUMNS */
	.footer-links h3 { color: #6b7280; font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 1.5rem; }
	.footer-links ul { list-style: none; padding: 0; margin: 0; }
	.footer-links li { margin-bottom: 0.8rem; }
	.footer-links a { color: #e5e7eb; text-decoration: none; font-size: 0.95rem; transition: color 0.2s; }
	.footer-links a:hover { color: #ff0033; }

	/* COPYRIGHT STRIP */
	.footer-bottom { text-align: center; font-size: 0.8rem; color: #6b7280; }

	@media (max-width: 900px) {
		.footer-content { grid-template-columns: 1fr; gap: 2rem; text-align: center; }
		.logo-container, .social-links { justify-content: center; }
		.brand-desc { margin: 0 auto 1.5rem; }
	}
</style>