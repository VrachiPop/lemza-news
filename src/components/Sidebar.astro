---
import { getCollection } from 'astro:content';
import { horoscopes } from '../data/horoscope';
import { quotes } from '../data/quotes';
import { Image } from 'astro:assets';
import '../app.css';

// 1. Merr artikujt për "Më të Injoruarat" (Random)
const allPosts = await getCollection('blog');
const randomPosts = allPosts.sort(() => 0.5 - Math.random()).slice(0, 7);

// 2. Zgjidh një Horoskop Random (Opsionale nëse do ta shfaqësh më vonë)
const randomHoroscope = horoscopes[Math.floor(Math.random() * horoscopes.length)];

// 3. Zgjidh një Thënie Random (Opsionale)
const randomQuote = quotes[Math.floor(Math.random() * quotes.length)];
---

<aside class="flex flex-col gap-8 sticky top-8">
    
    <div class="flex flex-col">
        
        <div class="mb-5 pb-2 border-b border-slate-500">
            <h3 class="font-news font-light text-xl! text-slate-900 uppercase tracking-normal">
                Më të Injoruarat
            </h3>
        </div>

        <div class="flex flex-col gap-5">
            {randomPosts.map((post) => {
                // Logic per URL
                const fileName = post.slug.split('/').pop() || '';
                const cleanSlug = fileName.replace(/\.md$/, '');
                const finalUrl = `/${cleanSlug}/`;

                return (
                    <a href={finalUrl} class="group flex gap-4 items-start no-underline">
                        
                        {/* Imazhi Thumbnail */}
                        {/* SHTOVA 'relative' KËTU - Kjo e rregullon problemin e zgjatjes */}
                        <div class="relative shrink-0 w-24 h-16 overflow-hidden rounded bg-slate-100 border border-slate-200">
                            {post.data.heroImage ? (
                                <Image 
                                    src={post.data.heroImage} 
                                    alt={post.data.title}
                                    width={200}
                                    height={200}
                                    class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"                                />
                            ) : (
                                /* Fallback: Kutia Gri nëse s'ka foto */
                                <div class="w-full h-full flex items-center justify-center text-slate-300">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                                    </svg>
                                </div>
                            )}
                        </div>

                        {/* Titulli */}
                        <div class="flex flex-col justify-center py-0.5">
                            <h4 class="font-light text-slate-800 text-base! leading-snug group-hover:text-[#DC2626] group-hover:translate-x-1 transition-all duration-300 ease-in-out line-clamp-3 font-['Literata',serif]">
                                {post.data.title}
                            </h4>
                        </div>
                    </a>
                );
            })}
        </div>
    </div>
</aside>