---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import '../app.css';
import PollBaner from './PollBaner.astro';

const allPostsRaw = await getCollection('blog');
const sortedPosts = allPostsRaw.sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const randomPosts = sortedPosts.slice(7).sort(() => 0.5 - Math.random()).slice(0, 5);
const tagNames = { 'politike': 'Politikë', 'ekonomi': 'Ekonomi', 'showbiz': 'Showbiz', 'sport': 'Sport', 'kulture': 'Kulturë', 'kronike': 'Kronikë', 'sociale': 'Sociale', 'tekno-shkence': 'Tekno & Shkencë', 'shendeti': 'Shëndeti', 'rajoni': 'Rajoni', 'bota': 'Bota' };
---

<aside class="sticky top-24 flex flex-col gap-15">
    
    <div class="flex flex-col">
        <div class="flex items-center gap-3 mb-6 pb-2 border-b border-slate-200">
            <span class="w-1.5 h-6 bg-[#0f172a]"></span>
            <h3 class="font-serif font-bold text-[#0f172a] text-lg tracking-tight m-0">
                Më të injoruarat
            </h3>
        </div>

        <div class="flex flex-col divide-y divide-slate-200">
            {randomPosts.map((post, index) => {
                const fileName = post.slug.split('/').pop() || '';
                const cleanSlug = fileName.replace(/\.md$/, '');
                const finalUrl = `/${cleanSlug}/`;

                return (
                    <a href={finalUrl} class="group flex gap-4 py-4 first:pt-0 no-underline items-start">
                        
                        <div class="relative shrink-0 w-[85px] h-[85px] rounded-md overflow-hidden bg-slate-100 shadow-sm group-hover:shadow-md transition-all duration-300">
                            {post.data.heroImage ? (
                                <Image 
                                    src={post.data.heroImage} 
                                    alt={post.data.title}
                                    width={150}
                                    height={150}
                                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                                />
                            ) : (
                                <div class="w-full h-full flex items-center justify-center bg-slate-100 text-slate-300">
                                    <span class="text-[9px]">IMG</span>
                                </div>
                            )}

                            <div class="absolute top-0 left-0 bg-[#0f172a] text-white text-[10px] font-black px-2 py-1 rounded-br-md z-10 font-sans shadow-sm">
                                #{index + 1}
                            </div>
                        </div>

                        <div class="flex flex-col justify-between h-[85px] py-0.5">
                            
                            <div class="flex flex-col gap-1">
                                <span class="text-[9px] font-bold text-[#DC2626] uppercase tracking-widest">
                                    {post.data.tags && post.data.tags.length > 0 ? (tagNames as any)[post.data.tags[0]] : 'Lajm'}
                                </span>

                                <h4 class="font-bookerly font-light text-slate-800 text-[14px] leading-snug group-hover:text-[#0f172a] group-hover:underline decoration-2 underline-offset-2 transition-all duration-200 line-clamp-2">
                                    {post.data.title}
                                </h4>
                            </div>

                            <div class="flex items-center text-[#0f172a] font-bold text-[10px] uppercase tracking-widest opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300">
                                Lexo <span class="ml-1 text-sm leading-none">&rarr;</span>
                            </div>
                        </div>
                    </a>
                );
            })}
        </div>
    </div>

    <PollBaner />

</aside>