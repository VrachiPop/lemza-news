---
import { getCollection } from 'astro:content';
import { horoscopes } from '../data/horoscope';
import { quotes } from '../data/quotes';
import '../app.css';

// 1. Merr artikujt për "Më të Injoruarat" (Random)
const allPosts = await getCollection('blog');
const randomPosts = allPosts.sort(() => 0.5 - Math.random()).slice(0, 7);

// 2. Zgjidh një Horoskop Random
const randomHoroscope = horoscopes[Math.floor(Math.random() * horoscopes.length)];

// 3. Zgjidh një Thënie Random
const randomQuote = quotes[Math.floor(Math.random() * quotes.length)];
---

<aside class="flex flex-col gap-8 sticky top-8">
    
    <div class="flex flex-col">
        
        <div class="mb-5 pb-2 border-b border-slate-500">
            <h3 class="font-light text-xl! text-slate-900 uppercase tracking-tight">
                Më të Injoruarat
            </h3>
        </div>

        <div class="flex flex-col gap-5">
            {randomPosts.map((post) => {
                // Logic per URL
                const fileName = post.slug.split('/').pop() || '';
                const cleanSlug = fileName.replace(/\.md$/, '');
                const finalUrl = `/${cleanSlug}/`;
                const heroImage = post.data.heroImage || "https://placehold.co/150x150/e2e8f0/64748b?text=Lemza";

                return (
                    <a href={finalUrl} class="group flex gap-4 items-start no-underline">
                        
                        {/* Imazhi Thumbnail */}
                        <div class="shrink-0 w-24 h-16 overflow-hidden rounded bg-slate-100">
                            <img 
                                src={heroImage} 
                                alt={post.data.title}
                                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 ease-out"
                            />
                        </div>

                        {/* Titulli me Animacion */}
                        <div class="flex flex-col justify-center py-0.5">
                            <h4 class="font-light text-slate-800 text-base! leading-snug group-hover:text-[#DC2626] group-hover:translate-x-2 transition-all duration-300 ease-in-out line-clamp-3 font-['Literata',serif]">
                                {post.data.title}
                            </h4>
                        </div>
                    </a>
                );
            })}
        </div>
</aside>