---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header class="site-header">
	<nav>
		<a href="/" class="logo-container">
			<div class="logo-box">L</div>
			<div class="logo-text">
				<span class="brand-name">LEMZA NEWS</span>
				<span class="brand-slogan">TË PARËT TE RRENA</span>
			</div>
		</a>

		<div class="desktop-links">
			<HeaderLink href="/">KREU</HeaderLink>
			<HeaderLink href="/te-fundit">TË FUNDIT</HeaderLink>
			<HeaderLink href="/tags/politike">POLITIKË</HeaderLink>
			<HeaderLink href="/tags/ekonomi">EKONOMI</HeaderLink>
			<HeaderLink href="/tags/showbiz">SHOWBIZ</HeaderLink>
		</div>

		<div class="right-actions">
			<div class="search-container">
				<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
			</div>
			
			<button class="mobile-menu-btn" id="menu-toggle" aria-label="Menu">
				<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
			</button>
		</div>
	</nav>

	<div class="mobile-nav-links" id="mobile-menu">
		<a href="/">KREU</a>
		<a href="/te-fundit">TË FUNDIT</a>
		<a href="/tags/politike">POLITIKË</a>
		<a href="/tags/ekonomi">EKONOMI</a>
		<a href="/tags/showbiz">SHOWBIZ</a>
	</div>
</header>

<script>
	const menuBtn = document.getElementById('menu-toggle');
	const mobileMenu = document.getElementById('mobile-menu');

	menuBtn?.addEventListener('click', () => {
		mobileMenu?.classList.toggle('open');
	});
</script>

<style>
	/* --- GLOBAL RESET --- */
	header.site-header {
		margin: 0;
		padding: 0 1rem;
		background-color: #343a46 !important;
		color: white !important;
		box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2);
		position: relative;
		z-index: 1000;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 70px;
		max-width: 1400px;
		margin: 0 auto;
	}

	/* --- LOGO --- */
	a.logo-container { display: flex; align-items: center; text-decoration: none !important; gap: 10px; }
	.logo-box { background-color: #ff0033; color: white; font-size: 24px; font-weight: 900; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; border-radius: 2px; }
	.logo-text { display: flex; flex-direction: column; line-height: 1; }
	.brand-name { color: white; font-weight: 900; font-size: 18px; text-transform: uppercase; }
	.brand-slogan { color: #9ca3af; font-size: 9px; text-transform: uppercase; letter-spacing: 1px; }

	/* --- DESKTOP LINKS (The Center Menu) --- */
	.desktop-links { display: flex; gap: 1.5rem; height: 100%; align-items: center; }
	.desktop-links :global(a) { 
		color: #e5e7eb !important; 
		text-decoration: none; 
		font-weight: 700; 
		font-size: 14px; 
		text-transform: uppercase; 
		height: 100%;
		display: flex;
		align-items: center;
		border-bottom: 4px solid transparent; 
	}
	.desktop-links :global(a:hover), .desktop-links :global(a.active) { color: white !important; border-bottom-color: #ff0033; }

	/* --- RIGHT ACTIONS --- */
	.right-actions { display: flex; align-items: center; gap: 15px; }
	
	/* Hamburger Button: Clean, no background */
	.mobile-menu-btn { 
		display: none; /* Hidden on Desktop */
		background: none; 
		border: none; 
		cursor: pointer; 
		padding: 0;
		color: white; 
	}

	/* --- MOBILE MENU DROPDOWN --- */
	.mobile-nav-links {
		display: none; /* Hidden by default */
		flex-direction: column;
		background-color: #2d333f; /* Slightly lighter than header */
		position: absolute;
		top: 100%; /* Push exactly below header */
		left: 0;
		right: 0;
		padding: 0;
		border-top: 1px solid #4b5563;
		box-shadow: 0 10px 15px rgba(0,0,0,0.3);
	}

	.mobile-nav-links.open { display: flex; }

	.mobile-nav-links a {
		color: white;
		padding: 15px 20px;
		text-decoration: none;
		border-bottom: 1px solid #3e4552;
		font-weight: bold;
		text-transform: uppercase;
	}
	.mobile-nav-links a:hover { background-color: #3e4552; color: #ff0033; }

	/* --- MOBILE BREAKPOINT (Phones) --- */
	@media (max-width: 900px) {
		/* 1. HIDE the desktop menu */
		.desktop-links { display: none !important; }
		
		/* 2. SHOW the hamburger */
		.mobile-menu-btn { display: block; }

		/* 3. Adjust logo text size if needed */
		.brand-name { font-size: 16px; }
	}
</style>