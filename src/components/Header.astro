---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header class="site-header">
	<nav>
		<a href="/" class="logo-container">
			<div class="logo-box">L</div>
			<div class="logo-text">
				<span class="brand-name">LEMZA NEWS</span>
				<span class="brand-slogan">TË PARËT TE RRENA</span>
			</div>
		</a>

		<div class="internal-links">
			<HeaderLink href="/">KREU</HeaderLink>
			<HeaderLink href="/aktualitet">AKTUALITET</HeaderLink>
			<HeaderLink href="/tags/politike">POLITIKË</HeaderLink>
			<HeaderLink href="/tags/ekonomi">EKONOMI</HeaderLink>
			<HeaderLink href="/tags/showbiz">SHOWBIZ</HeaderLink>
		</div>

		<div class="search-container">
			<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-search"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
		</div>
	</nav>
</header>

<style>
	/* --- FORCE DARK HEADER --- */
	header.site-header {
		margin: 0;
		padding: 0 2rem;
		background-color: #343a46 !important; /* Force Dark Blue/Grey */
		color: white !important;
		box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2);
		font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 80px;
		max-width: 1400px;
		margin: 0 auto;
	}

	/* --- LOGO STYLES --- */
	a.logo-container {
		display: flex;
		align-items: center;
		text-decoration: none !important; /* Remove underline */
		gap: 12px;
	}

	.logo-box {
		background-color: #ff0033; /* Red Box */
		color: white;
		font-size: 28px;
		font-weight: 900;
		width: 45px;
		height: 45px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 2px;
		line-height: 1;
	}

	.logo-text {
		display: flex;
		flex-direction: column;
		line-height: 1;
	}

	.brand-name {
		color: white;
		font-weight: 900;
		font-size: 22px;
		text-transform: uppercase;
		letter-spacing: -0.5px;
	}

	.brand-slogan {
		color: #9ca3af;
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 1.5px;
		margin-top: 3px;
	}

	/* --- MENU LINKS --- */
	.internal-links {
		display: flex;
		gap: 2rem;
	}

	/* This forces the styles onto the links from HeaderLink.astro */
	.internal-links :global(a) {
		color: #e5e7eb !important; /* Light Gray */
		text-decoration: none;
		font-weight: 700;
		font-size: 14px;
		text-transform: uppercase;
		padding: 28px 0; /* Tall click area */
		border-bottom: 4px solid transparent;
		transition: all 0.2s ease;
	}

	.internal-links :global(a:hover) {
		color: white !important;
	}

	.internal-links :global(a.active) {
		color: white !important;
		border-bottom-color: #ff0033; /* Red Active Line */
	}

	/* --- MOBILE TWEAKS --- */
	@media (max-width: 900px) {
		header.site-header { padding: 0 1rem; }
		nav { height: auto; padding: 1rem 0; flex-wrap: wrap; }
		.internal-links { 
			order: 3; 
			width: 100%; 
			justify-content: center; 
			margin-top: 1rem; 
			gap: 10px;
			flex-wrap: wrap;
		}
		.logo-text { display: none; } /* Hide text on small screens */
	}
</style>