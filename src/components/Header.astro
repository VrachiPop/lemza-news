---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Kreu</HeaderLink>
			
            <HeaderLink href="/te-fundit">TË-FUNDIT</HeaderLink>
			
			<HeaderLink href="/about">Rreth Nesh</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://m.web.facebook.com/people/Lemza-News/61572970870932/" target="_blank">
				<span class="sr-only">Follow Lemza on Facebook</span>
				<svg viewBox="0 0 32 32" aria-hidden="true">
					<path d="M32 16.098C32 7.207 24.837 0 16 0S0 7.207 0 16.098c0 8.037 5.875 14.699 13.5 15.903v-11.25h-4.063v-4.653h4.063V12.57c0-4.01 2.388-6.225 6.044-6.225 1.75 0 3.581.312 3.581.312v3.937h-2.019c-1.988 0-2.606 1.234-2.606 2.5v3.003h4.438l-.71 4.653h-3.728V32C26.125 30.797 32 24.135 32 16.098Z" />
				</svg>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(0,0,0,0.05);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>