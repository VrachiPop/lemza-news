---
import "../app.css";
import { Image } from "astro:assets";

// 1. Aktualitet
import imgPolitike from "../assets/banners/politike.jpg";
import imgEkonomi from "../assets/banners/ekonomi.png";
import imgKronike from "../assets/banners/kronike.png";
import imgRajoni from "../assets/banners/rajoni.png";
import imgBota from "../assets/banners/bota.jpg";
import imgSociale from "../assets/banners/sociale.png";

// 2. Argëtim
import imgSport from "../assets/banners/sport.png";
import imgKulture from "../assets/banners/kulture.png";
import imgShowbiz from "../assets/banners/showbiz.png";
import imgUdhetime from "../assets/banners/udhetime.jpg";

// 3. Të tjera
import imgShendeti from "../assets/banners/shendeti.png";
import imgShkence from "../assets/banners/shkence.jpg";
import imgTeknologji from "../assets/banners/teknologji.png";
---

<style is:global>
    /* Klasa që e mban "të ndezur" linkun kur shohim foton */
    .mega-link.is-active {
        background-color: #f8fafc !important; /* bg-slate-50 */
        color: #dc2626 !important;
        transform: translateX(0.25rem) !important; /* translate-x-1 */
    }
    .mega-link.is-active::before {
        transform: scaleY(1) !important; /* Viza anësore mbetet absolute */
    }
</style>

<header
    class="fixed top-0 left-0 w-full z-[1000] transition-transform duration-300 pointer-events-none"
>
    <nav
        class="flex items-center justify-between h-[80px] max-w-[1600px] mx-auto px-4 md:px-8 pointer-events-auto"
    >
        <a
            href="/"
            class="flex items-center gap-3 group no-underline h-full py-2 select-none"
        >
            <div
                class="lemza-icon bg-[#DC2626] text-white w-10 h-10 flex items-center justify-center rounded-sm shadow-sm shrink-0 transition-transform duration-300 group-hover:scale-105"
            >
                <span class="font-bookerly font-black text-3xl! leading-none"
                    >L</span
                >
            </div>
            <div
                class="lemza-text flex flex-col justify-center h-10 text-white"
            >
                <span
                    class="font-black text-2xl leading-[0.8] tracking-tight uppercase font-bookerly"
                    >LEMZA</span
                >
                <span
                    class="font-bold text-2xl leading-none tracking-tight uppercase font-bookerly"
                    >NEWS</span
                >
            </div>
        </a>

        <div
            id="desktop-nav"
            class="hidden xl:flex h-full items-center pt-1 relative"
        >
            <div class="flex gap-6 h-full items-center">
                <a
                    href="/te-fundit"
                    class="standard-link relative text-white font-bookerly font-bold text-[15px] tracking-normal no-underline transition-colors duration-300 hover:text-slate-200 after:content-[''] after:absolute after:w-full after:h-[2px] after:bg-gradient-to-r after:from-[#DC2626] after:to-[#ff8a8a] after:left-0 after:-bottom-1.5 after:scale-x-0 after:origin-left hover:after:scale-x-100 after:transition-transform after:duration-300 after:ease-out"
                >
                    Të fundit
                </a>

                <div
                    class="nav-trigger group h-full flex items-center cursor-pointer"
                    data-target="aktualitet"
                >
                    <span
                        class="relative text-white font-bookerly font-bold text-[15px] tracking-normal transition-colors duration-300 group-hover:text-slate-200 group-[.active-trigger]:text-slate-200 flex items-center gap-1 after:content-[''] after:absolute after:w-full after:h-[2px] after:bg-gradient-to-r after:from-[#DC2626] after:to-[#ff8a8a] after:left-0 after:-bottom-1.5 after:scale-x-0 after:origin-left group-hover:after:scale-x-100 group-[.active-trigger]:after:scale-x-100 after:transition-transform after:duration-300 after:ease-out"
                    >
                        Aktualitet
                        <svg
                            width="12"
                            height="12"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="3"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="transition-transform duration-300 group-hover:rotate-180 group-[.active-trigger]:rotate-180"
                            ><path d="M6 9l6 6 6-6"></path>
                        </svg>
                    </span>
                </div>

                <div
                    class="nav-trigger group h-full flex items-center cursor-pointer"
                    data-target="argetim"
                >
                    <span
                        class="relative text-white font-bookerly font-bold text-[15px] tracking-normal transition-colors duration-300 group-hover:text-slate-200 group-[.active-trigger]:text-slate-200 flex items-center gap-1 after:content-[''] after:absolute after:w-full after:h-[2px] after:bg-gradient-to-r after:from-[#DC2626] after:to-[#ff8a8a] after:left-0 after:-bottom-1.5 after:scale-x-0 after:origin-left group-hover:after:scale-x-100 group-[.active-trigger]:after:scale-x-100 after:transition-transform after:duration-300 after:ease-out"
                    >
                        Argëtim
                        <svg
                            width="12"
                            height="12"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="3"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="transition-transform duration-300 group-hover:rotate-180 group-[.active-trigger]:rotate-180"
                            ><path d="M6 9l6 6 6-6"></path>
                        </svg>
                    </span>
                </div>

                <div
                    class="nav-trigger group h-full flex items-center cursor-pointer"
                    data-target="te-tjera"
                >
                    <span
                        class="relative text-white font-bookerly font-bold text-[15px] tracking-normal transition-colors duration-300 group-hover:text-slate-200 group-[.active-trigger]:text-slate-200 flex items-center gap-1 after:content-[''] after:absolute after:w-full after:h-[2px] after:bg-gradient-to-r after:from-[#DC2626] after:to-[#ff8a8a] after:left-0 after:-bottom-1.5 after:scale-x-0 after:origin-left group-hover:after:scale-x-100 group-[.active-trigger]:after:scale-x-100 after:transition-transform after:duration-300 after:ease-out"
                    >
                        Të tjera
                        <svg
                            width="12"
                            height="12"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="3"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="transition-transform duration-300 group-hover:rotate-180 group-[.active-trigger]:rotate-180"
                            ><path d="M6 9l6 6 6-6"></path>
                        </svg>
                    </span>
                </div>
            </div>

            <div
                id="fluid-viewport"
                class="absolute top-full left-0 bg-white/95 backdrop-blur-xl border border-slate-200 shadow-[0_30px_60px_rgba(0,0,0,0.12)] rounded-2xl z-50 overflow-hidden transform-gpu will-change-[width,height,transform] pointer-events-none opacity-0"
                style="transition: width 300ms cubic-bezier(0.25, 1, 0.5, 1), height 300ms cubic-bezier(0.25, 1, 0.5, 1), transform 300ms cubic-bezier(0.25, 1, 0.5, 1), opacity 200ms ease-out; transform: translateX(0) translateY(10px); width: 480px; height: 300px;"
            >
                <div
                    id="menu-aktualitet"
                    class="menu-content mega-menu-container absolute top-0 left-0 w-[480px] p-3 flex gap-2 transition-all duration-300 ease-out opacity-0 pointer-events-none z-0 -translate-x-3"
                >
                    <div
                        class="links-wrapper flex-1 flex flex-col relative z-10 pr-2"
                    >
                        <a
                            href="/tags/politike"
                            data-target="politike"
                            class="mega-link relative block px-4 py-2.5 rounded-xl text-slate-800 font-bookerly font-bold text-[14px] tracking-normal no-underline overflow-hidden transition-all duration-300 ease-out hover:bg-slate-50 hover:text-[#DC2626] hover:translate-x-1 before:content-[''] before:absolute before:left-0 before:top-2 before:bottom-2 before:w-[3px] before:bg-[#DC2626] before:scale-y-0 before:origin-center hover:before:scale-y-100 before:transition-transform before:duration-300 before:ease-out"
                            >Politikë</a
                        >
                        <a
                            href="/tags/ekonomi"
                            data-target="ekonomi"
                            class="mega-link relative block px-4 py-2.5 rounded-xl text-slate-800 font-bookerly font-bold text-[14px] tracking-normal no-underline overflow-hidden transition-all duration-300 ease-out hover:bg-slate-50 hover:text-[#DC2626] hover:translate-x-1 before:content-[''] before:absolute before:left-0 before:top-2 before:bottom-2 before:w-[3px] before:bg-[#DC2626] before:scale-y-0 before:origin-center hover:before:scale-y-100 before:transition-transform before:duration-300 before:ease-out"
                            >Ekonomi</a
                        >
                        <a
                            href="/tags/kronike"
                            data-target="kronike"
                            class="mega-link relative block px-4 py-2.5 rounded-xl text-slate-800 font-bookerly font-bold text-[14px] tracking-normal no-underline overflow-hidden transition-all duration-300 ease-out hover:bg-slate-50 hover:text-[#DC2626] hover:translate-x-1 before:content-[''] before:absolute before:left-0 before:top-2 before:bottom-2 before:w-[3px] before:bg-[#DC2626] before:scale-y-0 before:origin-center hover:before:scale-y-100 before:transition-transform before:duration-300 before:ease-out"
                            >Kronikë</a
                        >
                        <a
                            href="/tags/rajoni"
                            data-target="rajoni"
                            class="mega-link relative block px-4 py-2.5 rounded-xl text-slate-800 font-bookerly font-bold text-[14px] tracking-normal no-underline overflow-hidden transition-all duration-300 ease-out hover:bg-slate-50 hover:text-[#DC2626] hover:translate-x-1 before:content-[''] before:absolute before:left-0 before:top-2 before:bottom-2 before:w-[3px] before:bg-[#DC2626] before:scale-y-0 before:origin-center hover:before:scale-y-100 before:transition-transform before:duration-300 before:ease-out"
                            >Rajoni</a
                        >
                        <a
                            href="/tags/bota"
                            data-target="bota"
                            class="mega-link relative block px-4 py-2.5 rounded-xl text-slate-800 font-bookerly font-bold text-[14px] tracking-normal no-underline overflow-hidden transition-all duration-300 ease-out hover:bg-slate-50 hover:text-[#DC2626] hover:translate-x-1 before:content-[''] before:absolute before:left-0 before:top-2 before:bottom-2 before:w-[3px] before:bg-[#DC2626] before:scale-y-0 before:origin-center hover:before:scale-y-100 before:transition-transform before:duration-300 before:ease-out"
                            >Bota</a
                        >
                        <a
                            href="/tags/sociale"
                            data-target="sociale"
                            class="mega-link relative block px-4 py-2.5 rounded-xl text-slate-800 font-bookerly font-bold text-[14px] tracking-normal no-underline overflow-hidden transition-all duration-300 ease-out hover:bg-slate-50 hover:text-[#DC2626] hover:translate-x-1 before:content-[''] before:absolute before:left-0 before:top-2 before:bottom-2 before:w-[3px] before:bg-[#DC2626] before:scale-y-0 before:origin-center hover:before:scale-y-100 before:transition-transform before:duration-300 before:ease-out"
                            >Sociale</a
                        >
                    </div>

                    <div
                        class="w-[200px] shrink-0 rounded-xl relative overflow-hidden shadow-sm bg-slate-100 group/imagebox"
                    >
                        <div
                            data-id="politike"
                            class="mega-panel absolute inset-0 transition-opacity duration-400 opacity-0 pointer-events-none"
                        >
                            <Image
                                src={imgPolitike}
                                alt="Politikë"
                                class="absolute inset-0 w-full h-full object-cover transition-all duration-700 scale-100 group-hover/imagebox:scale-110 group-hover/imagebox:brightness-110"
                            />
                        </div>
                        <div
                            data-id="ekonomi"
                            class="mega-panel absolute inset-0 transition-opacity duration-400 opacity-0 pointer-events-none"
                        >
                            <Image
                                src={imgEkonomi}
                                alt="Ekonomi"
                                class="absolute inset-0 w-full h-full object-cover transition-all duration-700 scale-100 group-hover/imagebox:scale-110 group-hover/imagebox:brightness-110"
                            />
                        </div>
                        <div
                            data-id="kronike"
                            class="mega-panel absolute inset-0 transition-opacity duration-400 opacity-0 pointer-events-none"
                        >
                            <Image
                                src={imgKronike}
                                alt="Kronikë"
                                class="absolute inset-0 w-full h-full object-cover transition-all duration-700 scale-100 group-hover/imagebox:scale-110 group-hover/imagebox:brightness-110"
                            />
                        </div>
                        <div
                            data-id="rajoni"
                            class="mega-panel absolute inset-0 transition-opacity duration-400 opacity-0 pointer-events-none"
                        >
                            <Image
                                src={imgRajoni}
                                alt="Rajoni"
                                class="absolute inset-0 w-full h-full object-cover transition-all duration-700 scale-100 group-hover/imagebox:scale-110 group-hover/imagebox:brightness-110"
                            />
                        </div>
                        <div
                            data-id="bota"
                            class="mega-panel absolute inset-0 transition-opacity duration-400 opacity-0 pointer-events-none"
                        >
                            <Image
                                src={imgBota}
                                alt="Bota"
                                class="absolute inset-0 w-full h-full object-cover transition-all duration-700 scale-100 group-hover/imagebox:scale-110 group-hover/imagebox:brightness-110"
                            />
                        </div>
                        <div
                            data-id="sociale"
                            class="mega-panel absolute inset-0 transition-opacity duration-400 opacity-0 pointer-events-none"
                        >
                            <Image
                                src={imgSociale}
                                alt="Sociale"
                                class="absolute inset-0 w-full h-full object-cover transition-all duration-700 scale-100 group-hover/imagebox:scale-110 group-hover/imagebox:brightness-110"
                            />
                        </div>
                    </div>
                </div>

                <div
                    id="menu-argetim"
                    class="menu-content mega-menu-container absolute top-0 left-0 w-[440px] p-3 flex gap-2 transition-all duration-300 ease-out opacity-0 pointer-events-none z-0 -translate-x-3"
                >
                    <div
                        class="links-wrapper flex-1 flex flex-col relative z-10 pr-2"
                    >
                        <a
                            href="/tags/sport"
                            data-target="sport"
                            class="mega-link relative block px-4 py-2.5 rounded-xl text-slate-800 font-bookerly font-bold text-[14px] tracking-normal no-underline overflow-hidden transition-all duration-300 ease-out hover:bg-slate-50 hover:text-[#DC2626] hover:translate-x-1 before:content-[''] before:absolute before:left-0 before:top-2 before:bottom-2 before:w-[3px] before:bg-[#DC2626] before:scale-y-0 before:origin-center hover:before:scale-y-100 before:transition-transform before:duration-300 before:ease-out"
                            >Sport</a
                        >
                        <a
                            href="/tags/kulture"
                            data-target="kulture"
                            class="mega-link relative block px-4 py-2.5 rounded-xl text-slate-800 font-bookerly font-bold text-[14px] tracking-normal no-underline overflow-hidden transition-all duration-300 ease-out hover:bg-slate-50 hover:text-[#DC2626] hover:translate-x-1 before:content-[''] before:absolute before:left-0 before:top-2 before:bottom-2 before:w-[3px] before:bg-[#DC2626] before:scale-y-0 before:origin-center hover:before:scale-y-100 before:transition-transform before:duration-300 before:ease-out"
                            >Kulturë</a
                        >
                        <a
                            href="/tags/showbiz"
                            data-target="showbiz"
                            class="mega-link relative block px-4 py-2.5 rounded-xl text-slate-800 font-bookerly font-bold text-[14px] tracking-normal no-underline overflow-hidden transition-all duration-300 ease-out hover:bg-slate-50 hover:text-[#DC2626] hover:translate-x-1 before:content-[''] before:absolute before:left-0 before:top-2 before:bottom-2 before:w-[3px] before:bg-[#DC2626] before:scale-y-0 before:origin-center hover:before:scale-y-100 before:transition-transform before:duration-300 before:ease-out"
                            >Showbiz</a
                        >
                        <a
                            href="/tags/udhetime"
                            data-target="udhetime"
                            class="mega-link relative block px-4 py-2.5 rounded-xl text-slate-800 font-bookerly font-bold text-[14px] tracking-normal no-underline overflow-hidden transition-all duration-300 ease-out hover:bg-slate-50 hover:text-[#DC2626] hover:translate-x-1 before:content-[''] before:absolute before:left-0 before:top-2 before:bottom-2 before:w-[3px] before:bg-[#DC2626] before:scale-y-0 before:origin-center hover:before:scale-y-100 before:transition-transform before:duration-300 before:ease-out"
                            >Udhëtime</a
                        >
                    </div>

                    <div
                        class="w-[180px] shrink-0 rounded-xl relative overflow-hidden shadow-sm bg-slate-100 group/imagebox"
                    >
                        <div
                            data-id="sport"
                            class="mega-panel absolute inset-0 transition-opacity duration-400 opacity-0 pointer-events-none"
                        >
                            <Image
                                src={imgSport}
                                alt="Sport"
                                class="absolute inset-0 w-full h-full object-cover transition-all duration-700 scale-100 group-hover/imagebox:scale-110 group-hover/imagebox:brightness-110"
                            />
                        </div>
                        <div
                            data-id="kulture"
                            class="mega-panel absolute inset-0 transition-opacity duration-400 opacity-0 pointer-events-none"
                        >
                            <Image
                                src={imgKulture}
                                alt="Kulturë"
                                class="absolute inset-0 w-full h-full object-cover transition-all duration-700 scale-100 group-hover/imagebox:scale-110 group-hover/imagebox:brightness-110"
                            />
                        </div>
                        <div
                            data-id="showbiz"
                            class="mega-panel absolute inset-0 transition-opacity duration-400 opacity-0 pointer-events-none"
                        >
                            <Image
                                src={imgShowbiz}
                                alt="Showbiz"
                                class="absolute inset-0 w-full h-full object-cover transition-all duration-700 scale-100 group-hover/imagebox:scale-110 group-hover/imagebox:brightness-110"
                            />
                        </div>
                        <div
                            data-id="udhetime"
                            class="mega-panel absolute inset-0 transition-opacity duration-400 opacity-0 pointer-events-none"
                        >
                            <Image
                                src={imgUdhetime}
                                alt="Udhëtime"
                                class="absolute inset-0 w-full h-full object-cover transition-all duration-700 scale-100 group-hover/imagebox:scale-110 group-hover/imagebox:brightness-110"
                            />
                        </div>
                    </div>
                </div>

                <div
                    id="menu-te-tjera"
                    class="menu-content mega-menu-container absolute top-0 left-0 w-[400px] p-3 flex gap-2 transition-all duration-300 ease-out opacity-0 pointer-events-none z-0 -translate-x-3"
                >
                    <div
                        class="links-wrapper flex-1 flex flex-col relative z-10 pr-2"
                    >
                        <a
                            href="/tags/shendeti"
                            data-target="shendeti"
                            class="mega-link relative block px-4 py-2.5 rounded-xl text-slate-800 font-bookerly font-bold text-[14px] tracking-normal no-underline overflow-hidden transition-all duration-300 ease-out hover:bg-slate-50 hover:text-[#DC2626] hover:translate-x-1 before:content-[''] before:absolute before:left-0 before:top-2 before:bottom-2 before:w-[3px] before:bg-[#DC2626] before:scale-y-0 before:origin-center hover:before:scale-y-100 before:transition-transform before:duration-300 before:ease-out"
                            >Shëndeti</a
                        >
                        <a
                            href="/tags/shkence"
                            data-target="shkence"
                            class="mega-link relative block px-4 py-2.5 rounded-xl text-slate-800 font-bookerly font-bold text-[14px] tracking-normal no-underline overflow-hidden transition-all duration-300 ease-out hover:bg-slate-50 hover:text-[#DC2626] hover:translate-x-1 before:content-[''] before:absolute before:left-0 before:top-2 before:bottom-2 before:w-[3px] before:bg-[#DC2626] before:scale-y-0 before:origin-center hover:before:scale-y-100 before:transition-transform before:duration-300 before:ease-out"
                            >Shkencë</a
                        >
                        <a
                            href="/tags/teknologji"
                            data-target="teknologji"
                            class="mega-link relative block px-4 py-2.5 rounded-xl text-slate-800 font-bookerly font-bold text-[14px] tracking-normal no-underline overflow-hidden transition-all duration-300 ease-out hover:bg-slate-50 hover:text-[#DC2626] hover:translate-x-1 before:content-[''] before:absolute before:left-0 before:top-2 before:bottom-2 before:w-[3px] before:bg-[#DC2626] before:scale-y-0 before:origin-center hover:before:scale-y-100 before:transition-transform before:duration-300 before:ease-out"
                            >Teknologji</a
                        >
                    </div>

                    <div
                        class="w-[180px] shrink-0 rounded-xl relative overflow-hidden shadow-sm bg-slate-100 group/imagebox"
                    >
                        <div
                            data-id="shendeti"
                            class="mega-panel absolute inset-0 transition-opacity duration-400 opacity-0 pointer-events-none"
                        >
                            <Image
                                src={imgShendeti}
                                alt="Shëndeti"
                                class="absolute inset-0 w-full h-full object-cover transition-all duration-700 scale-100 group-hover/imagebox:scale-110 group-hover/imagebox:brightness-110"
                            />
                        </div>
                        <div
                            data-id="shkence"
                            class="mega-panel absolute inset-0 transition-opacity duration-400 opacity-0 pointer-events-none"
                        >
                            <Image
                                src={imgShkence}
                                alt="Shkencë"
                                class="absolute inset-0 w-full h-full object-cover transition-all duration-700 scale-100 group-hover/imagebox:scale-110 group-hover/imagebox:brightness-110"
                            />
                        </div>
                        <div
                            data-id="teknologji"
                            class="mega-panel absolute inset-0 transition-opacity duration-400 opacity-0 pointer-events-none"
                        >
                            <Image
                                src={imgTeknologji}
                                alt="Teknologji"
                                class="absolute inset-0 w-full h-full object-cover transition-all duration-700 scale-100 group-hover/imagebox:scale-110 group-hover/imagebox:brightness-110"
                            />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-5 text-white">
            <button
                id="search-toggle"
                class="bg-transparent border-none cursor-pointer p-0 text-white hover:opacity-60 transition-opacity duration-300"
                aria-label="Kërko"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><circle cx="11" cy="11" r="8"></circle><line
                        x1="21"
                        y1="21"
                        x2="16.65"
                        y2="16.65"></line>
                </svg>
            </button>
            <button
                class="xl:hidden bg-transparent border-none cursor-pointer p-0 text-white hover:opacity-60 transition-opacity duration-300"
                id="menu-toggle"
                aria-label="Menu"
            >
                <svg
                    width="32"
                    height="32"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><line x1="3" y1="12" x2="21" y2="12"></line><line
                        x1="3"
                        y1="6"
                        x2="21"
                        y2="6"></line><line x1="3" y1="18" x2="21" y2="18"
                    ></line>
                </svg>
            </button>
        </div>
    </nav>

    <div
        class="hidden flex-col absolute top-full left-0 w-full h-[calc(100vh-80px)] overflow-y-auto bg-[#0f172a]/98 backdrop-blur-2xl shadow-2xl z-50 pointer-events-auto border-t border-slate-800/60 transition-opacity duration-300"
        id="mobile-menu"
    >
        <div class="flex flex-col p-6 md:p-8 gap-8 pb-32">
            <a
                href="/te-fundit"
                class="text-white font-bookerly font-black text-2xl tracking-wide no-underline border-b border-slate-800/60 pb-5 hover:text-[#DC2626] transition-colors duration-300"
                >Të fundit</a
            >

            <div class="flex flex-col gap-5 border-b border-slate-800/60 pb-6">
                <span
                    class="text-[#DC2626] font-black text-[11px] uppercase tracking-widest"
