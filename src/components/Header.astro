---
import '../app.css';
---

<header class="fixed top-0 left-0 w-full z-[1000] transition-transform duration-300 pointer-events-none">
    
    <nav class="flex items-center justify-between h-[80px] max-w-[1600px] mx-auto px-4 md:px-8 pointer-events-auto">
        
        <a href="/" class="flex items-center gap-3 group no-underline h-full py-2 select-none">
            
            <div class="lemza-icon bg-[#DC2626] text-white w-10 h-10 flex items-center justify-center rounded-sm shadow-sm shrink-0">
                <span class="font-bookerly font-black text-3xl! leading-none">L</span>
            </div>

            <div class="lemza-text flex flex-col justify-center h-10 text-white">
                <span class="font-black text-2xl leading-[0.8] tracking-tight uppercase font-bookerly">
                    LEMZA
                </span>
                <span class="font-bold text-2xl leading-none tracking-tight uppercase font-bookerly">
                    NEWS
                </span>
            </div>
        </a>

        <div class="hidden xl:flex gap-6 h-full items-center pt-1">
            <a href="/te-fundit" class="text-white font-bookerly font-bold text-[15px] tracking-normal no-underline transition-opacity duration-200 hover:opacity-60">Të fundit</a>
            
            <div class="group relative h-full flex items-center">
                <span class="text-white font-bookerly font-bold text-[15px] tracking-normal cursor-pointer transition-opacity duration-200 hover:opacity-60 flex items-center gap-1">
                    Aktualitet
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:rotate-180"><path d="M6 9l6 6 6-6"/></svg>
                </span>
                
                <div class="absolute top-full left-1/2 -translate-x-1/2 pt-2 invisible opacity-0 translate-y-3 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300 ease-out z-50">                    
                    <div class="bg-white/95 backdrop-blur-xl border border-slate-200 shadow-[0_10px_40px_rgba(0,0,0,0.08)] rounded-2xl p-2 flex flex-col min-w-[180px]">
                        <a href="/tags/politike" class="block px-4 py-2.5 rounded-xl text-slate-800 font-bookerly font-bold text-[14px] tracking-normal no-underline hover:bg-[#0f172a] hover:text-white transition-colors duration-200">Politikë</a>
                        <a href="/tags/ekonomi" class="block px-4 py-2.5 rounded-xl text-slate-800 font-bookerly font-bold text-[14px] tracking-normal no-underline hover:bg-[#0f172a] hover:text-white transition-colors duration-200">Ekonomi</a>
                        <a href="/tags/kronike" class="block px-4 py-2.5 rounded-xl text-slate-800 font-bookerly font-bold text-[14px] tracking-normal no-underline hover:bg-[#0f172a] hover:text-white transition-colors duration-200">Kronikë</a>
                        <a href="/tags/rajoni" class="block px-4 py-2.5 rounded-xl text-slate-800 font-bookerly font-bold text-[14px] tracking-normal no-underline hover:bg-[#0f172a] hover:text-white transition-colors duration-200">Rajoni</a>
                        <a href="/tags/bota" class="block px-4 py-2.5 rounded-xl text-slate-800 font-bookerly font-bold text-[14px] tracking-normal no-underline hover:bg-[#0f172a] hover:text-white transition-colors duration-200">Bota</a>
                        <a href="/tags/sociale" class="block px-4 py-2.5 rounded-xl text-slate-800 font-bookerly font-bold text-[14px] tracking-normal no-underline hover:bg-[#0f172a] hover:text-white transition-colors duration-200">Sociale</a>
                    </div>
                </div>
            </div>

            <div class="group relative h-full flex items-center">
                <span class="text-white font-bookerly font-bold text-[15px] tracking-normal cursor-pointer transition-opacity duration-200 hover:opacity-60 flex items-center gap-1">
                    Argëtim
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:rotate-180"><path d="M6 9l6 6 6-6"/></svg>
                </span>
                
                <div class="absolute top-full left-1/2 -translate-x-1/2 pt-2 invisible opacity-0 translate-y-3 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300 ease-out z-50">
                    <div class="bg-white/95 backdrop-blur-xl border border-slate-200 shadow-[0_10px_40px_rgba(0,0,0,0.08)] rounded-2xl p-2 flex flex-col min-w-[180px]">
                        <a href="/tags/sport" class="block px-4 py-2.5 rounded-xl text-slate-800 font-bookerly font-bold text-[14px] tracking-normal no-underline hover:bg-[#0f172a] hover:text-white transition-colors duration-200">Sport</a>
                        <a href="/tags/kulture" class="block px-4 py-2.5 rounded-xl text-slate-800 font-bookerly font-bold text-[14px] tracking-normal no-underline hover:bg-[#0f172a] hover:text-white transition-colors duration-200">Kulturë</a>
                        <a href="/tags/showbiz" class="block px-4 py-2.5 rounded-xl text-slate-800 font-bookerly font-bold text-[14px] tracking-normal no-underline hover:bg-[#0f172a] hover:text-white transition-colors duration-200">Showbiz</a>
                        <a href="/tags/udhetime" class="block px-4 py-2.5 rounded-xl text-slate-800 font-bookerly font-bold text-[14px] tracking-normal no-underline hover:bg-[#0f172a] hover:text-white transition-colors duration-200">Udhëtime</a>
                    </div>
                </div>
            </div>

            <div class="group relative h-full flex items-center">
                <span class="text-white font-bookerly font-bold text-[15px] tracking-normal cursor-pointer transition-opacity duration-200 hover:opacity-60 flex items-center gap-1">
                    Të tjera
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:rotate-180"><path d="M6 9l6 6 6-6"/></svg>
                </span>
                
                <div class="absolute top-full left-1/2 -translate-x-1/2 pt-2 invisible opacity-0 translate-y-3 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300 ease-out z-50">
                    <div class="bg-white/95 backdrop-blur-xl border border-slate-200 shadow-[0_10px_40px_rgba(0,0,0,0.08)] rounded-2xl p-2 flex flex-col min-w-[180px]">
                        <a href="/tags/shendeti" class="block px-4 py-2.5 rounded-xl text-slate-800 font-bookerly font-bold text-[14px] tracking-normal no-underline hover:bg-[#0f172a] hover:text-white transition-colors duration-200">Shëndeti</a>
                        <a href="/tags/shkence" class="block px-4 py-2.5 rounded-xl text-slate-800 font-bookerly font-bold text-[14px] tracking-normal no-underline hover:bg-[#0f172a] hover:text-white transition-colors duration-200">Shkencë</a>
                        <a href="/tags/teknologji" class="block px-4 py-2.5 rounded-xl text-slate-800 font-bookerly font-bold text-[14px] tracking-normal no-underline hover:bg-[#0f172a] hover:text-white transition-colors duration-200">Teknologji</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-5 text-white">
            <button id="search-toggle" class="bg-transparent border-none cursor-pointer p-0 text-white hover:opacity-60 transition-opacity duration-200" aria-label="Kërko">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            </button>
            
            <button class="xl:hidden bg-transparent border-none cursor-pointer p-0 text-white hover:opacity-60 transition-opacity" id="menu-toggle" aria-label="Menu">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
            </button>
        </div>
    </nav>

    <div class="hidden flex-col absolute top-full left-0 w-full h-[calc(100vh-80px)] overflow-y-auto bg-[#0f172a]/98 backdrop-blur-2xl shadow-2xl z-50 pointer-events-auto border-t border-slate-800/60" id="mobile-menu">
        <div class="flex flex-col p-6 md:p-8 gap-8 pb-32">
            
            <a href="/te-fundit" class="text-white font-bookerly font-black text-2xl tracking-wide no-underline border-b border-slate-800/60 pb-5 hover:text-[#DC2626] transition-colors">Të fundit</a>
            
            <div class="flex flex-col gap-5 border-b border-slate-800/60 pb-6">
                <span class="text-[#DC2626] font-black text-[11px] uppercase tracking-widest">Aktualitet</span>
                <div class="grid grid-cols-2 gap-y-5 gap-x-4 pl-1">
                    <a href="/tags/politike" class="text-slate-200 text-[17px] font-bookerly no-underline hover:text-white block transition-colors">Politikë</a>
                    <a href="/tags/ekonomi" class="text-slate-200 text-[17px] font-bookerly no-underline hover:text-white block transition-colors">Ekonomi</a>
                    <a href="/tags/kronike" class="text-slate-200 text-[17px] font-bookerly no-underline hover:text-white block transition-colors">Kronikë</a>
                    <a href="/tags/rajoni" class="text-slate-200 text-[17px] font-bookerly no-underline hover:text-white block transition-colors">Rajoni</a>
                    <a href="/tags/bota" class="text-slate-200 text-[17px] font-bookerly no-underline hover:text-white block transition-colors">Bota</a>
                    <a href="/tags/sociale" class="text-slate-200 text-[17px] font-bookerly no-underline hover:text-white block transition-colors">Sociale</a>
                </div>
            </div>

            <div class="flex flex-col gap-5 border-b border-slate-800/60 pb-6">
                <span class="text-[#DC2626] font-black text-[11px] uppercase tracking-widest">Argëtim</span>
                <div class="grid grid-cols-2 gap-y-5 gap-x-4 pl-1">
                    <a href="/tags/sport" class="text-slate-200 text-[17px] font-bookerly no-underline hover:text-white block transition-colors">Sport</a>
                    <a href="/tags/kulture" class="text-slate-200 text-[17px] font-bookerly no-underline hover:text-white block transition-colors">Kulturë</a>
                    <a href="/tags/showbiz" class="text-slate-200 text-[17px] font-bookerly no-underline hover:text-white block transition-colors">Showbiz</a>
                    <a href="/tags/udhetime" class="text-slate-200 text-[17px] font-bookerly no-underline hover:text-white block transition-colors">Udhëtime</a>
                </div>
            </div>

            <div class="flex flex-col gap-5 pb-4">
                <span class="text-[#DC2626] font-black text-[11px] uppercase tracking-widest">Të tjera</span>
                <div class="grid grid-cols-2 gap-y-5 gap-x-4 pl-1">
                    <a href="/tags/shendeti" class="text-slate-200 text-[17px] font-bookerly no-underline hover:text-white block transition-colors">Shëndeti</a>
                    <a href="/tags/shkence" class="text-slate-200 text-[17px] font-bookerly no-underline hover:text-white block transition-colors">Shkencë</a>
                    <a href="/tags/teknologji" class="text-slate-200 text-[17px] font-bookerly no-underline hover:text-white block transition-colors">Teknologji</a>
                </div>
            </div>
        </div>
    </div>

<div id="search-overlay" class="fixed inset-0 bg-slate-900/80 backdrop-blur-md z-[2000] flex justify-center items-start pt-[12vh] md:pt-[20vh] opacity-0 pointer-events-none transition-all duration-300 hidden">
    
    <button id="search-close" class="absolute top-4 right-4 md:top-8 md:right-8 text-slate-400 hover:text-white transition-colors cursor-pointer bg-slate-800/50 hover:bg-slate-700 p-2.5 md:p-3 rounded-full border border-slate-700 shadow-sm">
        <svg width="22" height="22" class="md:w-6 md:h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>

    <form action="/kerko" method="GET" class="w-full max-w-3xl mx-4">
        <div class="flex items-center bg-white rounded-xl md:rounded-2xl shadow-[0_20px_60px_rgba(0,0,0,0.5)] overflow-hidden pr-1.5 md:pr-2 pl-3 md:pl-6 py-1.5 md:py-2 border border-slate-200">
            
            <svg width="20" height="20" class="md:w-7 md:h-7 shrink-0 ml-1" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            
            <input 
                type="text" 
                name="q" 
                id="search-input"
                placeholder="Kërko..." 
                class="w-full bg-transparent border-none text-slate-800 text-lg md:text-2xl font-bookerly font-light py-3 md:py-4 px-3 md:px-4 outline-none placeholder:text-slate-400 placeholder:font-medium"
                autocomplete="off"
                required
            />
            
            <button type="submit" class="bg-[#DC2626] hover:bg-red-700 text-white font-black uppercase text-[10px] md:text-xs tracking-widest px-4 md:px-8 py-3 md:py-4 rounded-lg md:rounded-xl transition-colors cursor-pointer border-none shrink-0">
                KËRKO
            </button>
        </div>
        
        <p class="hidden md:block text-center mt-6 text-slate-400 font-news text-sm font-medium">
            Shtyp <kbd class="bg-slate-800 text-slate-300 px-2 py-1 rounded border border-slate-700 mx-1 font-mono text-xs shadow-sm">Enter</kbd> për të kërkuar ose <kbd class="bg-slate-800 text-slate-300 px-2 py-1 rounded border border-slate-700 mx-1 font-mono text-xs shadow-sm">ESC</kbd> për të mbyllur
        </p>
    </form>
</div>

</header>

<script>
    const header = document.querySelector('header');
    const menuBtn = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');

    // Ikonat për Menynë
    const iconHamburger = `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>`;
    const iconClose = `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>`;

    menuBtn?.addEventListener('click', () => {
        // Shfaq/Fshih menynë
        mobileMenu?.classList.toggle('hidden');
        mobileMenu?.classList.toggle('flex');
        
        // Blloko scroll-in e faqes kur menyja është e hapur
        document.body.classList.toggle('overflow-hidden');

        // Ndrysho ikonën Hamburger <-> X
        if (mobileMenu?.classList.contains('flex')) {
            menuBtn.innerHTML = iconClose;
        } else {
            menuBtn.innerHTML = iconHamburger;
        }
    });

    // Fsheh Header-in kur zbret poshtë (Funksionon vetëm nëse menyja është e mbyllur)
    window.addEventListener('scroll', () => {
        if (!mobileMenu?.classList.contains('flex')) {
            if (window.scrollY > 50) {
                header?.classList.add('-translate-y-full');
            } else {
                header?.classList.remove('-translate-y-full');
            }
        }
    });
    // --- LOGJIKA E KËRKIMIT ---
    const searchToggle = document.getElementById('search-toggle');
    const searchClose = document.getElementById('search-close');
    const searchOverlay = document.getElementById('search-overlay');
    const searchInput = document.getElementById('search-input');

    function openSearch() {
        searchOverlay?.classList.remove('hidden');
        // Vonesë e vogël që animacioni i opacitetit të duket i butë
        setTimeout(() => {
            searchOverlay?.classList.remove('opacity-0', 'pointer-events-none');
            searchOverlay?.classList.add('opacity-100', 'pointer-events-auto');
            searchInput?.focus();
            document.body.classList.add('overflow-hidden'); // Ndalon scroll-in e faqes poshtë
        }, 10);
    }

    function closeSearch() {
        searchOverlay?.classList.remove('opacity-100', 'pointer-events-auto');
        searchOverlay?.classList.add('opacity-0', 'pointer-events-none');
        document.body.classList.remove('overflow-hidden');
        setTimeout(() => {
            searchOverlay?.classList.add('hidden');
        }, 300); // Fshihet plotësisht pasi mbaron animacioni
    }

    searchToggle?.addEventListener('click', openSearch);
    searchClose?.addEventListener('click', closeSearch);

    // Mbyll kërkimin nëse lexuesi shtyp butonin "Escape" në tastierë
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && searchOverlay?.classList.contains('opacity-100')) {
            closeSearch();
        }
    });
</script>