---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<a href="/" class="logo-container">
			<div class="logo-box">L</div>
			<div class="logo-text">
				<span class="brand-name">LEMZA NEWS</span>
				<span class="brand-slogan">TË PARËT TE RRENA</span>
			</div>
		</a>

		<div class="internal-links">
			<HeaderLink href="/">KREU</HeaderLink>
			<HeaderLink href="/aktualitet">AKTUALITET</HeaderLink>
			<HeaderLink href="/tags/politike">POLITIKË</HeaderLink>
			<HeaderLink href="/tags/ekonomi">EKONOMI</HeaderLink>
			<HeaderLink href="/tags/showbiz">SHOWBIZ</HeaderLink>
		</div>

		<div class="search-container">
			<button id="search-btn" aria-label="Search">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
			</button>
		</div>
	</nav>
</header>

<style>
	/* --- HEADER CONTAINER --- */
	header {
		margin: 0;
		padding: 0 2rem;
		background: #343a46; /* The Dark Blue-Grey Background */
		color: white;
		box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 80px; /* Fixed height for stability */
		max-width: 1400px;
		margin: 0 auto;
	}

	/* --- LOGO STYLES --- */
	.logo-container {
		display: flex;
		align-items: center;
		text-decoration: none;
		gap: 12px;
	}

	.logo-box {
		background-color: #ff0033; /* The Red Box */
		color: white;
		font-size: 2rem;
		font-weight: 900;
		width: 45px;
		height: 45px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 2px;
	}

	.logo-text {
		display: flex;
		flex-direction: column;
		line-height: 1;
	}

	.brand-name {
		color: white;
		font-weight: 900;
		font-size: 1.4rem;
		text-transform: uppercase;
		letter-spacing: -0.5px;
	}

	.brand-slogan {
		color: #8890a0;
		font-size: 0.65rem;
		text-transform: uppercase;
		letter-spacing: 1px;
		margin-top: 2px;
	}

	/* --- MENU LINKS --- */
	.internal-links {
		display: flex;
		gap: 2rem;
	}

	/* Target the links inside HeaderLink component */
	.internal-links :global(a) {
		color: #d1d5db; /* Light gray text */
		text-decoration: none;
		font-weight: 700;
		font-size: 0.95rem;
		text-transform: uppercase;
		padding: 5px 0;
		border-bottom: 3px solid transparent;
		transition: color 0.2s;
	}

	.internal-links :global(a:hover) {
		color: white;
	}

	.internal-links :global(a.active) {
		color: white;
		border-bottom-color: #ff0033; /* Red underline */
	}

	/* --- SEARCH ICON --- */
	.search-container button {
		background: none;
		border: none;
		color: white;
		cursor: pointer;
		padding: 5px;
	}
	.search-container button:hover {
		color: #ff0033;
	}

	/* --- MOBILE --- */
	@media (max-width: 900px) {
		header { padding: 0 1rem; }
		nav { height: auto; padding: 1rem 0; flex-wrap: wrap; }
		.internal-links { 
			order: 3; 
			width: 100%; 
			justify-content: center; 
			margin-top: 1rem; 
			gap: 1rem;
			font-size: 0.8rem;
		}
		.logo-text { display: none; } /* Hide text on small screens to save space */
	}
</style>