---
// src/components/MostIgnored.astro
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const allPostsRaw = await getCollection('blog');
const sortedPosts = allPostsRaw.sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Marr 5 lajme rastësore
const randomPosts = sortedPosts.slice(10).sort(() => 0.5 - Math.random()).slice(0, 5);

const tagNames = { 
    'politike': 'Politikë', 
    'ekonomi': 'Ekonomi', 
    'showbiz': 'Showbiz', 
    'sport': 'Sport', 
    'kulture': 'Kulturë', 
    'kronike': 'Kronikë', 
    'sociale': 'Sociale', 
    'tekno-shkence': 'Tekno & Shkencë', 
    'shendeti': 'Shëndeti', 
    'rajoni': 'Rajoni', 
    'bota': 'Bota' 
};
---

<div class="bg-white rounded-[2rem] p-6 md:p-10 shadow-[0_8px_30px_rgb(0,0,0,0.04)] mt-6 md:mt-0">

    {/* Header Premium: Vetëm pika e kuqe dhe titulli, i pastër pa vija */}
    <div class="flex items-center gap-3 md:gap-4 mb-8 md:mb-10">
        <div class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-full bg-[#DC2626]"></div>
        <h3 class="text-slate-900 font-serif text-lg md:text-xl font-bold italic tracking-wide">
            Më të injoruarat
        </h3>
    </div>

    {/* Lista */}
    <div class="flex flex-col gap-6 md:gap-8">
        {randomPosts.map((post) => {
            const fileName = post.slug.split('/').pop() || '';
            const cleanSlug = fileName.replace(/\.md$/, '');
            const finalUrl = `/${cleanSlug}/`;

            return (
                <a href={finalUrl} class="group flex items-center gap-4 md:gap-6 no-underline">

                    {/* Fotoja Premium: Pa numra, theksi i bie direkt imazhit */}
                    <div class="relative shrink-0 w-[90px] md:w-[150px] lg:w-[170px] aspect-[4/3] md:aspect-[16/10] rounded-2xl overflow-hidden bg-slate-100 shadow-sm group-hover:shadow-xl transition-all duration-500 transform group-hover:-translate-y-1">
                        {post.data.heroImage ? (
                            <Image 
                                src={post.data.heroImage} 
                                alt={post.data.title}
                                width={300}
                                height={200}
                                class="w-full h-full object-cover" 
                            />
                        ) : (
                            <div class="w-full h-full flex items-center justify-center bg-slate-100 text-slate-300">
                                <span class="text-[9px]">IMG</span>
                            </div>
                        )}
                    </div>

                    {/* Teksti */}
                    <div class="flex flex-col flex-1 justify-center py-1">
                        <div class="flex flex-wrap gap-x-2 gap-y-1 mb-1.5 md:mb-2">
                            {post.data.tags && post.data.tags.length > 0 ? (
                                post.data.tags.map((tag: string) => (
                                    <span class="text-[9px] md:text-[10px] font-sans font-black text-slate-400 uppercase tracking-[0.2em]">
                                        {(tagNames as any)[tag] || tag}
                                    </span>
                                ))
                            ) : (
                                <span class="text-[9px] md:text-[10px] font-sans font-black text-slate-400 uppercase tracking-[0.2em]">
                                    LAJM
                                </span>
                            )}
                        </div>

                        <h4 class="font-bookerly text-slate-900 font-bold text-[15px] md:text-[19px] leading-snug md:leading-tight group-hover:text-[#DC2626] transition-colors duration-300 line-clamp-3 md:line-clamp-2">
                            {post.data.title}
                        </h4>
                    </div>
                </a>
            );
        })}
    </div>
</div>