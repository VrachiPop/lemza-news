---
// src/components/MostIgnored.astro
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const allPostsRaw = await getCollection('blog');
const sortedPosts = allPostsRaw.sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const randomPosts = sortedPosts.slice(10).sort(() => 0.5 - Math.random()).slice(0, 8);

const tagNames = { 
    'politike': 'Politikë', 
    'ekonomi': 'Ekonomi', 
    'showbiz': 'Showbiz', 
    'sport': 'Sport', 
    'kulture': 'Kulturë', 
    'kronike': 'Kronikë', 
    'sociale': 'Sociale', 
    'tekno-shkence': 'Tekno & Shkencë', 
    'shendeti': 'Shëndeti', 
    'rajoni': 'Rajoni', 
    'bota': 'Bota' 
};
---

<div class="relative bg-white border border-slate-200 p-4 md:p-6 rounded-xl shadow-sm mt-6">
    
    <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-[#0f172a] px-3 md:px-4 py-1 rounded-full shadow-sm whitespace-nowrap z-10">
        <span class="text-white font-black text-[10px] md:text-xs tracking-widest uppercase">
            Më të injoruarat
        </span>
    </div>

    <div class="flex flex-col divide-y divide-slate-200 mt-2">
        {randomPosts.map((post, index) => {
            const fileName = post.slug.split('/').pop() || '';
            const cleanSlug = fileName.replace(/\.md$/, '');
            const finalUrl = `/${cleanSlug}/`;

            return (
                <a href={finalUrl} class="group flex gap-3 md:gap-4 py-3 md:py-4 first:pt-0 no-underline items-start">
                    
                    <div class="relative shrink-0 w-[75px] h-[75px] md:w-[85px] md:h-[85px] rounded-md overflow-hidden bg-slate-100 shadow-sm group-hover:shadow-md transition-all duration-300">
                        {post.data.heroImage ? (
                            <Image 
                                src={post.data.heroImage} 
                                alt={post.data.title}
                                width={150}
                                height={150}
                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                            />
                        ) : (
                            <div class="w-full h-full flex items-center justify-center bg-slate-100 text-slate-300">
                                <span class="text-[9px]">IMG</span>
                            </div>
                        )}

                        <div class="absolute top-0 left-0 bg-[#0f172a] text-white text-[9px] md:text-[10px] font-black px-1.5 md:px-2 py-0.5 md:py-1 rounded-br-md z-10 font-sans shadow-sm">
                            #{index + 1}
                        </div>
                    </div>

                    <div class="flex flex-col justify-between h-[75px] md:h-[85px] py-0.5 w-full">
                        
                        <div class="flex flex-col gap-1">
                            <div class="flex flex-wrap gap-x-2 gap-y-1">
                                {post.data.tags && post.data.tags.length > 0 ? (
                                    post.data.tags.map((tag: string) => (
                                        <span class="text-[8px] md:text-[9px] font-bold text-[#DC2626] uppercase tracking-widest">
                                            {(tagNames as any)[tag] || tag}
                                        </span>
                                    ))
                                ) : (
                                    <span class="text-[8px] md:text-[9px] font-bold text-[#DC2626] uppercase tracking-widest">
                                        LAJM
                                    </span>
                                )}
                            </div>

                            <h4 class="font-bookerly font-light text-slate-800 text-[13px] md:text-[14px] leading-snug group-hover:text-[#0f172a] group-hover:underline decoration-2 underline-offset-2 transition-all duration-200 line-clamp-2 md:line-clamp-3">
                                {post.data.title}
                            </h4>
                        </div>

                        <div class="hidden md:flex items-center text-[#0f172a] font-bold text-[10px] uppercase tracking-widest opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300">
                            Lexo <span class="ml-1 text-sm leading-none">&rarr;</span>
                        </div>
                    </div>
                </a>
            );
        })}
    </div>
</div>