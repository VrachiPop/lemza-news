---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Poll from '../components/Poll.astro';
import EditorialBanner from '../components/EditorialBanner.astro';
import { SITE_TITLE } from '../consts';
import '../app.css';
---

<!doctype html>
<html lang="sq">
	<head>
		<BaseHead title={`Sondazhi - ${SITE_TITLE}`} description="Merrni pjesë në sondazh." />
	</head>
	<body class="bg-[#F1F5F9] flex flex-col min-h-screen">
		<Header />

            <EditorialBanner title="Sondazhi" />
    
            <main class="flex-grow flex flex-col items-center justify-center py-10">
                
                <div class="mb-6 text-center">
                    <span class="text-[#DC2626] font-black text-xs uppercase tracking-widest bg-white px-3 py-1 rounded shadow-sm">
                        Vox Populi
                    </span>
                </div>
    
                <div class="w-[75vmin] aspect-square bg-white rounded-xl shadow-2xl border border-slate-200 flex flex-col p-6 md:p-10 relative overflow-hidden">
                    
                    <div class="w-full h-full">
                        <Poll />
                    </div>
    
                </div>
    
                <div class="mt-8">
                    <a href="/" class="text-[10px] font-bold text-slate-400 uppercase tracking-widest hover:text-[#0f172a] transition-colors border-b border-transparent hover:border-[#0f172a] pb-0.5">
                        &larr; Kthehu tek Lajmet
                    </a>
                </div>  
            </main>

		<Footer />
	</body>
</html>