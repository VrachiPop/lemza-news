---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Sidebar from '../../components/Sidebar.astro';
import EditorialBanner from '../../components/EditorialBanner.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import { Image } from 'astro:assets';
import '../../app.css';
import type { Page } from 'astro';
import type { CollectionEntry } from 'astro:content';

// Importi qendror nga Helpers
import { getDisplayTag, getPostUrl } from '../../utils/helpers';

// LOGJIKA E PAGINIMIT NË ASTRO
export async function getStaticPaths({ paginate }: { paginate: Function }) {
    // 1. Merr të gjitha postimet dhe renditi (Më e reja -> Më e vjetra)
    const posts = (await getCollection('blog')).sort(
        (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
    );

    // 2. I themi Astro-s t'i ndajë nga 20 për çdo faqe
    return paginate(posts, { pageSize: 20 });
}

// I tregojmë TypeScript-it që 'page' mban lajme nga koleksioni 'blog'
interface Props {
    page: Page<CollectionEntry<'blog'>>;
}

const { page } = Astro.props;

// Kontrollojmë nëse jemi në faqen e parë (Faqja 1)
const isFirstPage = page.currentPage === 1;

// "Featured Post" (Lajmi i madh) shfaqet VETËM në faqen 1
const featuredPost = isFirstPage ? page.data[0] : null;

// Lista e lajmeve: Nëse jemi në faqen 1 heqim të parin, nëse jemi në faqet e tjera i tregojmë të gjitha 20
const restPosts = isFirstPage ? page.data.slice(1) : page.data;
---

<!doctype html>
<html lang="sq">
    <head>
        <BaseHead title={`Të Fundit - Faqja ${page.currentPage} - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
        <style>
             html, body {
                background-color: #F8FAFC;
                color: #1e293b;
            }
        </style>
    </head>
    <body>
        <Header />
        
        <EditorialBanner title="Të Fundit" />

        <div class="w-full max-w-[1600px] mx-auto px-2 pt-6 md:px-8 py-12 grid grid-cols-1 lg:grid-cols-12 gap-12">
            
            <main class="lg:col-span-8">
                
                {featuredPost && (
                    <article class="group mb-12 pb-12 border-b border-slate-200">
                        <a href={getPostUrl(featuredPost.slug)} class="no-underline text-inherit block">
                            
                            {/* Imazhi i Madh */}
                            <div class="relative w-full aspect-[16/9] overflow-hidden rounded-xl shadow-sm mb-6 bg-slate-100">
                                {featuredPost.data.heroImage ? (
                                    <Image 
                                        src={featuredPost.data.heroImage} 
                                        alt={featuredPost.data.title} 
                                        width={1000}   
                                        height={600}
                                        class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-700 ease-out" 
                                    />
                                ) : (
                                    <div class="w-full h-full bg-slate-200 flex items-center justify-center text-slate-400">IMG</div>
                                )}

                                {/* Tagu i Kuq (Floating) */}
                                <div class="absolute top-4 left-4 z-10 flex flex-wrap gap-2">
                                    {featuredPost.data.tags && featuredPost.data.tags.length > 0 ? (
                                        featuredPost.data.tags.map((tag: string) => (
                                            <span class="bg-[#DC2626] text-white text-xs font-black uppercase tracking-widest px-4 py-1.5 rounded-md shadow-lg">
                                                {getDisplayTag(tag)}
                                            </span>
                                        ))
                                    ) : (
                                        <span class="bg-[#DC2626] text-white text-xs font-black uppercase tracking-widest px-4 py-1.5 rounded-md shadow-lg">
                                            LAJM
                                        </span>
                                    )}
                                </div>
                            </div>

                            {/* Përmbajtja e Madhe */}
                            <div class="flex flex-col gap-3">
                                <div class="flex items-center gap-3 text-xs font-bold text-slate-400 uppercase tracking-widest">
                                    <FormattedDate date={featuredPost.data.pubDate} />
                                    <span class="text-[#DC2626]">&bull;</span>
                                    <span class="text-[#DC2626]">Kryesore</span>
                                </div>

                                <h3 class="text-3xl md:text-4xl font-serif font-black text-slate-900 leading-tight group-hover:text-[#0f172a] group-hover:underline decoration-4 underline-offset-8 transition-all">
                                    {featuredPost.data.title}
                                </h3>

                                <p class="text-lg text-slate-600 leading-relaxed line-clamp-3 font-sans mt-2">
                                    {featuredPost.data.description}
                                </p>
                            </div>
                        </a>
                    </article>
                )}

                <div class="flex flex-col divide-y divide-slate-200">
                    {restPosts.map((post: any) => (
                        <article class="group py-8 first:pt-0">
                            <a href={getPostUrl(post.slug)} class="no-underline text-inherit grid grid-cols-1 md:grid-cols-12 gap-6 items-start">
                                
                                {/* Image Left */}
                                <div class="md:col-span-4 lg:col-span-5 relative aspect-[16/10] overflow-hidden rounded-lg bg-slate-100 shadow-sm">
                                    {post.data.heroImage ? (
                                        <Image 
                                            src={post.data.heroImage} 
                                            alt={post.data.title} 
                                            width={500}   
                                            height={300} 
                                            class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-700 ease-out"
                                        />
                                    ) : (
                                        <div class="w-full h-full bg-slate-200 flex items-center justify-center text-slate-400">IMG</div>
                                    )}
                                    
                                    {/* Tagu i Kuq (Floating Small) */}
                                    <div class="absolute top-3 left-3 z-10 flex flex-wrap gap-2">
                                        {post.data.tags && post.data.tags.length > 0 ? (
                                            post.data.tags.map((tag: string) => (
                                                <span class="bg-[#DC2626] text-white text-[10px] font-black uppercase tracking-widest px-3 py-1 rounded-md shadow-md">
                                                    {getDisplayTag(tag)}
                                                </span>
                                            ))
                                        ) : (
                                            <span class="bg-[#DC2626] text-white text-[10px] font-black uppercase tracking-widest px-3 py-1 rounded-md shadow-md">
                                                LAJM
                                            </span>
                                        )}
                                    </div>
                                </div>

                                {/* Content Right */}
                                <div class="md:col-span-8 lg:col-span-7 flex flex-col justify-between h-full">
                                    <div>
                                        <div class="flex items-center gap-2 mb-2 text-[11px] font-bold text-slate-400 uppercase tracking-widest">
                                            <FormattedDate date={post.data.pubDate} />
                                        </div>

                                        <h3 class="text-xl font-serif font-bold text-slate-800 leading-tight mb-2 group-hover:text-[#0f172a] group-hover:underline decoration-2 underline-offset-4 transition-colors">
                                            {post.data.title}
                                        </h3>

                                        <p class="text-slate-600 text-sm leading-relaxed line-clamp-2 font-sans">
                                            {post.data.description}
                                        </p>
                                    </div>
                                    
                                    {/* Read More */}
                                    <div class="mt-3 md:mt-auto pt-2 flex items-center text-[#0f172a] font-bold text-xs uppercase tracking-widest opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300">
                                        Lexo të plotë &rarr;
                                    </div>
                                </div>
                            </a>
                        </article>
                    ))}
                </div>

                {/* ========================================== */}
{/* OPSIONI 2: STILI MODERN PILL (ELEGANT)     */}
{/* ========================================== */}
<div class="flex justify-center mt-16 pt-8">
    <div class="inline-flex items-center bg-white border border-slate-200 p-1.5 rounded-full shadow-lg">
        
        {/* Butoni PARA */}
        {page.url.prev ? (
            <a href={page.url.prev} class="flex items-center gap-2 px-5 py-3 rounded-full bg-transparent text-slate-700 font-extrabold text-[10px] md:text-xs uppercase tracking-widest hover:bg-[#DC2626] hover:text-white transition-all group">
                <span class="group-hover:-translate-x-1 transition-transform">&larr;</span> <span class="hidden sm:inline">Të reja</span>
            </a>
        ) : (
            <span class="flex items-center gap-2 px-5 py-3 rounded-full bg-transparent text-slate-300 font-extrabold text-[10px] md:text-xs uppercase tracking-widest cursor-not-allowed">
                &larr; <span class="hidden sm:inline">Të reja</span>
            </span>
        )}

        <div class="w-px h-8 bg-slate-200 mx-1 md:mx-3"></div>

        {/* INFO E FAQES */}
        <span class="px-4 font-black text-slate-800 text-sm">
            {page.currentPage} <span class="text-slate-400 font-medium mx-1">nga</span> {page.lastPage}
        </span>

        <div class="w-px h-8 bg-slate-200 mx-1 md:mx-3"></div>

        {/* Butoni TJETRA */}
        {page.url.next ? (
            <a href={page.url.next} class="flex items-center gap-2 px-5 py-3 rounded-full bg-transparent text-slate-700 font-extrabold text-[10px] md:text-xs uppercase tracking-widest hover:bg-[#DC2626] hover:text-white transition-all group">
                <span class="hidden sm:inline">Të vjetra</span> <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
            </a>
        ) : (
            <span class="flex items-center gap-2 px-5 py-3 rounded-full bg-transparent text-slate-300 font-extrabold text-[10px] md:text-xs uppercase tracking-widest cursor-not-allowed">
                <span class="hidden sm:inline">Të vjetra</span> &rarr;
            </span>
        )}
    </div>
</div>

            </main>

            <aside class="lg:col-span-4 lg:pl-10 border-l border-slate-200 hidden lg:block">
                <div class="sticky top-24">
                    <Sidebar />
                </div>
            </aside>
        </div>

        <Footer />
    </body>
</html>