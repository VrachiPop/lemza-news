---
import { getCollection } from 'astro:content';
import BlogPost from '../layouts/BlogPost.astro';

// --- KJO ËSHTË PJESA E NDRYSHUAR ---
export async function getStaticPaths() {
    const posts = await getCollection('blog');
    return posts.map((post) => ({
        params: { slug: post.slug },
        props: { post },
    }));
}
// -----------------------------------

const { post } = Astro.props;

// Kjo pjesa poshtë mbetet siç ishte (për siguri), 
// edhe pse tani 'post' do të vijë gjithmonë i mbushur nga getStaticPaths.
if (!post) {
    const { slug } = Astro.params;
    const allPosts = await getCollection('blog');
    const findPost = allPosts.find(p => 
        p.slug.split('/').pop()?.replace(/\.md$/, '') === slug || p.slug === slug
    );
    
    if (!findPost) return Astro.redirect('/404');
    
    var finalPost = findPost;
} else {
    var finalPost = post;
}

const { Content } = await finalPost.render();
---

<BlogPost {...finalPost.data}>
    <Content />
</BlogPost>