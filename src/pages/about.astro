---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import '../app.css';

const SITE_TITLE = "Rreth Nesh & Misioni | Lemza News";
const SITE_DESCRIPTION = "Misioni, politikat redaksionale dhe natyra satirike e Lemza News.";
---

<!doctype html>
<html lang="sq">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body class="bg-[#F1F5F9] font-['Literata',serif] flex flex-col min-h-screen">
        <Header />
        
        <div class="w-full max-w-[1600px] mx-auto px-4 md:px-6 py-10 grid grid-cols-1 lg:grid-cols-12 gap-12 flex-grow">
            
            <main class="lg:col-span-8">
                <div class="bg-white p-8 md:p-12 rounded-xl border border-slate-200 shadow-sm">
                    
                    <div class="border-b border-slate-200 pb-6 mb-8">
                        <h1 class="text-3xl! md:text-4xl font-black text-slate-900 mb-4">
                            Rreth Nesh
                        </h1>
                        <p class="text-xl text-slate-500 font-medium leading-relaxed">
                            Lemza News është destinacioni kryesor për satirë, humor dhe parodi në hapësirën dixhitale shqiptare.
                        </p>
                    </div>

                    <div class="prose prose-slate max-w-none prose-headings:font-black prose-headings:text-slate-900 prose-p:text-slate-600 prose-p:leading-relaxed">
                        
                        <h3>Misioni</h3>
                        <p>
                            Në një botë ku realiteti shpesh tejkalon fantazinë, <strong>Lemza News</strong> ka lindur si një nevojë për të qeshur me seriozitetin e tepruar të përditshmërisë. Misioni i Lemza News është të ofrojë një pasqyrë të shtrembëruar, por shpeshherë më të vërtetë, të ngjarjeve politike, sociale dhe kulturore në vend.
                        </p>
                        <p>
                            Lemza News beson se humori është mjeti më efikas për të kritikuar fenomenet negative të shoqërisë, pa sulmuar individët.
                        </p>

                        <div class="bg-slate-50 border-l-4 border-indigo-500 p-6 my-8 rounded-r-lg">
                            <h4 class="text-indigo-900 mt-0 mb-2 uppercase tracking-wide text-lg! font-black">
                                Deklaratë mbi Natyrën e Përmbajtjes
                            </h4>
                            <p class="text-sm text-slate-700 mb-0">
                                Lemza News është një <strong>publikim satirik</strong>. Të gjithë artikujt, lajmet dhe editorialet e publikuara në këtë faqe janë fiktive dhe kanë për qëllim argëtimin (Entertainment purpose only). 
                                Emrat e përdorur, përveç figurave publike që janë subjekt i satirës, janë pjellë e imagjinatës. Çdo ngjashmëri me persona realë, të gjallë apo të vdekur, është krejtësisht e rastësishme.
                            </p>
                        </div>

                        <h4>Politika Editoriale</h4>
                        <p>
                            Edhe pse një faqe satire, Lemza News merr seriozisht përgjegjësinë ndaj publikut dhe partnerëve (përfshirë platformat e reklamimit).
                        </p>
                        <ul class="marker:text-[#DC2626]">
                            <li><strong>Pa Gjuhë Urrejtjeje:</strong> Lemza News nuk toleron dhe nuk publikon përmbajtje që nxit dhunë, diskriminim apo urrejtje.</li>
                            <li><strong>Satirë, jo Dezinformim:</strong> Qëllimi i Lemza News është të bëjë lexuesin të qeshë, jo ta mashtrojë. Stili i shkrimit e bën të qartë natyrën parodike të lajmit.</li>
                            <li><strong>Respektimi i Privatësisë:</strong> Lemza News është e kujdesshme në trajtimin e temave sensitive dhe respekton privatësinë e individëve që nuk janë figura publike.</li>
                        </ul>

                       <h3 class="mt-8! text-2xl!">Kontakti & Bashkëpunimi</h3>
                        <p>
                            Lemza News është gjithmonë e hapur për sugjerime, ankesa, apo thjesht për të pirë një kafe (nëse paguani ju).
                        </p>
                        <p>
                            Për çdo pyetje serioze lidhur me përmbajtjen, reklamat apo të drejtat e autorit, ju lutemi kontaktoni në:
                            <br />
                            <a href="mailto:info@lemzanews.com" class="font-bold text-[#DC2626] no-underline hover:underline">info@lemzanews.com</a>
                        </p>

                    </div>
                </div>
            </main>

            <aside class="lg:col-span-4 border-l border-slate-200 pl-8 hidden lg:block">
                <div class="sticky top-8">
                    <Sidebar />
                </div>
            </aside>

        </div>
        
        <Footer />
    </body>
</html>