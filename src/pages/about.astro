---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../app.css';
import Sidebar from '../components/Sidebar.astro'; // <--- Importojmë Sidebar-in ekzistues

const SITE_TITLE = "Rreth Nesh | Lemza News";
const SITE_DESCRIPTION = "Platforma numër një në rajon për lajme që nuk kanë ndodhur kurrë.";
---

<!doctype html>
<html lang="sq">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
        </head>
	<body class="bg-white flex flex-col min-h-screen">
		<Header />
		
		<main class="flex-grow w-full">
            <div class="max-w-6xl mx-auto py-12 px-4 sm:px-6 lg:px-8">

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
                    
                    <div class="lg:col-span-2 space-y-16">

                        <div class="text-center md:text-left">
                            <div class="group relative inline-block">
                                <p class="text-xl! md:text-4xl text-slate-700 font-medium leading-relaxed font-['Literata',serif]">
                                    <span class="absolute -left-6 top-0 bottom-0 w-1.5 bg-[#DC2626] transition-all duration-500 group-hover:h-full group-hover:bg-slate-900 hidden md:block"></span>
                                    Mirë se erdhët në <strong class="text-slate-900 bg-gradient-to-r from-[#DC2626]/20 to-transparent px-2 rounded-md">Lemza News</strong>, platforma numër një në rajon për lajme që nuk kanë ndodhur kurrë, rrëfime të personazheve imagjinarë dhe statistika të shpikura në moment.
                                </p>
                            </div>
                        </div>

                        <div class="stats-grid grid grid-cols-1 md:grid-cols-3 gap-8 py-10 my-12 border-y border-slate-300 text-center bg-slate-50/50 rounded-2xl transition-colors duration-500 hover:bg-white hover:shadow-xl hover:border-slate-300">
                                <div class="stats-item group cursor-default transition-transform duration-300 hover:scale-110">
                                    <span class="block text-5xl font-black text-[#DC2626] mb-2 font-['Literata',serif] group-hover:text-slate-900 transition-colors">100%</span>
                                    <span class="text-xs font-bold text-slate-400 uppercase tracking-widest group-hover:text-[#DC2626]">Gënjeshtra</span>
                                    </div>
                                    <div class="stats-item group cursor-default transition-transform duration-300 hover:scale-110">
                                    <span class="block text-5xl font-black text-slate-900 mb-2 font-['Literata',serif]">0</span>
                                    <span class="text-xs font-bold text-slate-400 uppercase tracking-widest group-hover:text-slate-900">Fakte</span>
                                    </div>
                                    <div class="stats-item group cursor-default transition-transform duration-300 hover:scale-110">
                                    <span class="block text-5xl font-black text-[#DC2626] mb-2 font-['Literata',serif] group-hover:text-slate-900 transition-colors">12k</span>
                                    <span class="text-xs font-bold text-slate-400 uppercase tracking-widest group-hover:text-[#DC2626]">Padi në Gjykatë</span>
                                </div>
                        </div>

                        <div class="grid grid-cols-2 gap-8">
                            <div class="group bg-white p-8 rounded-3xl border border-slate-300 shadow-xl shadow-slate-200/50 transition-all duration-300 hover:-translate-y-1 hover:border-[#DC2626]/30">
                                <h3 class="text-xl! font-black text-slate-900 mb-4 uppercase flex items-center gap-3 font-['Literata',serif]">
                                    <span class="w-2.5 h-2.5 bg-[#DC2626] rounded-full group-hover:animate-ping"></span> Misioni Ynë
                                </h3>
                                <p class="text-slate-600 leading-relaxed text-sm font-medium">
                                    Të raportojmë atë që të tjerët kanë frikë ta imagjinojnë. Ne nuk ndjekim lajmin, ne e krijojmë atë nga hiçi.
                                </p>
                            </div>

                            <div class="group bg-white p-8 rounded-3xl border border-slate-300 shadow-xl shadow-slate-200/50 transition-all duration-300 hover:-translate-y-1 hover:border-[#DC2626]/30">
                                <h3 class="text-xl! font-black text-slate-900 mb-4 uppercase flex items-center gap-3 font-['Literata',serif]">
                                    <span class="w-2.5 h-2.5 bg-[#DC2626] rounded-full group-hover:animate-ping"></span> Standardet
                                </h3>
                                <p class="text-slate-600 leading-relaxed text-sm font-medium">
                                    Ne ruajmë standardet më të larta të gazetarisë fiktive. Çdo histori verifikohet me kujdes për t'u siguruar që është e pavërtetë.
                                </p>
                            </div>
                        </div>

                        <div class="bg-slate-900 text-white p-10 md:p-12 rounded-[2rem] text-center shadow-2xl relative overflow-hidden isolate">
                            <div class="absolute inset-0 bg-gradient-to-br from-slate-900 via-slate-900 to-[#DC2626]/20 opacity-50"></div>
                            
                            <div class="relative z-10">
                                <h3 class="text-2xl font-black uppercase mb-6 text-white! font-['Literata',serif]">Kontakt</h3>
                                <div class="flex flex-col md:flex-row gap-4 justify-center">
                                    <div class="bg-white/10 p-4 rounded-xl border border-white/10 text-sm flex-1 backdrop-blur-sm">
                                        <span class="text-slate-400 uppercase text-[10px] tracking-widest block mb-1">Email</span>
                                        <span class="font-bold text-white break-all">info@lemzanews.com</span>
                                    </div>
                                    <div class="bg-white/10 p-4 rounded-xl border border-white/10 text-sm flex-1 backdrop-blur-sm">
                                        <span class="text-slate-400 uppercase text-[10px] tracking-widest block mb-1">Adresa</span>
                                        <span class="font-bold text-white">Tuneli i Murrizit</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="
                                group relative 
                                bg-red-50 border-l-4 border-[#DC2626] 
                                p-6 mt-16 rounded-r 
                                text-xl! text-red-900 leading-relaxed
                                transform transition-all duration-500 ease-in-out
                                hover:-translate-y-1 hover:shadow-[0_10px_15px_-3px_rgba(220,38,38,0.2)] hover:bg-red-100">
                                <strong class="block uppercase mb-2 text-[#DC2626] font-extrabold tracking-wider animate-pulse">
                                        Mohimi i Përgjegjësisë (Disclaimer)
                                </strong>
                                    <p>
                                        Lemza News është një faqe satirike interneti. Artikujt, historitë dhe përmbajtja e publikuar në këtë faqe janë pjellë e imagjinatës ose parodi të ngjarjeve reale. Emrat e përdorur, përveç atyre të figurave publike të cilët janë subjekt i satirës, janë fiktivë. Çdo ngjashmëri me persona realë, të gjallë apo të vdekur, është krejtësisht e rastësishme. Përmbajtja nuk duhet të merret si faktike apo serioze.                       
                             </div>
                    </div> <aside class="lg:col-span-1">
                        <Sidebar />
                    </aside>

                </div> </div>
		</main>
		<Footer />
	</body>
</html>