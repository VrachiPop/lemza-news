---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import '../app.css';
---

<!doctype html>
<html lang="sq">
	<head>
		<BaseHead title="404 - Faqja u Zhduk | Lemza News" description="Kjo faqe nuk u gjet. Ndoshta e vodhën." />
		<style>
            /* GLOBAL RESET */
			* { box-sizing: border-box; }
			body { margin: 0; padding: 0; font-family: 'Literata', 'Georgia', sans-serif; background-color: #f9fafb; display: flex; flex-direction: column; min-height: 100vh; }

			main {
				flex-grow: 1;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 6rem;
				text-align: center;
			}

			.error-container {
				min-height: 60vh;
				max-width: 600px;
				background: white;
				padding: 3rem;
				border-radius: 12px;
				box-shadow: 0 10px 25px rgba(0,0,0,0.1);
				border-top: 6px solid #DC2626;
			}

			h1 {
				font-size: 8rem;
				font-weight: 900;
				margin: 0;
				color: #343a46;
				line-height: 1;
			}

			h2 {
				font-size: 2rem;
				margin: 1rem 0;
				color: #1f2937;
				text-transform: uppercase;
				font-weight: 800;
			}

			p {
				font-size: 1.1rem;
				color: #6b7280;
				line-height: 1.6;
				margin-bottom: 2rem;
			}

			.btn-home {
				display: inline-block;
				background-color: #DC2626;
				color: white;
				text-decoration: none;
				padding: 12px 30px;
				font-weight: bold;
				border-radius: 4px;
				text-transform: uppercase;
				transition: background 0.2s;
			}
			.btn-home:hover {
				background-color: #DC2626;
			}

			.excuse {
				font-style: italic;
				font-size: 0.9rem;
				color: #9ca3af;
				margin-top: 2rem;
				border-top: 1px solid #e5e7eb;
				padding-top: 1rem;
			}

			/* 2. STILI SPECIFIK PËR TELEFON (Mobile Only) */
            @media (max-width: 768px) {
                .error-container {
                    min-height: 60vh; /* Më pak lartësi në telefon */
                    padding: 2rem 1rem; /* Më pak hapësirë anash */
                }

                .error-number {
                    font-size: 5rem; /* Zvogëlojmë numrin 404 */
                    margin-bottom: 1rem;
                }

                .error-title {
                    font-size: 1.25rem; /* Zvogëlojmë titullin */
                    padding-left: 1rem;
                    padding-right: 1rem;
                }

                .error-desc {
                    font-size: 0.875rem; /* Tekst më i vogël për përshkrimin */
                    padding-left: 1.5rem;
                    padding-right: 1.5rem;
                }
            }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="error-container">
				<h1>404</h1>
				<h2>Faqja nuk u gjet</h2>
				<p>
					Na vjen keq, por kjo faqe nuk ekziston. <br>
					Ka shumë mundësi që të jetë vjedhur nga një politikan.
				</p>
				
				<a href="/" class="btn-home">Kthehu te Gënjeshtrat</a>

				<div class="excuse">
					*Ose ndoshta thjesht ke shkruar linkun gabim. Por le t'ia vëmë fajin sistemit.
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>