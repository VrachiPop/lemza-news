---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import '../app.css';

// 1. LOGJIKA E POSTIMEVE
const allPosts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 4 të parat për Hero Slider
const heroPosts = allPosts.slice(0, 4);
// Pjesa tjetër për Grid
const gridPosts = allPosts.slice(4);

const tagNames = {
   'politike': 'Politikë', 'ekonomi': 'Ekonomi', 'showbiz': 'Showbiz',
   'sport': 'Sport', 'kulture': 'Kulturë', 'kronike': 'Kronikë',
   'sociale': 'Sociale', 'tekno-shkence': 'Tekno & Shkencë',
   'shendeti': 'Shëndeti', 'rajoni': 'Rajoni', 'bota': 'Bota'
};

function getPostUrl(slug: string) {
    const fileName = slug.split('/').pop() || '';
    const cleanSlug = fileName.replace(/\.md$/, '');
    return `/${cleanSlug}/`;
}
---

<!doctype html>
<html lang="sq">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
        <style>
            html, body {
                margin: 0;
                padding: 0;
                background-color: #F1F5F9;
                color: #1e293b;
                scroll-behavior: smooth;
            }

            .news-container {
                padding-top: 2rem;
                padding-bottom: 4rem;
            }

            .article-card {
                background-color: #ffffff;
                border: 1px solid #e2e8f0;
                border-radius: 12px;
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }

            .article-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 25px 30px -10px rgba(51, 65, 85, 0.12);
                border-color: #cbd5e1;
            }

            /* Indikatorët poshtë */
            .slider-dot {
                width: 40px;
                height: 4px;
                background-color: rgba(255, 255, 255, 0.3);
                transition: all 0.3s;
                cursor: pointer;
            }
            .slider-dot.active {
                background-color: #DC2626;
            }

            /* --- MOBILE RESPONSIVE TWEAKS --- */
            @media (max-width: 768px) {
                /* 1. HERO SECTION NË TELEFON */
                .hero-wrapper {
                    /* Përdorim 80svh që të mos kërcejë kur shfaqet menuja e browserit */
                    height: 80svh !important; 
                    min-height: 500px;
                }

                .hero-title {
                    font-size: 1.75rem !important; /* E zvogëlova pak nga 2rem që të rrijë më mirë */
                    line-height: 1.15 !important;
                    padding: 0 10px; /* Që të mos ngjitet me anët */
                }
                
                .hero-category {
                    font-size: 0.7rem !important;
                    padding: 4px 10px !important;
                    margin-bottom: 1rem !important;
                }

                /* 2. SHIGJETAT NË TELEFON */
                .hero-arrow {
                    display: flex !important; /* I detyrojmë të shfaqen */
                    padding: 8px !important;  /* Më të vogla se në Desktop */
                    width: 40px !important;   /* Madhësi fikse */
                    height: 40px !important;
                    justify-content: center;
                    align-items: center;
                    background-color: rgba(255, 255, 255, 0.1) !important; /* Sfond i lehtë */
                }

                /* Zvogëlojmë ikonën SVG brenda shigjetës */
                .hero-arrow svg {
                    width: 20px !important;
                    height: 20px !important;
                }

                .hero-dots {
                    bottom: 1.5rem !important;
                }

                /* 3. NEWS CARDS NË TELEFON */
                .news-container {
                    padding-top: 1.5rem !important;
                }

                .card-title {
                    font-size: 1.25rem !important;
                    line-height: 1.3 !important;
                }
            }
        </style>
    </head>
    <body>
        
        <Header />
            
        <section class="relative w-full h-screen overflow-hidden bg-slate-900 group/slider">
            
            {heroPosts.map((post, index) => (
                <div 
                    class={`hero-slide absolute inset-0 w-full h-full transition-opacity duration-1000 ease-in-out ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
                    data-index={index}
                >
                    <a href={getPostUrl(post.slug)} class="block w-full h-full cursor-pointer">
                        <img 
                            src={post.data.heroImage} 
                            alt={post.data.title} 
                            class="absolute inset-0 h-full w-full object-cover" 
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent opacity-80"></div>

                        <div class="absolute bottom-0 left-0 right-0 flex flex-col items-center justify-end p-6 pb-24 text-center z-20">
                            <span class="mb-6 inline-block bg-[#DC2626] px-3 py-1 text-[12px] font-black uppercase tracking-widest text-white shadow-lg rounded-md">
                                {post.data.tags && post.data.tags.length > 0 ? (tagNames as any)[post.data.tags[0]] : 'Kryesore'}
                            </span>
                            <h1 class="max-w-6xl font-['Literata',serif] text-4xl font-bold leading-tight text-white! drop-shadow-lg md:text-6xl lg:text-7xl">
                                {post.data.title}
                            </h1>
                        </div>
                    </a>
                </div>
            ))}

            <button 
                onclick="prevSlide()" 
                class="hero-arrow absolute left-2 md:left-4 top-1/2 z-30 -translate-y-1/2 rounded-full bg-white/10 p-2 md:p-3 text-white backdrop-blur-sm transition-all hover:bg-white/20 hover:scale-110 active:scale-95 flex items-center justify-center"
                aria-label="Previous Slide"
            >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-6 md:size-8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
                </svg>
            </button>

            <button 
                onclick="nextSlideManual()" 
                class="hero-arrow absolute right-2 md:right-4 top-1/2 z-30 -translate-y-1/2 rounded-full bg-white/10 p-2 md:p-3 text-white backdrop-blur-sm transition-all hover:bg-white/20 hover:scale-110 active:scale-95 flex items-center justify-center"
                aria-label="Next Slide"
            >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-6 md:size-8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                </svg>
            </button>

            <div class="absolute bottom-8 left-0 right-0 z-30 flex justify-center gap-2">
                {heroPosts.map((_, index) => (
                    <button 
                        class={`slider-dot rounded-full ${index === 0 ? 'active' : ''}`} 
                        onclick={`manualChangeSlide(${index})`}
                        aria-label={`Go to slide ${index + 1}`}
                    ></button>
                ))}
            </div>

        </section>

        <div class="news-container">
            <div class="w-full max-w-[1600px] mx-auto px-4 md:px-8 grid grid-cols-1 lg:grid-cols-12 gap-16">
                
                <main class="lg:col-span-8">
                    <div class="flex items-end mb-6 border-b-2 border-slate-900 pb-1">
                        <h2 class="text-2xl! font-black text-slate-900 m-0 uppercase tracking-tighter">Të tjera</h2>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-10">
                        {gridPosts.map((post) => (
                            <article class="article-card group h-full flex flex-col relative overflow-hidden">
                                <a href={getPostUrl(post.slug)} class="no-underline text-inherit flex-1 flex flex-col">
                                    <div class="relative aspect-[16/10] overflow-hidden rounded-t-xl">
                                        <div class="absolute top-4 left-4 z-20">
                                            <span class="bg-[#DC2626] text-white px-3 py-1 text-[10px] font-black uppercase tracking-widest rounded-sm shadow-md">
                                                {post.data.tags && post.data.tags.length > 0 ? (tagNames as any)[post.data.tags[0]] : 'LAJME'}
                                            </span>
                                        </div>
                                        <img src={post.data.heroImage} alt="" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                                    </div>
                                    <div class="p-5 flex flex-col flex-1">
                                        <div class="flex items-center gap-2 text-[11px] font-bold text-slate-400 mb-3 uppercase tracking-widest">
                                            <span class="text-[#DC2626] font-black">/</span>
                                            <FormattedDate date={post.data.pubDate} />
                                        </div>
                                        <h3 class="text-xl! font-black text-slate-800 mb-3 leading-tight group-hover:text-[#DC2626] transition-colors line-clamp-2">
                                            {post.data.title}
                                        </h3>
                                        <p class="text-sm text-slate-500 leading-relaxed line-clamp-2 font-medium mb-6">
                                            {post.data.description}
                                        </p>
                                        <div class="mt-auto flex items-center text-[#DC2626] font-black text-[11px] uppercase tracking-widest group/link">
                                            LEXO MË SHUMË
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-3.5 h-3.5 ml-2 transition-transform duration-300 group-hover:translate-x-2">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                                            </svg>
                                        </div>
                                    </div>
                                </a>
                            </article>
                        ))}
                    </div>
                </main>

                <aside class="lg:col-span-4 mt-12 lg:mt-0 lg:pl-12 border-l-2 border-slate-200">
                    <div class="sticky top-10">
                        <Sidebar />
                    </div>
                </aside>
            </div>
        </div>
        
        <Footer />

        <script is:inline>
            let currentSlide = 0;
            const slides = document.querySelectorAll('.hero-slide');
            const dots = document.querySelectorAll('.slider-dot');
            const totalSlides = slides.length;
            const slideDuration = 8000; // 8 Sekonda
            let slideInterval;

            function showSlide(index) {
                // Fsheh të gjitha
                slides.forEach(slide => {
                    slide.classList.remove('opacity-100', 'z-10');
                    slide.classList.add('opacity-0', 'z-0');
                });
                dots.forEach(dot => dot.classList.remove('active'));

                // Shfaq aktivin
                slides[index].classList.remove('opacity-0', 'z-0');
                slides[index].classList.add('opacity-100', 'z-10');
                dots[index].classList.add('active');
                
                currentSlide = index;
            }

            function nextSlide() {
                let next = (currentSlide + 1) % totalSlides;
                showSlide(next);
            }

            function prevSlide() {
                // Logjika për të shkuar mbrapsht (nëse je te 0 shkon te i fundit)
                let prev = (currentSlide - 1 + totalSlides) % totalSlides;
                resetTimer();
                showSlide(prev);
            }

            function nextSlideManual() {
                resetTimer();
                nextSlide();
            }

            function manualChangeSlide(index) {
                resetTimer();
                showSlide(index);
            }

            function resetTimer() {
                clearInterval(slideInterval);
                slideInterval = setInterval(nextSlide, slideDuration);
            }

            // Start Auto Play (8 sekonda)
            if(totalSlides > 0) {
                slideInterval = setInterval(nextSlide, slideDuration);
            }
        </script>
    </body>
</html>