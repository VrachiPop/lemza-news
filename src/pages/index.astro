---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import '../app.css';

const allPosts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
).slice(0, 7);

const heroPost = allPosts[0];
const gridPosts = allPosts.slice(1);

const tagNames = {
   'politike': 'Politikë', 'ekonomi': 'Ekonomi', 'showbiz': 'Showbiz',
   'sport': 'Sport', 'kulture': 'Kulturë', 'kronike': 'Kronikë',
   'sociale': 'Sociale', 'tekno-shkence': 'Tekno & Shkencë',
   'shendeti': 'Shëndeti', 'rajoni': 'Rajoni', 'bota': 'Bota'
};

// --- FUNKSION PËR PASTRIMIN E URL (HELPER) ---
// Kjo siguron që linku të jetë i njëjtë kudo: /titulli/
function getPostUrl(slug: string) {
    const fileName = slug.split('/').pop() || '';
    const cleanSlug = fileName.replace(/\.md$/, '');
    return `/${cleanSlug}/`;
}
---

<!doctype html>
<html lang="sq">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
        <style>
            /* 1. PALETA GLOBALE */
            html, body {
                margin: 0;
                padding: 0;
                background-color: #F1F5F9;
                color: #1e293b;
                scroll-behavior: smooth;
            }

            /* HERO SECTION - DARK MODE VERSION (SLATE 900) */
            .top-container {
                display: flex;
                flex-direction: column;
                width: 100%;
                background-color: #0f172a; 
                border-bottom: 1px solid #1e293b;
            }

            .hero-section {
                display: grid;
                grid-template-columns: 1.2fr 1fr;
                align-items: center;
                width: 100%;
                min-height: 500px;
            }

            .hero-content {
                padding: 5rem 5rem;
                z-index: 10;
            }

            .hero-title {
                font-size: clamp(2.5rem, 5vw, 2.8rem);
                font-weight: 900;
                line-height: 1;
                margin-bottom: 2rem;
                color: #ffffff;
                letter-spacing: -0.04em;
            }

            .hero-desc-wrapper {
                border-left: 6px solid #DC2626;
                padding-left: 2rem;
                margin-bottom: 3rem;
                max-width: 550px;
            }

            .hero-desc {
                font-size: 1.1rem;
                color: #cbd5e1 !important;
                line-height: 1.6;
                font-weight: 500;
            }

            /* BUTTON STYLE */
            .btn-lexo-hero {
                background-color: #DC2626 !important;
                color: white !important;
                padding: 16px 50px !important;
                font-weight: 900 !important;
                text-transform: uppercase !important;
                text-decoration: none !important;
                border-radius: 4px !important;
                display: inline-block !important;
                transition: all 0.3s ease !important;
                box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3) !important;
                border: none !important;
                cursor: pointer !important;
            }

            .btn-lexo-hero:hover {
                background-color: #b91c1c !important;
                transform: translateY(-3px) !important;
                box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.4) !important;
            }

            /* HERO IMAGE CONTAINER */
            .hero-image-container {
                width: 100%;
                height: 100%;
                position: relative;
                overflow: hidden;
            }

            .hero-image-container img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                mask-image: linear-gradient(to right, transparent, black 45%);
                -webkit-mask-image: linear-gradient(to right, transparent, black 45%);
            }

           /* 6. RESPONSIVE - MOBILE (STRETCHED GRID) */
@media (max-width: 900px) {
    .hero-section {
        display: grid !important;
        /* Raporti: Teksti 55%, Imazhi 45% (pak më shumë vend imazhit) */
        grid-template-columns: 1.2fr 1fr !important; 
        align-items: center !important;
        /* KËTU ËSHTË "STRETCH": I japim një lartësi minimale fikse */
        min-height: 300px !important; 
        height: auto !important;
        padding: 0 !important;
        overflow: hidden; /* Siguri që imazhi mos dalë jashtë */
    }

    .hero-content {
        /* Më shumë frymëmarrje (padding) lart e poshtë */
        padding: 2rem 0.5rem 2rem 1.5rem !important;
        text-align: left !important;
        width: 100% !important;
        z-index: 20 !important;
        display: flex;
        flex-direction: column;
        justify-content: center;
        height: 100%;
    }

    .hero-title {
        /* Font pak më i madh se versioni i ngjeshur */
        font-size: 1.25rem !important; 
        line-height: 1.15 !important;
        margin-bottom: 0.8rem !important;
    }

    .tag-red {
        font-size: 0.65rem !important;
        padding: 3px 8px !important;
        margin-bottom: 0.8rem !important;
        align-self: flex-start;
    }

    .hero-desc-wrapper {
        border-left: 3px solid #DC2626 !important;
        padding-left: 0.8rem !important;
        margin-bottom: 1.2rem !important;
        display: block !important; /* Sigurohemi që shfaqet */
    }
    
    .hero-desc {
        font-size: 0.8rem !important;
        line-height: 1.3 !important;
        display: -webkit-box;
        -webkit-line-clamp: 4; /* Lejojmë deri në 4 rreshta tani */
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .btn-lexo-hero {
        padding: 8px 16px !important;
        font-size: 0.7rem !important;
        width: auto !important;
        align-self: flex-start;
    }

    .hero-image-container {
        display: block !important;
        width: 100% !important;
        height: 100% !important; /* Merr gjithë lartësinë e re (300px+) */
        position: relative !important;
    }

    .hero-image-container img {
        width: 100% !important;
        height: 100% !important;
        object-fit: cover !important;
        /* Maska pak më e butë */
        mask-image: linear-gradient(to right, transparent 0%, black 50%) !important;
        -webkit-mask-image: linear-gradient(to right, transparent 0%, black 50%) !important;
    }

    /* Fshehim datën për pastërti, ose mund ta kthesh nëse do */
    .hero-content .flex.items-center.gap-3 {
        display: none !important;
    }
}

            /* GRID AREA */
            .news-container {
                padding: 6rem 0;
            }

            .article-card {
                background-color: #ffffff;
                border: 1px solid #e2e8f0;
                border-radius: 12px;
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }

            .article-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 25px 30px -10px rgba(51, 65, 85, 0.12);
                border-color: #cbd5e1;
            }

            .tag-red {
                background-color: #DC2626;
                color: white;
                padding: 5px 12px;
                text-transform: uppercase;
                font-weight: 900;
                font-size: 0.75rem;
                border-radius: 2px;
            }
        </style>
    </head>
    <body>
        
        <div class="top-container">
            <Header />
            
            <section class="hero-section">
                <div class="hero-content">
                    <div class="tag-red mb-6 inline-block tracking-widest">
                        {heroPost.data.tags && heroPost.data.tags.length > 0 ? (tagNames as any)[heroPost.data.tags[0]] : 'Lajmi i Fundit'}
                    </div>
                    
                    <h1 class="hero-title">{heroPost.data.title}</h1>
                    
                    <div class="hero-desc-wrapper">
                        <p class="hero-desc">{heroPost.data.description}</p>
                    </div>
                    
                    <div class="flex items-center gap-3 mb-10 text-sm font-bold text-slate-500 uppercase tracking-widest">
                        <span class="w-3 h-3 bg-green-500 rounded-full animate-pulse"></span>
                        <FormattedDate date={heroPost.data.pubDate} />
                    </div>
                    
                    <div class="hero-buttons">
                        {/* FIX: Përdorim funksionin getPostUrl për linkun e saktë */}
                        <a href={getPostUrl(heroPost.slug)} class="btn-lexo-hero">LEXO MË SHUMË</a>
                    </div>
                </div>
                
                <div class="hero-image-container">
                    {heroPost.data.heroImage && (
                        <img src={heroPost.data.heroImage} alt={heroPost.data.title} />
                    )}
                </div>
            </section>
        </div>

        <div class="news-container">
            <div class="w-full max-w-[1600px] mx-auto px-4 md:px-8 grid grid-cols-1 lg:grid-cols-12 gap-16">
                
                <main class="lg:col-span-8">
                    <div class="flex justify-between items-end mb-12 border-b-4 border-slate-900 pb-5">
                        <h2 class="text-2xl! font-black text-slate-900 m-0 uppercase tracking-tighter">Të tjera</h2>
                        {/* FIX: Linku i butonit "Shiko të gjitha" duhet të shkojë te faqja e listës */}
                        <a href="/te-fundit/" class="text-slate-500 hover:text-[#DC2626] font-bold text-xs uppercase tracking-widest transition-colors">Shiko të gjitha</a>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-6">
                        {gridPosts.map((post) => (
                            <article class="article-card group h-full flex flex-col relative overflow-hidden">
                                {/* FIX: Përdorim funksionin getPostUrl për linkun e saktë */}
                                <a href={getPostUrl(post.slug)} class="no-underline text-inherit flex-1 flex flex-col">
                                    
                                    <div class="relative aspect-[16/10] overflow-hidden rounded-t-xl">
                                        <div class="absolute top-4 left-4 z-20">
                                            <span class="bg-[#DC2626] text-white px-3 py-1 text-[10px] font-black uppercase tracking-widest rounded-sm shadow-md">
                                                {post.data.tags && post.data.tags.length > 0 ? (tagNames as any)[post.data.tags[0]] : 'LAJME'}
                                            </span>
                                        </div>
                                        <img src={post.data.heroImage} alt="" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                                    </div>

                                    <div class="p-4 flex flex-col flex-1">
                                        
                                        <div class="flex items-center gap-2 text-[11px] font-bold text-slate-400 mb-3 uppercase tracking-widest">
                                            <span class="text-[#DC2626] font-black">/</span>
                                            <FormattedDate date={post.data.pubDate} />
                                        </div>

                                        <h3 class="text-lg! font-black text-slate-800 mb-3 leading-tight group-hover:text-[#DC2626] transition-colors line-clamp-2">
                                            {post.data.title}
                                        </h3>

                                        <p class="text-sm text-slate-500 leading-relaxed line-clamp-2 font-medium mb-6">
                                            {post.data.description}
                                        </p>

                                        <div class="mt-auto flex items-center text-[#DC2626] font-black text-[11px] uppercase tracking-widest group/link">
                                            LEXO MË SHUMË
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-3.5 h-3.5 ml-2 transition-transform duration-300 group-hover:translate-x-2">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                                            </svg>
                                        </div>

                                    </div>
                                </a>
                            </article>
                        ))}
                    </div>
                </main>

                <aside class="lg:col-span-4 mt-12 lg:mt-0 lg:pl-12 border-l-2 border-slate-200">
                    <div class="sticky top-10">
                        <Sidebar />
                    </div>
                </aside>
            </div>
        </div>
        
        <Footer />
    </body>
</html>