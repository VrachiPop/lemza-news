---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import Hero from '../components/home/Hero.astro'; // <--- IMPORT THE NEW HERO
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import '../app.css';

// 1. Fetch all posts
const allPosts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 2. Skip the first 4 (because they are in the Hero component)
const gridPosts = allPosts.slice(4);

const tagNames = {
   'politike': 'Politikë', 'ekonomi': 'Ekonomi', 'showbiz': 'Showbiz',
   'sport': 'Sport', 'kulture': 'Kulturë', 'kronike': 'Kronikë',
   'sociale': 'Sociale', 'tekno-shkence': 'Tekno & Shkencë',
   'shendeti': 'Shëndeti', 'rajoni': 'Rajoni', 'bota': 'Bota'
};

function getPostUrl(slug: string) {
    const fileName = slug.split('/').pop() || '';
    const cleanSlug = fileName.replace(/\.md$/, '');
    return `/${cleanSlug}/`;
}
---

<!doctype html>
<html lang="sq">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
        <style>
            html, body {
                margin: 0;
                padding: 0;
                background-color: #F1F5F9;
                color: #1e293b;
                scroll-behavior: smooth;
            }

            .news-container {
                padding-top: 0rem;
                padding-bottom: 4rem;
            }

            .article-card {
                background-color: #ffffff;
                border: 1px solid #e2e8f0;
                border-radius: 12px;
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }

            .article-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 25px 30px -10px rgba(51, 65, 85, 0.12);
                border-color: #cbd5e1;
            }
        </style>
    </head>
    <body>
        
        <Header />
            
        <Hero />

        <div class="news-container">
            <div class="w-full max-w-[1600px] mx-auto px-4 md:px-8 grid grid-cols-1 lg:grid-cols-12 gap-16">
                
                <main class="lg:col-span-8">
                    <div class="flex items-end mb-6 border-b-2 border-slate-900 pb-1">
                        <h2 class="text-2xl! font-light text-slate-900 m-0 uppercase tracking-tighter">Të tjera</h2>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-10">
                        {gridPosts.map((post) => (
                            <article class="article-card group h-full flex flex-col relative overflow-hidden">
                                <a href={getPostUrl(post.slug)} class="no-underline text-inherit flex-1 flex flex-col">
                                    <div class="relative aspect-[16/10] overflow-hidden rounded-t-xl">
                                        <div class="absolute top-4 left-4 z-20">
                                            <span class="bg-[#DC2626] text-white px-3 py-1 text-[10px] font-black uppercase tracking-widest rounded-sm shadow-md">
                                                {post.data.tags && post.data.tags.length > 0 ? (tagNames as any)[post.data.tags[0]] : 'LAJME'}
                                            </span>
                                        </div>
                                        <img src={post.data.heroImage} alt="" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                                    </div>
                                    <div class="p-5 flex flex-col flex-1">
                                        <div class="flex items-center gap-2 text-[11px] font-bold text-slate-400 mb-3 uppercase tracking-widest">
                                            <span class="text-[#DC2626] font-black">/</span>
                                            <FormattedDate date={post.data.pubDate} />
                                        </div>
                                        <h3 class="text-xl! font-black text-slate-800 mb-3 leading-tight group-hover:text-[#DC2626] transition-colors">
                                            {post.data.title}
                                        </h3>
                                        <p class="text-sm text-slate-500 leading-relaxed line-clamp-2 font-medium mb-6">
                                            {post.data.description}
                                        </p>
                                        <div class="mt-auto flex items-center text-[#DC2626] font-black text-[11px] uppercase tracking-widest group/link">
                                            LEXO MË SHUMË
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-3.5 h-3.5 ml-2 transition-transform duration-300 group-hover:translate-x-2">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                                            </svg>
                                        </div>
                                    </div>
                                </a>
                            </article>
                        ))}
                    </div>
                </main>

                <aside class="lg:col-span-4 mt-12 lg:mt-0 lg:pl-12 border-l-2 border-slate-200">
                    <div class="sticky top-10">
                        <Sidebar />
                    </div>
                </aside>
            </div>
        </div>
        
        <Footer />
    </body>
</html>