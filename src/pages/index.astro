---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import CategorySection from '../components/CategorySection.astro';
import Hero from '../components/home/Hero.astro';
import QuoteOfTheDay from '../components/QuoteOfTheDay.astro'; 
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { Image } from 'astro:assets';
import '../app.css';
import HoroscopeWidget from '../components/HoroscopeWidget.astro';
import { getDisplayTag, getPostUrl } from '../utils/helpers';
import PollBaner from '../components/PollBaner.astro';
import EditorsPick from '../components/EditorsPick.astro';

const allPosts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredPost = allPosts[1]; 
const bottomRowPosts = allPosts.slice(2, 6); 
const ignoredPosts = allPosts.slice(6, 20).sort(() => 0.5 - Math.random()).slice(0, 8);
---

<!doctype html>
<html lang="sq">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
        <style>
            html, body {
                margin: 0;
                padding: 0;
                background-color: #ffffff;
                color: #1e293b;
                scroll-behavior: smooth;
            }
            .news-container {
                padding-top: 4rem; 
            }
        </style>
    </head>
    <body>
        
        <Header />
        <Hero />

        <div class="news-container">
            <main class="w-full max-w-[1300px] mx-auto px-4 md:px-8 flex flex-col gap-10">
                
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10">
                    
                    {featuredPost && (
                        <div class="lg:col-span-8">
                            <article class="group relative flex flex-col h-full">
                                <a href={getPostUrl(featuredPost.slug)} class="no-underline text-inherit flex flex-col h-full">
                                    <div class="relative w-full aspect-[16/9] md:aspect-[2/1] overflow-hidden rounded-xl shadow-sm mb-5 bg-slate-100 shrink-0">
                                        {featuredPost.data.heroImage ? (
                                            <Image 
                                                src={featuredPost.data.heroImage} 
                                                alt={featuredPost.data.title} 
                                                width={900}   
                                                height={450}
                                                class="w-full h-full object-cover" 
                                            />
                                        ) : (
                                            <div class="w-full h-full bg-slate-200 flex items-center justify-center text-slate-400">IMG</div>
                                        )}
                                        <div class="absolute top-4 left-4 z-10">
                                            <span class="bg-[#DC2626] text-white text-[11px] font-black uppercase tracking-widest px-3 py-1.5 rounded-sm shadow-md">
                                                {featuredPost.data.tags && featuredPost.data.tags.length > 0 ? getDisplayTag(featuredPost.data.tags[0]) : 'KRYESORE'}
                                            </span>
                                        </div>
                                    </div>
                                    <div class="flex flex-col gap-3 flex-1">
                                        <div class="flex items-center gap-2 text-xs font-bold text-slate-400 uppercase tracking-widest">
                                            <FormattedDate date={featuredPost.data.pubDate} />
                                        </div>
                                        <h3 class="text-xl md:text-2xl lg:text-3xl font-serif font-black text-slate-900 leading-tight group-hover:text-[#0f172a] group-hover:underline decoration-4 underline-offset-8 transition-all">
                                            {featuredPost.data.title}
                                        </h3>
                                        <p class="text-lg text-slate-600 leading-relaxed font-sans mt-1">
                                            {featuredPost.data.description}
                                        </p>
                                    </div>
                                </a>
                            </article>
                        </div>
                    )}

                    <div class="lg:col-span-4 flex flex-col gap-6">
                        <QuoteOfTheDay />
                        
                        <PollBaner />
                    </div>
                </div>

                {bottomRowPosts.length > 0 && (
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 pb-4">
                        {bottomRowPosts.map((post) => (
                            <article class="group">
                                <a href={getPostUrl(post.slug)} class="no-underline text-inherit flex flex-col h-full">
                                    <div class="relative w-full aspect-[16/10] overflow-hidden rounded-md shadow-sm mb-3 bg-slate-100">
                                        {post.data.heroImage && (
                                            <Image src={post.data.heroImage} alt={post.data.title} width={300} height={187} class="w-full h-full object-cover" />
                                        )}
                                    </div>
                                    <div class="flex flex-col gap-1.5">
                                        <div class="text-[10px] font-bold text-[#DC2626] uppercase tracking-widest">
                                            {post.data.tags && post.data.tags.length > 0 ? getDisplayTag(post.data.tags[0]) : 'LAJM'}
                                        </div>
                                        <h3 class="text-base font-serif font-bold text-slate-800 leading-snug group-hover:underline decoration-2 underline-offset-4 transition-colors line-clamp-3">
                                            {post.data.title}
                                        </h3>
                                    </div>
                                </a>
                            </article>
                        ))}
                    </div>
                )}

            </main>
        </div>

       <div class="flex items-center gap-6 mt-10 mb-16 w-full">
    <div class="flex-1 h-[1px] bg-slate-200"></div>
    <a href="/te-fundit" 
        class="mr-8 md:mr-12 shrink-0 inline-flex items-center justify-center gap-2 bg-[#0f172a] text-white hover:bg-[#DC2626] px-4 py-3 rounded-full font-black uppercase tracking-widest text-[11px] transition-all duration-300 shadow-md hover:-translate-y-0.5">
        Shiko të gjitha 
        <span class="text-base leading-none">&rarr;</span>
    </a>
</div>

        <CategorySection categoryTag="politike" sectionTitle="Politikë" />

        <section class="w-full bg-white py-20 px-4 md:px-8">
            <div class="max-w-[1300px] mx-auto">
                <div class="flex items-center gap-4 mb-10">
                    <span class="bg-[#0f172a] text-white text-[12px] font-black uppercase tracking-widest px-4 py-2 rounded-full shadow-sm">
                        Më të injoruarat
                    </span>
                    <div class="h-[1px] flex-1 bg-slate-200"></div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 md:gap-10">
                    {ignoredPosts.map((post, index) => (
                        <article class="group">
                            <a href={getPostUrl(post.slug)} class="no-underline text-inherit flex flex-col h-full">
                                <div class="relative w-full aspect-[16/10] overflow-hidden rounded-md shadow-sm mb-3 bg-slate-100">
                                    {post.data.heroImage && (
                                        <Image src={post.data.heroImage} alt={post.data.title} width={400} height={250} class="w-full h-full object-cover" />
                                    )}
                                    <div class="absolute top-0 left-0 bg-[#DC2626] text-white text-[10px] font-black px-2 py-1 rounded-br-md z-10 shadow-sm">
                                        #{index + 1}
                                    </div>
                                </div>
                                <h4 class="font-serif font-bold text-base text-slate-800 leading-snug group-hover:underline decoration-2 underline-offset-4 transition-colors">
                                    {post.data.title}
                                </h4>
                            </a>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        <CategorySection categoryTag="ekonomi" sectionTitle="Ekonomi" />

        <HoroscopeWidget />

        <CategorySection categoryTag="sociale" sectionTitle="Sociale" />

        <EditorsPick/>

        <Footer />
    </body>
</html>