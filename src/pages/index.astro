---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import '../app.css'; // <--- KJO ËSHTË ZEMRA E TAILWIND (Mos e fshi!)

// --- CHANGE 1: Added .slice(0, 6) to limit to 6 posts ---
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
).slice(0, 6);

const tagNames = {
   'politike': 'Politikë',
	'ekonomi': 'Ekonomi',
	'showbiz': 'Showbiz',
	'sport': 'Sport',
	'kulture': 'Kulturë',
	'kronike': 'Kronikë',
	'sociale': 'Sociale',
	'tekno-shkence': 'Tekno & Shkencë',
	'shendeti': 'Shëndeti',
	'rajoni': 'Rajoni',
	'bota': 'Bota'
};
---

<!doctype html>
<html lang="sq">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="font-sans m-0 p-0 box-border bg-gray-50 text-gray-900">
		<Header />
		
		<section class="relative bg-[#23272F] text-white grid grid-cols-1 lg:grid-cols-2 min-h-[600px] overflow-hidden mb-16 items-center">
			
			<div class="relative p-10 md:p-20 flex flex-col justify-center z-20 order-2 lg:order-1 text-center lg:text-left">
				
				<div class="bg-[#DC2626] text-white px-4 py-1.5 uppercase font-black text-sm tracking-wider w-fit mb-8 rounded mx-auto lg:mx-0">
					EKSKLUZIVE
				</div>
				
				<h1 class="text-6xl md:text-8xl font-black leading-[0.9] mb-8 uppercase text-white">
					<span class="text-white block">TË PARËT</span>
					<span class="text-[#6B7280] block">TE RRENA</span>
				</h1>
				
				<p class="text-2xl text-[#D1D5DB] mb-10 max-w-2xl mx-auto lg:mx-0 leading-relaxed font-normal">
					Gazetaria investigative që gërmon 
					<span class="text-[#DC2626] font-bold">aty ku nuk ka asgjë</span> 
					për të gjetur.
				</p>
				
				<div class="flex gap-4 items-start mb-14 mx-auto lg:mx-0 max-w-md">
					<p class="border-l-[6px] border-[#DC2626] pl-6 italic text-xl text-[#9CA3AF] md:text-left font-light">
						"Nëse është e vërtetë, ndoshta nuk e keni lexuar tek ne."
					</p>
				</div>
				
				<div class="flex flex-col sm:flex-row gap-5 justify-center lg:justify-start">
					
					<a href="/te-fundit" class="bg-[#DC2626] hover:bg-[#B91C1C] !text-white px-8 py-4 font-black uppercase tracking-wider rounded text-lg transition-transform hover:-translate-y-1 text-center inline-flex items-center justify-center shadow-lg">
						RRENAT E FUNDIT
					</a>
					
					<a href="/about" class="bg-[#374151] hover:bg-[#4B5563] !text-white border-2 border-[#4B5563] px-8 py-4 font-black uppercase tracking-wider rounded text-lg transition-transform hover:-translate-y-1 text-center inline-flex items-center justify-center shadow-lg">
						RRETH NESH
					</a>
				</div>
			</div>

			<div class="relative w-full h-[450px] lg:h-full min-h-[450px] order-1 lg:order-2">
				<img 
					src="/hero-man.jpg" 
					alt="Lemza News Hero" 
					class="w-full h-full object-cover [mask-image:linear-gradient(to_top,transparent,black_30%)] lg:[mask-image:linear-gradient(to_right,transparent,black_10%,black_90%)]" 
				/>
			</div>
		</section>

		<main class="w-[1200px] max-w-[95%] mx-auto px-4 mb-24 -mt-10 relative z-30">
			
			<div class="flex justify-between items-end mb-10 border-b-2 border-gray-200 pb-4">
				<h2 class="text-4xl font-black text-gray-900 m-0 leading-none uppercase tracking-tight">
					Rrenat e <span class="text-[#DC2626]">Fundit</span>
				</h2>
				<a href="/te-fundit" class="group text-gray-500 hover:text-[#DC2626] no-underline font-bold text-sm flex items-center gap-2 uppercase transition-colors">
					Shiko të gjitha
					<span class="bg-gray-200 group-hover:bg-[#DC2626] group-hover:text-white rounded-full p-1 transition-all">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
					</span>
				</a>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
				{posts.map((post) => {
					return (
					<article class="bg-white rounded-2xl overflow-hidden flex flex-col hover:-translate-y-2 hover:shadow-2xl hover:shadow-red-900/10 transition-all duration-300 group border border-gray-100">
						<a href={`/te-fundit/${post.id}/`} class="no-underline text-inherit h-full flex flex-col">
							
							<div class="relative h-60 w-full overflow-hidden">
								<div class="absolute top-4 left-4 z-20 flex flex-wrap gap-1">
									{post.data.tags && post.data.tags.length > 0 ? (
										post.data.tags.slice(0, 1).map((t) => (
											<span class="bg-[#DC2626] text-white px-3 py-1 text-[11px] font-black uppercase tracking-wider rounded shadow-md">
												{(tagNames as any)[t] || t}
											</span>
										))
									) : (
										<span class="bg-[#DC2626] text-white px-3 py-1 text-[11px] font-black uppercase tracking-wider rounded shadow-md">LAJME</span>
									)}
								</div>

								{post.data.heroImage ? (
									<img src={post.data.heroImage} alt="" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-in-out" />
								) : (
									<div class="w-full h-full bg-gray-200 flex items-center justify-center text-gray-400">
										<span class="font-bold text-sm">PA FOTO</span>
									</div>
								)}
								
								<div class="absolute bottom-0 left-0 w-full h-1/3 bg-gradient-to-t from-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
							</div>

							<div class="p-7 flex flex-col flex-grow relative">
								<div class="flex items-center gap-2 text-xs font-bold text-gray-400 mb-4 uppercase tracking-wide">
									<span class="text-[#DC2626]">•</span>
									<FormattedDate date={post.data.pubDate} />
								</div>

								<h3 class="text-2xl font-black text-gray-900 mb-3 leading-tight group-hover:text-[#DC2626] transition-colors">
									{post.data.title}
								</h3>
								
								<p class="text-sm text-gray-600 leading-relaxed mb-6 line-clamp-3 font-medium">
									{post.data.description || "Klikoni për të lexuar lajmin e plotë..."}
								</p>
								
								<div class="mt-auto border-t border-gray-100 pt-4 flex items-center justify-between">
									<span class="text-gray-900 font-extrabold text-xs uppercase group-hover:translate-x-1 transition-transform duration-300">
										Lexo Artikullin
									</span>
									<span class="text-[#DC2626] opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300">
										<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
									</span>
								</div>
							</div>
						</a>
					</article>
				)})}
			</div>
		</main>
		<Footer />
	</body>
</html>