---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Hero from '../components/home/Hero.astro';
import QuoteOfTheDay from '../components/QuoteOfTheDay.astro'; 
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { Image } from 'astro:assets';
import '../app.css';
import HoroscopeWidget from '../components/HoroscopeWidget.astro';
import { getDisplayTag, getPostUrl } from '../utils/helpers';
import PollBaner from '../components/PollBaner.astro';
import EditorsPick from '../components/EditorsPick.astro';
import MostIgnored from '../components/MostIgnored.astro'; // Sigurohu që importi është i saktë

const allPosts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Ndajmë lajmet sipas logjikës së re
const middlePost = allPosts[1]; // Lajmi i dytë pas Hero-s
const leftPosts = allPosts.slice(2, 4); // Lajmet 3 dhe 4
const rightPosts = allPosts.slice(4, 6); // Lajmet 5 dhe 6
---

<!doctype html>
<html lang="sq">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
        <style>
            html, body {
                margin: 0;
                padding: 0;
                background-color: #ffffff;
                color: #1e293b;
                scroll-behavior: smooth;
            }
            .news-container {
                padding-top: 3rem; 
            }
        </style>
    </head>
    <body>
        
        <Header />
        <Hero />

        <div class="news-container mb-12">
            <main class="w-full max-w-[1300px] mx-auto px-4 md:px-8 flex flex-col gap-10">
                
                {/* SEKSIONI 1: Tre Kolonat e Lajmeve */}
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8">
                    
                    {/* KOLONA E MAJTË (2 lajme) - Në celular del e dyta */}
                    <div class="order-2 lg:order-1 lg:col-span-3 flex flex-col gap-5 lg:gap-8">
                        {leftPosts.map((post) => (
                            <article class="group">
                                <a href={getPostUrl(post.slug)} class="no-underline text-inherit flex flex-row lg:flex-col gap-4 lg:gap-3 h-full items-center lg:items-start">
                                    <div class="relative w-[110px] lg:w-full shrink-0 aspect-[4/3] lg:aspect-[16/10] overflow-hidden rounded-md shadow-sm bg-slate-100">
                                        {post.data.heroImage && (
                                            <Image src={post.data.heroImage} alt={post.data.title} width={300} height={187} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                                        )}
                                    </div>
                                    <div class="flex flex-col gap-1 lg:gap-1.5 flex-1 py-1 lg:py-0">
                                        <div class="text-[10px] font-bold text-[#DC2626] uppercase tracking-widest leading-none mb-0.5">
                                            {post.data.tags && post.data.tags.length > 0 ? getDisplayTag(post.data.tags[0]) : 'LAJM'}
                                        </div>
                                        <h3 class="text-[14px] lg:text-[17px] font-serif font-black tracking-tight text-slate-800 leading-snug group-hover:underline decoration-2 underline-offset-4 transition-colors line-clamp-3">
                                            {post.data.title}
                                        </h3>
                                    </div>
                                </a>
                            </article>
                        ))}
                    </div>

                    {/* KOLONA E MESIT (Lajmi i madh) - Në celular del i pari */}
                    <div class="order-1 lg:order-2 lg:col-span-6 mb-4 lg:mb-0">
                        {middlePost && (
                            <article class="group relative flex flex-col h-full border-b lg:border-none border-slate-200 pb-6 lg:pb-0">
                                <a href={getPostUrl(middlePost.slug)} class="no-underline text-inherit flex flex-col h-full">
                                    <div class="relative w-full aspect-[16/10] overflow-hidden rounded-xl shadow-sm mb-4 lg:mb-5 bg-slate-100 shrink-0">
                                        {middlePost.data.heroImage && (
                                            <Image src={middlePost.data.heroImage} alt={middlePost.data.title} width={800} height={500} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                                        )}
                                        <div class="absolute top-3 left-3 z-10">
                                            <span class="bg-[#DC2626] text-white text-[10px] md:text-[11px] font-black uppercase tracking-widest px-3 py-1.5 rounded-sm shadow-md">
                                                {middlePost.data.tags && middlePost.data.tags.length > 0 ? getDisplayTag(middlePost.data.tags[0]) : 'FOKUS'}
                                            </span>
                                        </div>
                                    </div>
                                    <div class="flex flex-col gap-2 flex-1">
                                        <div class="text-[10px] font-bold text-[#DC2626] uppercase tracking-widest leading-none">
                                            <FormattedDate date={middlePost.data.pubDate} />
                                        </div>
                                        <h3 class="text-2xl md:text-3xl lg:text-4xl font-serif font-black text-slate-900 leading-tight group-hover:text-[#0f172a] group-hover:underline decoration-4 underline-offset-8 transition-all">
                                            {middlePost.data.title}
                                        </h3>
                                        <p class="text-sm md:text-base text-slate-600 leading-relaxed font-sans mt-1 line-clamp-3 md:line-clamp-4">
                                            {middlePost.data.description}
                                        </p>
                                    </div>
                                </a>
                            </article>
                        )}
                    </div>

                    {/* KOLONA E DJATHTË (2 lajme) - Në celular del e treta */}
                    <div class="order-3 lg:order-3 lg:col-span-3 flex flex-col gap-5 lg:gap-8 border-t lg:border-none border-slate-200 pt-6 lg:pt-0">
                        {rightPosts.map((post) => (
                            <article class="group">
                                <a href={getPostUrl(post.slug)} class="no-underline text-inherit flex flex-row lg:flex-col gap-4 lg:gap-3 h-full items-center lg:items-start">
                                    <div class="relative w-[110px] lg:w-full shrink-0 aspect-[4/3] lg:aspect-[16/10] overflow-hidden rounded-md shadow-sm bg-slate-100">
                                        {post.data.heroImage && (
                                            <Image src={post.data.heroImage} alt={post.data.title} width={300} height={187} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                                        )}
                                    </div>
                                    <div class="flex flex-col gap-1 lg:gap-1.5 flex-1 py-1 lg:py-0">
                                        <div class="text-[10px] font-bold text-[#DC2626] uppercase tracking-widest leading-none mb-0.5">
                                            {post.data.tags && post.data.tags.length > 0 ? getDisplayTag(post.data.tags[0]) : 'LAJM'}
                                        </div>
                                        <h3 class="text-[14px] lg:text-[17px] font-serif font-bold text-slate-800 leading-snug group-hover:underline decoration-2 underline-offset-4 transition-colors line-clamp-3">
                                            {post.data.title}
                                        </h3>
                                    </div>
                                </a>
                            </article>
                        ))}
                    </div>

                </div>

                <div class="w-full h-[1px] bg-slate-200 my-2 lg:my-6"></div>

                {/* SEKSIONI 2: Dy Kolona asimetrike */}
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
                    
                    {/* E Majta: Më të Injoruarat */}
                    <div class="lg:col-span-8 flex flex-col">
                        <MostIgnored />
                    </div>

                    {/* E Djathta: Widget-et */}
                    <div class="lg:col-span-4 flex flex-col gap-8">
                        <QuoteOfTheDay />
                        <PollBaner />
                        <HoroscopeWidget />
                    </div>

                </div>

            </main>
        </div>

        <EditorsPick/>

        <Footer />
    </body>
</html>