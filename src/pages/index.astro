---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Hero from '../components/home/Hero.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { Image } from 'astro:assets';
import '../app.css';
import { getDisplayTag, getPostUrl } from '../utils/helpers';
import EditorsPick from '../components/EditorsPick.astro';
import horoscopeData from '../data/horoscope.json';

// ==========================================
// LOGJIKA KRYESORE (GJITHÇKA NË NJË VEND)
// ==========================================
const allPosts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 1. Lajmet për Gridin Kryesor
const featuredPost = allPosts[1]; 
const middlePosts = allPosts.slice(2, 5); 
const rightPosts = allPosts.slice(5, 8); 

// 2. Logjika për 'Më të injoruarat' (Merr 7 lajme për bllokun e ri)
const ignoredPosts = allPosts.slice(10).sort(() => 0.5 - Math.random()).slice(0, 7);
const ignoredFeatured = ignoredPosts[0]; // Lajmi i madh (1/3)
const ignoredMiddle = ignoredPosts.slice(1, 4); // 3 lajmet e mesit
const ignoredRight = ignoredPosts.slice(4, 7); // 3 lajmet e djathta

// 3. Logjika për 'Thënien e Ditës'
const quotePost = allPosts.find(post => post.data.quoteOfTheDay);
const quoteText = quotePost?.data.quoteOfTheDay || "Sot të gjithë heshtën. Ose po gënjejnë në heshtje.";
const quoteUrl = quotePost ? getPostUrl(quotePost.slug || "") : "/";

// 4. Logjika për 'Horoskopin'
const allHoroscopes = horoscopeData.predictions;
const getZodiacSymbol = (signName: string) => {
    const symbols: Record<string, string> = {
        "dashi": "♈", "demi": "♉", "binjakët": "♊", "binjaket": "♊",
        "gaforrja": "♋", "luani": "♌", "virgjëresha": "♍", "virgjeresha": "♍",
        "peshorja": "♎", "akrepi": "♏", "shigjetari": "♐", "bricjapi": "♑",
        "ujori": "♒", "peshqit": "♓"
    };
    return symbols[signName.toLowerCase()] || "✨";
};
const randomSign = allHoroscopes[Math.floor(Math.random() * allHoroscopes.length)];
const symbol = getZodiacSymbol(randomSign.sign);
// ==========================================
---

<!doctype html>
<html lang="sq">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
        <style>
            html, body {
                margin: 0;
                padding: 0;
                background-color: #ffffff;
                color: #000000;
                scroll-behavior: smooth;
            }
        </style>
    </head>
    <body>
        
        <Header />
        
        {/* MOBILE: LAJMI 1 I MADH */}
        <Hero /> 

        <div class="w-full max-w-[1250px] mx-auto px-4 md:px-8 mt-12 mb-12">

            {/* HEADER I SEKSIONIT 1 */}
            <div class="flex items-center gap-4 mb-6">
                <h2 class="text-base md:text-lg font-normal font-sans text-black tracking-tight uppercase shrink-0 m-0">
                    Lajmet e Fundit
                </h2>
                
                <div class="flex-1 h-[1px] bg-slate-500 mt-1"></div>
                
               <a href="/te-fundit" class="shrink-0 bg-white text-black border border-slate-300 hover:bg-[#DC2626] hover:text-white hover:border-[#DC2626] px-3 md:px-4 py-1.5 md:py-2.5 rounded-full text-[10px] md:text-xs font-bold font-serif uppercase tracking-widest transition-all duration-300 flex items-center gap-1 shadow-sm">
                    Shiko të gjitha <span class="text-sm leading-none">&rarr;</span>
                </a>
            </div>

            {/* BLLOKU EDITORIAL 1 */}
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-y-10 border-b border-black pb-8">

                {/* MOBILE: LAJMI 2 I MADH */}
                <div class="lg:col-span-4 flex flex-col lg:pr-5 lg:border-r lg:border-slate-300">
                    {featuredPost && (
                        <article class="group flex flex-col">
                            <a href={getPostUrl(featuredPost.slug)} class="no-underline text-inherit flex flex-col h-full">
                                <div class="w-full aspect-[16/9] overflow-hidden bg-slate-100 mb-3 rounded-sm">
                                    {featuredPost.data.heroImage && (
                                        <Image src={featuredPost.data.heroImage} alt={featuredPost.data.title} width={600} height={337} class="w-full h-full object-cover group-hover:opacity-90 transition-opacity" />
                                    )}
                                </div>
                                
                                <div class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1.5 flex items-center gap-1.5 font-sans">
                                    <span class="text-[#b91c1c]">
                                        {featuredPost.data.tags && featuredPost.data.tags.length > 0 ? getDisplayTag(featuredPost.data.tags[0]) : 'FOKUS'}
                                    </span>
                                    <span>&bull;</span>
                                    <FormattedDate date={featuredPost.data.pubDate} />
                                </div>

                                <h3 class="text-xl lg:text-[18px] font-serif font-bold text-black leading-tight mb-2 group-hover:text-slate-600 transition-colors">
                                    {featuredPost.data.title}
                                </h3>
                                
                                <p class="text-[13px] md:text-[14px] font-serif text-slate-700 leading-snug line-clamp-2">
                                    {featuredPost.data.description}
                                </p>
                            </a>
                        </article>
                    )}
                </div>

                {/* MOBILE: LISTA E LAJMEVE */}
                <div class="lg:col-span-4 flex flex-col lg:px-5 lg:border-r lg:border-slate-300 gap-5">
                    {middlePosts.map((post) => (
                        <article class="group">
                            <a href={getPostUrl(post.slug)} class="no-underline text-inherit flex items-start gap-4">
                                <div class="shrink-0 w-[110px] lg:w-[120px] aspect-[4/3] overflow-hidden bg-slate-100 rounded-sm">
                                    {post.data.heroImage && (
                                        <Image src={post.data.heroImage} alt={post.data.title} width={300} height={225} class="w-full h-full object-cover group-hover:opacity-90 transition-opacity" />
                                    )}
                                </div>
                                <div class="flex flex-col flex-1">
                                    <div class="text-[9px] font-bold text-slate-500 uppercase tracking-wider mb-1 font-sans flex items-center gap-1.5 flex-wrap">
                                        <span class="text-[#b91c1c]">
                                            {post.data.tags && post.data.tags.length > 0 ? getDisplayTag(post.data.tags[0]) : 'LAJM'}
                                        </span>
                                    </div>
                                    <h3 class="font-serif text-[14px] lg:text-[14px] font-bold text-black leading-snug group-hover:underline decoration-1 underline-offset-2 transition-colors">
                                        {post.data.title}
                                    </h3>
                                </div>
                            </a>
                        </article>
                    ))}
                </div>

                {/* MOBILE: LISTA E LAJMEVE */}
                <div class="lg:col-span-4 flex flex-col lg:pl-5 gap-5">
                    {rightPosts.map((post) => (
                        <article class="group">
                            <a href={getPostUrl(post.slug)} class="no-underline text-inherit flex items-start gap-4">
                                <div class="shrink-0 w-[110px] lg:w-[120px] aspect-[4/3] overflow-hidden bg-slate-100 rounded-sm">
                                    {post.data.heroImage && (
                                        <Image src={post.data.heroImage} alt={post.data.title} width={300} height={225} class="w-full h-full object-cover group-hover:opacity-90 transition-opacity" />
                                    )}
                                </div>
                                <div class="flex flex-col flex-1">
                                    <div class="text-[9px] font-bold text-slate-500 uppercase tracking-wider mb-1 font-sans flex items-center gap-1.5 flex-wrap">
                                        <span class="text-[#b91c1c]">
                                            {post.data.tags && post.data.tags.length > 0 ? getDisplayTag(post.data.tags[0]) : 'LAJM'}
                                        </span>
                                    </div>
                                    <h3 class="font-serif text-[14px] lg:text-[14px] font-bold text-black leading-snug group-hover:underline decoration-1 underline-offset-2 transition-colors">
                                        {post.data.title}
                                    </h3>
                                </div>
                            </a>
                        </article>
                    ))}
                </div>

            </div>

            {/* SEKSIONI I EDITORIALEVE TË VOGLA */}
            <div class="grid grid-cols-1 md:grid-cols-3 gap-x-8 gap-y-10 pt-8 pb-4">
                
                {/* 1. THËNIA E DITËS */}
                <div class="flex flex-col lg:border-r lg:border-slate-300 lg:pr-8 h-full">
                    <h4 class="font-sans font-bold text-[11px] tracking-[0.15em] uppercase border-b border-black pb-1.5 mb-5 text-slate-900">
                        Thënia e Ditës
                    </h4>
                    <p class="font-serif italic text-lg md:text-xl text-slate-800 leading-relaxed">
                        "{quoteText}"
                    </p>
                    <a href={quoteUrl} class="mt-8 w-max bg-white text-black border border-slate-200 hover:bg-[#DC2626] hover:text-white hover:border-[#DC2626] px-3 md:px-4 py-1.5 rounded-full text-[10px] font-bold font-sans uppercase tracking-widest transition-all duration-300 inline-flex items-center gap-1 shadow-sm">
                        Lexo më shumë <span class="text-sm leading-none">&rarr;</span>
                    </a>
                </div>

                {/* 2. HOROSKOPI */}
                <div class="flex flex-col lg:border-r lg:border-slate-300 lg:pr-8 h-full">
                    <h4 class="font-sans font-bold text-[11px] tracking-[0.15em] uppercase border-b border-black pb-1.5 mb-5 text-slate-900">
                        Horoskopi
                    </h4>
                    <div class="flex items-center gap-2 mb-3">
                        <span class="text-2xl leading-none">{symbol}</span>
                        <span class="font-serif font-bold text-xl capitalize text-black">{randomSign.sign}</span>
                    </div>
                    <p class="font-serif text-[15px] md:text-[16px] text-slate-700 leading-snug">
                        "{randomSign.text}"
                    </p>
                </div>

                {/* 3. SONDAZHI */}
                <div class="flex flex-col h-full">
                    <h4 class="font-sans font-bold text-[11px] tracking-[0.15em] uppercase border-b border-black pb-1.5 mb-5 text-slate-900">
                        Sondazhi
                    </h4>
                    <a href="/sondazh" class="block group no-underline flex flex-col h-full">
                        <h3 class="font-serif font-bold text-xl md:text-2xl text-black group-hover:text-[#b91c1c] transition-colors mb-2">
                            A ka rëndësi zëri yt?
                        </h3>
                        <p class="font-serif text-[15px] md:text-[16px] text-slate-700 leading-snug">
                            Shpreh mendimin tënd në sondazhin e kësaj jave. Çdo votë numërohet dhe rezultatet publikohen çdo të premte.
                        </p>
                       <span class="mt-8 w-max bg-white text-black border border-slate-200 group-hover:bg-[#DC2626] group-hover:text-white group-hover:border-[#DC2626] px-3 md:px-4 py-1.5 rounded-full text-[10px] font-black font-serif uppercase tracking-widest transition-all duration-300 inline-flex items-center gap-1 shadow-sm">
                            Voto Tani <span class="text-sm leading-none">&rarr;</span>
                        </span>
                    </a>
                </div>

            </div>

            {/* HEADER I SEKSIONIT TË INJORUARA */}
            <div class="flex items-center gap-4 mb-6 mt-10">
                <h2 class="text-base md:text-lg font-normal font-sans text-black tracking-tight uppercase shrink-0 m-0">
                    Më të injoruarat
                </h2>
                <div class="flex-1 h-[1px] bg-slate-500 mt-1"></div>
            </div>

            {/* BLLOKU EDITORIAL 2: MË TË INJORUARAT */}
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-y-10 pb-4">

                {/* LAJMI I MADH (Majtas) */}
                <div class="lg:col-span-4 flex flex-col lg:pr-5 lg:border-r lg:border-slate-300">
                    {ignoredFeatured && (
                        <article class="group flex flex-col">
                            <a href={getPostUrl(ignoredFeatured.slug)} class="no-underline text-inherit flex flex-col h-full">
                                <div class="w-full aspect-[16/9] overflow-hidden bg-slate-100 mb-3 rounded-sm">
                                    {ignoredFeatured.data.heroImage && (
                                        <Image src={ignoredFeatured.data.heroImage} alt={ignoredFeatured.data.title} width={600} height={337} class="w-full h-full object-cover group-hover:opacity-90 transition-opacity" />
                                    )}
                                </div>
                                
                                <div class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1.5 flex items-center gap-1.5 font-sans">
                                    <span class="text-[#b91c1c]">
                                        {ignoredFeatured.data.tags && ignoredFeatured.data.tags.length > 0 ? getDisplayTag(ignoredFeatured.data.tags[0]) : 'FOKUS'}
                                    </span>
                                    <span>&bull;</span>
                                    <FormattedDate date={ignoredFeatured.data.pubDate} />
                                </div>

                                <h3 class="text-xl lg:text-[18px] font-serif font-bold text-black leading-tight mb-2 group-hover:text-slate-600 transition-colors">
                                    {ignoredFeatured.data.title}
                                </h3>
                                
                                <p class="text-[13px] md:text-[14px] font-serif text-slate-700 leading-snug line-clamp-2">
                                    {ignoredFeatured.data.description}
                                </p>
                            </a>
                        </article>
                    )}
                </div>

                {/* KOLONA E MESIT (3 Lajme) */}
                <div class="lg:col-span-4 flex flex-col lg:px-5 lg:border-r lg:border-slate-300 gap-5">
                    {ignoredMiddle.map((post) => (
                        <article class="group">
                            <a href={getPostUrl(post.slug)} class="no-underline text-inherit flex items-start gap-4">
                                <div class="shrink-0 w-[110px] lg:w-[120px] aspect-[4/3] overflow-hidden bg-slate-100 rounded-sm">
                                    {post.data.heroImage && (
                                        <Image src={post.data.heroImage} alt={post.data.title} width={300} height={225} class="w-full h-full object-cover group-hover:opacity-90 transition-opacity" />
                                    )}
                                </div>
                                <div class="flex flex-col flex-1">
                                    <div class="text-[9px] font-bold text-slate-500 uppercase tracking-wider mb-1 font-sans flex items-center gap-1.5 flex-wrap">
                                        <span class="text-[#b91c1c]">
                                            {post.data.tags && post.data.tags.length > 0 ? getDisplayTag(post.data.tags[0]) : 'LAJM'}
                                        </span>
                                    </div>
                                    <h3 class="font-serif text-[14px] lg:text-[14px] font-bold text-black leading-snug group-hover:underline decoration-1 underline-offset-2 transition-colors">
                                        {post.data.title}
                                    </h3>
                                </div>
                            </a>
                        </article>
                    ))}
                </div>

                {/* KOLONA E DJATHTË (3 Lajme) */}
                <div class="lg:col-span-4 flex flex-col lg:pl-5 gap-5">
                    {ignoredRight.map((post) => (
                        <article class="group">
                            <a href={getPostUrl(post.slug)} class="no-underline text-inherit flex items-start gap-4">
                                <div class="shrink-0 w-[110px] lg:w-[120px] aspect-[4/3] overflow-hidden bg-slate-100 rounded-sm">
                                    {post.data.heroImage && (
                                        <Image src={post.data.heroImage} alt={post.data.title} width={300} height={225} class="w-full h-full object-cover group-hover:opacity-90 transition-opacity" />
                                    )}
                                </div>
                                <div class="flex flex-col flex-1">
                                    <div class="text-[9px] font-bold text-slate-500 uppercase tracking-wider mb-1 font-sans flex items-center gap-1.5 flex-wrap">
                                        <span class="text-[#b91c1c]">
                                            {post.data.tags && post.data.tags.length > 0 ? getDisplayTag(post.data.tags[0]) : 'LAJM'}
                                        </span>
                                    </div>
                                    <h3 class="font-serif text-[14px] lg:text-[14px] font-bold text-black leading-snug group-hover:underline decoration-1 underline-offset-2 transition-colors">
                                        {post.data.title}
                                    </h3>
                                </div>
                            </a>
                        </article>
                    ))}
                </div>

            </div>

        </div>

        <EditorsPick/>

        <Footer />
    </body>
</html>