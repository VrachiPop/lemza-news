---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Hero from '../components/home/Hero.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { Image } from 'astro:assets';
import '../app.css';
import { getDisplayTag, getPostUrl } from '../utils/helpers';
import EditorsPick from '../components/EditorsPick.astro';
import horoscopeData from '../data/horoscope.json';

// ==========================================
// LOGJIKA KRYESORE SERVER-SIDE
// ==========================================
const allPosts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredPost = allPosts[1]; 
const middlePosts = allPosts.slice(2, 5); 
const rightPosts = allPosts.slice(5, 8); 

const poolForIgnored = allPosts.slice(10, 25).map(post => ({
    title: post.data.title,
    slug: getPostUrl(post.slug),
    heroImage: post.data.heroImage ? post.data.heroImage.src : '', 
    date: post.data.pubDate,
    tag: post.data.tags && post.data.tags.length > 0 ? getDisplayTag(post.data.tags[0]) : 'LAJM',
    description: post.data.description
}));

const quotePost = allPosts.find(post => post.data.quoteOfTheDay);
const quoteText = quotePost?.data.quoteOfTheDay || "Sot të gjithë heshtën. Ose po gënjejnë në heshtje.";
const quoteUrl = quotePost ? getPostUrl(quotePost.slug || "") : "/";

const allHoroscopes = horoscopeData.predictions;
---

<!doctype html>
<html lang="sq">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
        <style>
            html, body {
                margin: 0;
                padding: 0;
                background-color: #ffffff;
                color: #000000;
                scroll-behavior: smooth;
            }
        </style>
    </head>
    <body>
        
        <Header />
        <Hero /> 

        {/* px-0 në mobile mbyll margjinat e jashtme plotësisht */}
        <div class="w-full max-w-[1250px] mx-auto px-0 md:px-8 mt-8 md:mt-12 mb-12">

            {/* HEADER I SEKSIONIT 1 (I dhashë px-4 që teksti të mos preki cepin) */}
            <div class="flex items-center gap-3 md:gap-4 mb-4 md:mb-6 px-4 md:px-0">
                <h2 class="text-[16px] md:text-lg font-normal font-sans text-black tracking-tight uppercase shrink-0 m-0">
                    Lajmet e Fundit
                </h2>
                
                <div class="flex-1 h-[1px] bg-slate-500 mt-1"></div>
                
                {/* Butoni Plain Text (Asnjë Pill, shumë elegant) */}
               <a href="/te-fundit" class="shrink-0 text-[11px] md:text-xs font-bold font-sans uppercase tracking-widest text-slate-500 hover:text-black transition-colors flex items-center gap-1">
                    Shiko të gjitha <span class="text-sm leading-none">&rarr;</span>
                </a>
            </div>

            {/* BLLOKU EDITORIAL 1 */}
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-y-6 md:gap-y-10 border-b border-black pb-6 md:pb-8">

                {/* LAJMI I MADH */}
                <div class="lg:col-span-4 flex flex-col lg:pr-5 lg:border-r lg:border-slate-300">
                    <article class="group flex flex-col">
                        <a href={getPostUrl(featuredPost?.slug || '')} class="no-underline text-inherit flex flex-col h-full">
                            {/* Imazhi prek skajet në mobile (rounded-none) */}
                            <div class="w-full aspect-[16/9] overflow-hidden bg-slate-100 mb-3 rounded-none md:rounded-sm">
                                {featuredPost?.data.heroImage && (
                                    <Image src={featuredPost.data.heroImage} alt={featuredPost.data.title} width={600} height={337} class="w-full h-full object-cover group-hover:opacity-90 transition-opacity" />
                                )}
                            </div>
                            
                            {/* Teksti i mbrojtur me px-4 në mobile */}
                            <div class="px-4 md:px-0 flex flex-col">
                                <div class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1.5 flex items-center gap-1.5 font-sans">
                                    <span class="text-[#b91c1c]">
                                        {featuredPost?.data.tags && featuredPost.data.tags.length > 0 ? getDisplayTag(featuredPost.data.tags[0]) : 'FOKUS'}
                                    </span>
                                    <span>&bull;</span>
                                    {featuredPost && <FormattedDate date={featuredPost.data.pubDate} />}
                                </div>

                                <h3 class="text-[18px] md:text-[20px] font-serif font-bold text-black leading-tight mb-2 group-hover:text-slate-600 transition-colors">
                                    {featuredPost?.data.title}
                                </h3>
                                
                                <p class="text-[14px] font-serif text-slate-700 leading-snug line-clamp-2">
                                    {featuredPost?.data.description}
                                </p>
                            </div>
                        </a>
                    </article>
                </div>

                {/* KOLONA E MESIT (Lista Mobile) */}
                <div class="lg:col-span-4 flex flex-col lg:px-5 lg:border-r lg:border-slate-300 gap-5 px-4 md:px-0 mt-2 md:mt-0">
                    {middlePosts.map((post) => (
                        <article class="group">
                            <a href={getPostUrl(post.slug)} class="no-underline text-inherit flex items-start gap-4">
                                {/* Thumbnails më të vegjël: 85px */}
                                <div class="shrink-0 w-[100px] md:w-[120px] aspect-[4/3] overflow-hidden bg-slate-100 rounded-sm">
                                    {post.data.heroImage && (
                                        <Image src={post.data.heroImage} alt={post.data.title} width={300} height={225} class="w-full h-full object-cover group-hover:opacity-90 transition-opacity" />
                                    )}
                                </div>
                                <div class="flex flex-col flex-1">
                                    <div class="text-[9px] font-bold text-[#b91c1c] uppercase tracking-wider mb-1 font-sans">
                                        {post.data.tags && post.data.tags.length > 0 ? getDisplayTag(post.data.tags[0]) : 'LAJM'}
                                    </div>
                                    {/* Titujt më të vegjël dhe kompaktë */}
                                    <h3 class="font-serif text-[14px] md:text-[15px] font-bold text-black leading-snug group-hover:underline decoration-1 underline-offset-2 transition-colors">
                                        {post.data.title}
                                    </h3>
                                </div>
                            </a>
                        </article>
                    ))}
                </div>

                {/* KOLONA E DJATHTË (Lista Mobile) */}
                <div class="lg:col-span-4 flex flex-col lg:pl-5 gap-5 px-4 md:px-0 mt-1 md:mt-0">
                    {rightPosts.map((post) => (
                        <article class="group">
                            <a href={getPostUrl(post.slug)} class="no-underline text-inherit flex items-start gap-4">
                                <div class="shrink-0 w-[85px] md:w-[120px] aspect-[4/3] overflow-hidden bg-slate-100 rounded-sm">
                                    {post.data.heroImage && (
                                        <Image src={post.data.heroImage} alt={post.data.title} width={300} height={225} class="w-full h-full object-cover group-hover:opacity-90 transition-opacity" />
                                    )}
                                </div>
                                <div class="flex flex-col flex-1">
                                    <div class="text-[9px] font-bold text-[#b91c1c] uppercase tracking-wider mb-1 font-sans">
                                        {post.data.tags && post.data.tags.length > 0 ? getDisplayTag(post.data.tags[0]) : 'LAJM'}
                                    </div>
                                    <h3 class="font-serif text-[14px] md:text-[15px] font-bold text-black leading-snug group-hover:underline decoration-1 underline-offset-2 transition-colors">
                                        {post.data.title}
                                    </h3>
                                </div>
                            </a>
                        </article>
                    ))}
                </div>

            </div>

            {/* SEKSIONI I EDITORIALEVE TË VOGLA (Tani ka frymëmarrje) */}
            <div class="grid grid-cols-1 md:grid-cols-3 gap-x-8 gap-y-0 md:gap-y-10 pt-8 pb-4 border-b border-black px-4 md:px-0">
                
                {/* 1. THËNIA E DITËS */}
                <div class="flex flex-col lg:border-r lg:border-slate-300 lg:pr-8 h-full border-b md:border-b-0 border-slate-200 pb-8 mb-8 md:pb-0 md:mb-0">
                    <h4 class="font-sans font-bold text-[11px] tracking-[0.15em] uppercase border-b border-black pb-1 mb-4 md:mb-5 text-slate-900">
                        Thënia e Ditës
                    </h4>
                    <p class="font-serif italic text-[17px] md:text-[19px] text-slate-800 leading-relaxed mb-5">
                        "{quoteText}"
                    </p>
                    {/* Linku Plain Text i pastër */}
                    <a href={quoteUrl} class="mt-auto text-[11px] font-sans font-bold uppercase tracking-widest text-[#b91c1c] hover:text-black transition-colors inline-flex items-center gap-1">
                        Lexo më shumë <span class="text-sm leading-none">&rarr;</span>
                    </a>
                </div>

                {/* 2. HOROSKOPI */}
                <div class="flex flex-col lg:border-r lg:border-slate-300 lg:pr-8 h-full border-b md:border-b-0 border-slate-200 pb-8 mb-8 md:pb-0 md:mb-0">
                    <h4 class="font-sans font-bold text-[11px] tracking-[0.15em] uppercase border-b border-black pb-1 mb-4 md:mb-5 text-slate-900">
                        Horoskopi
                    </h4>
                    <div id="horoscope-container">
                        <p class="text-sm text-slate-400 italic">Po konsultojmë yjet...</p>
                    </div>
                </div>

                {/* 3. SONDAZHI */}
                <div class="flex flex-col h-full pb-4 md:pb-0">
                    <h4 class="font-sans font-bold text-[11px] tracking-[0.15em] uppercase border-b border-black pb-1 mb-4 md:mb-5 text-slate-900">
                        Sondazhi i Javës
                    </h4>
                    <a href="/sondazh" class="block group no-underline flex flex-col h-full">
                        <h3 class="font-serif font-bold text-[18px] md:text-2xl text-black group-hover:text-[#b91c1c] transition-colors mb-2">
                            A ka rëndësi zëri yt?
                        </h3>
                        <p class="font-serif text-[14px] md:text-[15px] text-slate-700 leading-snug mb-5">
                            Shpreh mendimin tënd në sondazhin e kësaj jave. Çdo votë numërohet dhe rezultatet publikohen çdo të premte.
                        </p>
                        <span class="mt-auto text-[11px] font-sans font-bold uppercase tracking-widest text-[#b91c1c] group-hover:text-black transition-colors inline-flex items-center gap-1">
                            Voto Tani <span class="text-sm leading-none">&rarr;</span>
                        </span>
                    </a>
                </div>

            </div>

            {/* HEADER I SEKSIONIT TË INJORUARA */}
            <div class="flex items-center gap-3 md:gap-4 mb-4 md:mb-6 mt-8 md:mt-10 px-4 md:px-0">
                <h2 class="text-[16px] md:text-lg font-normal font-sans text-black tracking-tight uppercase shrink-0 m-0">
                    Më të injoruarat
                </h2>
                <div class="flex-1 h-[1px] bg-slate-500 mt-1"></div>
            </div>

            {/* BLLOKU EDITORIAL 2: MË TË INJORUARAT */}
            <div id="ignored-posts-container" class="grid grid-cols-1 lg:grid-cols-12 gap-y-6 md:gap-y-10 pb-4">
                <p class="col-span-12 text-center text-slate-400 italic">Po kërkojmë lajmet e fshehura...</p>
            </div>

        </div>

        <EditorsPick/>

        <Footer />

        {/* ========================================== */}
        {/* SKRIPTI CLIENT-SIDE (Përditësuar me dizajnin) */}
        {/* ========================================== */}
        <script is:inline define:vars={{ poolForIgnored, allHoroscopes }}>
            document.addEventListener('DOMContentLoaded', () => {
                
                const getZodiacSymbol = (signName) => {
                    const symbols = {
                        "dashi": "♈", "demi": "♉", "binjakët": "♊", "binjaket": "♊",
                        "gaforrja": "♋", "luani": "♌", "virgjëresha": "♍", "virgjeresha": "♍",
                        "peshorja": "♎", "akrepi": "♏", "shigjetari": "♐", "bricjapi": "♑",
                        "ujori": "♒", "peshqit": "♓"
                    };
                    return symbols[signName.toLowerCase()] || "✨";
                };

                const randomSign = allHoroscopes[Math.floor(Math.random() * allHoroscopes.length)];
                const symbol = getZodiacSymbol(randomSign.sign);
                
                const horoscopeHTML = `
                    <div class="flex items-center gap-2 mb-3">
                        <span class="text-2xl leading-none">${symbol}</span>
                        <span class="font-serif font-bold text-xl capitalize text-black">${randomSign.sign}</span>
                    </div>
                    <p class="font-serif text-[15px] md:text-[16px] text-slate-700 leading-relaxed">
                        "${randomSign.text}"
                    </p>
                `;
                document.getElementById('horoscope-container').innerHTML = horoscopeHTML;


                const shuffledPosts = [...poolForIgnored].sort(() => 0.5 - Math.random());
                const selectedPosts = shuffledPosts.slice(0, 7); 

                if(selectedPosts.length === 7) {
                    const feat = selectedPosts[0];
                    const midPosts = selectedPosts.slice(1, 4);
                    const rightPosts = selectedPosts.slice(4, 7);

                    const formatDate = (dateString) => {
                        const date = new Date(dateString);
                        return date.toLocaleDateString('sq-AL', { year: 'numeric', month: 'short', day: 'numeric' });
                    };

                    const generateSmallCols = (posts) => {
                        return posts.map(post => `
                            <article class="group">
                                <a href="${post.slug}" class="no-underline text-inherit flex items-start gap-4">
                                    <div class="shrink-0 w-[85px] md:w-[120px] aspect-[4/3] overflow-hidden bg-slate-100 rounded-sm">
                                        <img src="${post.heroImage}" alt="${post.title}" class="w-full h-full object-cover group-hover:opacity-90 transition-opacity" loading="lazy" />
                                    </div>
                                    <div class="flex flex-col flex-1">
                                        <div class="text-[9px] font-bold text-[#b91c1c] uppercase tracking-wider mb-1 font-sans">
                                            ${post.tag}
                                        </div>
                                        <h3 class="font-serif text-[14px] md:text-[15px] font-bold text-black leading-snug group-hover:underline decoration-1 underline-offset-2 transition-colors">
                                            ${post.title}
                                        </h3>
                                    </div>
                                </a>
                            </article>
                        `).join('');
                    };

                    const ignoredHTML = `
                        <div class="lg:col-span-4 flex flex-col lg:pr-5 lg:border-r lg:border-slate-300">
                            <article class="group flex flex-col">
                                <a href="${feat.slug}" class="no-underline text-inherit flex flex-col h-full">
                                    <div class="w-full aspect-[16/9] overflow-hidden bg-slate-100 mb-3 rounded-none md:rounded-sm">
                                        <img src="${feat.heroImage}" alt="${feat.title}" class="w-full h-full object-cover group-hover:opacity-90 transition-opacity" loading="lazy" />
                                    </div>
                                    <div class="px-4 md:px-0 flex flex-col">
                                        <div class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1.5 flex items-center gap-1.5 font-sans">
                                            <span class="text-[#b91c1c]">${feat.tag}</span>
                                            <span>&bull;</span>
                                            <span>${formatDate(feat.date)}</span>
                                        </div>
                                        <h3 class="text-[18px] md:text-[20px] font-serif font-bold text-black leading-tight mb-2 group-hover:text-slate-600 transition-colors">
                                            ${feat.title}
                                        </h3>
                                        <p class="text-[14px] font-serif text-slate-700 leading-snug line-clamp-2">
                                            ${feat.description}
                                        </p>
                                    </div>
                                </a>
                            </article>
                        </div>

                        <div class="lg:col-span-4 flex flex-col lg:px-5 lg:border-r lg:border-slate-300 gap-5 px-4 md:px-0 mt-2 md:mt-0">
                            ${generateSmallCols(midPosts)}
                        </div>

                        <div class="lg:col-span-4 flex flex-col lg:pl-5 gap-5 px-4 md:px-0 mt-1 md:mt-0">
                            ${generateSmallCols(rightPosts)}
                        </div>
                    `;

                    document.getElementById('ignored-posts-container').innerHTML = ignoredHTML;
                }
            });
        </script>
    </body>
</html>