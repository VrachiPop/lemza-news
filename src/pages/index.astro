---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import Hero from '../components/home/Hero.astro';
import EditorialBanner from '../components/EditorialBanner.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { Image } from 'astro:assets';
import '../app.css';

// Importi i magjisë nga helpers (DRY)
import { getDisplayTag, getPostUrl } from '../utils/helpers';

// 1. Merr të gjitha postimet dhe renditi sipas datës
const allPosts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 2. Kapërce të parin (sepse ai ndodhet në Hero) dhe merr 6 lajme
const gridPosts = allPosts.slice(1, 7);

// 3. LOGJIKA E RE PËR LAYOUT-in
// Dy postimet më të rëndësishme që do shfaqen në 2 kolona (Fokus)
const topTwoPosts = gridPosts.slice(0, 2);

// Pjesa e mbetur (4 lajme) që do shfaqen në formë liste poshtë tyre
const restPosts = gridPosts.slice(2);
---

<!doctype html>
<html lang="sq">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
        <style>
            html, body {
                margin: 0;
                padding: 0;
                background-color: #F8FAFC;
                color: #1e293b;
                scroll-behavior: smooth;
            }
            .news-container {
                padding-top: 3rem;
                padding-bottom: 5rem;
            }
        </style>
    </head>
    <body>
        
        <Header />

        {/* BANNERI NË FILLIM TË EKRANIT */}
        <EditorialBanner 
    title="Lemza News" 
    subtitle='Të parët te <span class="strike-text">lajmi</span><span class="reveal-text">&nbsp;<span class="type-letter">rr</span><span class="type-letter">e</span><span class="type-letter">n</span><span class="type-letter">a</span></span>' 
/>

        <div class="news-container">
            <div class="w-full max-w-[1600px] mx-auto px-2 md:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12">
                
                <main class="lg:col-span-8">

                    {/* HERO LAJMI KRYESOR */}
                    <Hero />

                    {/* ========================================== */}
                    {/* LAJMET E DYTA DHE TË TRETA (2 KOLONA) */}
                    {/* ========================================== */}
                    {topTwoPosts.length > 0 && (
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12 pb-12 border-b border-slate-200">
                            {topTwoPosts.map((post) => (
                                <article class="group flex flex-col h-full">
                                    <a href={getPostUrl(post.slug)} class="no-underline text-inherit flex flex-col h-full">
                                        
                                        {/* Imazhi */}
                                        <div class="relative w-full aspect-[16/10] overflow-hidden rounded-xl shadow-sm mb-5 bg-slate-100 shrink-0">
                                            {post.data.heroImage ? (
                                                <Image 
                                                    src={post.data.heroImage} 
                                                    alt={post.data.title} 
                                                    width={600}   
                                                    height={400}
                                                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out" 
                                                />
                                            ) : (
                                                <div class="w-full h-full bg-slate-200 flex items-center justify-center text-slate-400">IMG</div>
                                            )}

                                            {/* TAGU I KUQ */}
                                            <div class="absolute top-3 left-3 z-10 flex flex-wrap gap-2">
                                                {post.data.tags && post.data.tags.length > 0 ? (
                                                    post.data.tags.map((tag: string) => (
                                                        <span class="bg-[#DC2626] text-white text-[10px] font-black uppercase tracking-widest px-2.5 py-1.5 rounded-sm shadow-md">
                                                            {getDisplayTag(tag)}
                                                        </span>
                                                    ))
                                                ) : (
                                                    <span class="bg-[#DC2626] text-white text-[10px] font-black uppercase tracking-widest px-3 py-1.5 rounded-sm shadow-md">
                                                        FOKUS
                                                    </span>
                                                )}
                                            </div>
                                        </div>

                                        {/* Përmbajtja */}
                                        <div class="flex flex-col flex-1 gap-2">
                                            <div class="flex items-center gap-2 text-[11px] font-bold text-slate-400 uppercase tracking-widest">
                                                <FormattedDate date={post.data.pubDate} />
                                                <span class="text-[#DC2626]">&bull;</span>
                                                <span class="text-[#DC2626]">Fokus</span>
                                            </div>

                                            <h3 class="text-xl md:text-xl font-serif font-black text-slate-900 leading-tight group-hover:text-[#0f172a] group-hover:underline decoration-3 underline-offset-4 transition-all">
                                                {post.data.title}
                                            </h3>

                                            <p class="text-slate-600 leading-relaxed line-clamp-3 font-sans mt-1">
                                                {post.data.description}
                                            </p>
                                        </div>
                                    </a>
                                </article>
                            ))}
                        </div>
                    )}

                    {/* ========================================== */}
                    {/* LISTA E LAJMEVE TË TJERA TË GRID-IT */}
                    {/* ========================================== */}
                    <div class="flex flex-col divide-y divide-slate-200 border-b border-slate-200">
                        {restPosts.map((post) => (
                            <article class="group py-8 first:pt-0">
                                <a href={getPostUrl(post.slug)} class="no-underline text-inherit grid grid-cols-1 md:grid-cols-12 gap-6 items-start">
                                    
                                    {/* Image Left */}
                                    <div class="md:col-span-4 lg:col-span-5 relative aspect-[16/10] overflow-hidden rounded-lg bg-slate-100 shadow-sm">
                                        {post.data.heroImage ? (
                                            <Image 
                                                src={post.data.heroImage} 
                                                alt={post.data.title} 
                                                width={500}   
                                                height={300}
                                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out" 
                                            />
                                        ) : (
                                            <div class="w-full h-full bg-slate-200 text-slate-400 flex items-center justify-center">IMG</div>
                                        )}
                                        
                                        {/* TAGU I KUQ */}
                                        <div class="absolute top-3 left-3 z-10 flex flex-wrap gap-2">
                                            {post.data.tags && post.data.tags.length > 0 ? (
                                                post.data.tags.map((tag: string) => (
                                                    <span class="bg-[#DC2626] text-white text-[10px] font-black uppercase tracking-widest px-3 py-1 rounded-sm shadow-md">
                                                        {getDisplayTag(tag)}
                                                    </span>
                                                ))
                                            ) : (
                                                <span class="bg-[#DC2626] text-white text-[10px] font-black uppercase tracking-widest px-3 py-1 rounded-sm shadow-md">
                                                    LAJM
                                                </span>
                                            )}
                                        </div>
                                    </div>

                                    {/* Content Right */}
                                    <div class="md:col-span-8 lg:col-span-7 flex flex-col justify-between h-full">
                                        <div>
                                            <div class="flex items-center gap-2 mb-2 text-[11px] font-bold text-slate-400 uppercase tracking-widest">
                                                <FormattedDate date={post.data.pubDate} />
                                            </div>

                                            <h3 class="text-xl font-serif font-bold text-slate-800 leading-tight mb-2 group-hover:text-[#0f172a] group-hover:underline decoration-2 underline-offset-4 transition-colors">
                                                {post.data.title}
                                            </h3>

                                            <p class="text-slate-600 text-sm leading-relaxed line-clamp-2 font-sans">
                                                {post.data.description}
                                            </p>
                                        </div>
                                        
                                        <div class="mt-3 md:mt-auto pt-2 flex items-center text-[#0f172a] font-bold text-xs uppercase tracking-widest opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300">
                                            Lexo të plotë &rarr;
                                        </div>
                                    </div>
                                </a>
                            </article>
                        ))}
                    </div>

                    <div class="mt-12 text-center">
                        <a href="/te-fundit" class="inline-block px-10 py-4 border border-slate-400 text-slate-600 font-bold uppercase tracking-widest text-xs hover:border-[#0f172a] hover:text-white hover:bg-[#0f172a] transition-all rounded-sm">
                            Shiko të gjitha
                        </a>
                    </div>
                </main>

                <aside class="lg:col-span-4 mt-12 lg:mt-0 lg:pl-10 border-l border-slate-200">
                    <div class="sticky top-24">
                        <Sidebar />
                    </div>
                </aside>

            </div>
        </div>
        
        <Footer />
    </body>
</html>