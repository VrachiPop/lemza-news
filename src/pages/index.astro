---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Hero from '../components/home/Hero.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { Image } from 'astro:assets';
import '../app.css';
import { getDisplayTag, getPostUrl } from '../utils/helpers';
import EditorsPick from '../components/EditorsPick.astro';
import horoscopeData from '../data/horoscope.json';

// ==========================================
// LOGJIKA KRYESORE SERVER-SIDE
// ==========================================
const allPosts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredPost = allPosts[1]; 
const middlePosts = allPosts.slice(2, 5); 
const rightPosts = allPosts.slice(5, 8); 

const poolForIgnored = allPosts.slice(10).map(post => ({
    title: post.data.title,
    slug: getPostUrl(post.slug),
    heroImage: post.data.heroImage ? post.data.heroImage.src : '', 
    date: post.data.pubDate,
    tag: post.data.tags && post.data.tags.length > 0 ? getDisplayTag(post.data.tags[0]) : 'LAJM',
    description: post.data.description
}));

const quotePost = allPosts.find(post => post.data.quoteOfTheDay);
const quoteText = quotePost?.data.quoteOfTheDay || "Sot të gjithë heshtën. Ose po gënjejnë në heshtje.";
const quoteUrl = quotePost ? getPostUrl(quotePost.slug || "") : "/";

const allHoroscopes = horoscopeData.predictions;
---

<!doctype html>
<html lang="sq">
    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
        <style>
            html, body {
                margin: 0;
                padding: 0;
                background-color: #ffffff;
                color: #000000;
                scroll-behavior: smooth;
            }

            /* force predictable base size on mobile */
            html {
                font-size: 16px;
            }
            
            /* Animimi për shiritat që ecin */
            @keyframes scrollStripes {
                0% { background-position: 0 0; }
                100% { background-position: 28px 0; } 
            }
            .animate-stripes {
                animation: scrollStripes 1.5s linear infinite;
            }
        </style>
    </head>
    <body>
        
        <Header />
        <Hero /> 

        {/* px-2 krijon margjina mikroskopike (8px) në mobile për të gjithë bllokun */}
        <div class="w-full max-w-[1250px] mx-auto px-2 md:px-8 mt-6 md:mt-12 mb-12">

            {/* HEADER I SEKSIONIT 1 */}
            <div class="flex items-center gap-3 md:gap-4 mb-4 md:mb-6">
                <h2 class="text-[15px] md:text-lg font-normal font-sans text-black tracking-tight uppercase shrink-0 m-0">
                    Lajmet e Fundit
                </h2>
                
                <div class="flex-1 h-[1px] bg-slate-500 mt-1"></div>
              
            </div>

            {/* BLLOKU EDITORIAL 1 */}
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-y-6 md:gap-y-10 border-b border-black pb-6 md:pb-8">

                {/* LAJMI I MADH */}
                <div class="lg:col-span-4 flex flex-col lg:pr-5 lg:border-r lg:border-slate-300">
                    <article class="group !p-0 flex flex-col">
                        {/* EFEKTI TOUCH I SHTUAR */}
                        <a href={getPostUrl(featuredPost?.slug || '')} class="no-underline text-inherit flex flex-col h-full max-md:active:bg-slate-100 max-md:active:scale-[0.98] max-md:rounded-xl max-md:p-2 max-md:-mx-2 transition-all duration-200">
                            <div class="w-full aspect-[16/9] overflow-hidden bg-slate-100 mb-3 rounded-sm md:rounded-sm">
                                {featuredPost?.data.heroImage && (
                                    <Image src={featuredPost.data.heroImage} alt={featuredPost.data.title} width={600} height={337} class="w-full h-full object-cover group-hover:opacity-90 transition-opacity" />
                                )}
                            </div>
                            
                            <div class="flex flex-col">
                                <div class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1 flex items-center gap-1.5 font-sans">
                                    <span class="text-[#b91c1c]">
                                        {featuredPost?.data.tags && featuredPost.data.tags.length > 0 ? getDisplayTag(featuredPost.data.tags[0]) : 'FOKUS'}
                                    </span>
                                    <span>&bull;</span>
                                    {featuredPost && <FormattedDate date={featuredPost.data.pubDate} />}
                                </div>

                                <h3 class="text-[16px] md:text-[18px] font-serif font-bold text-black leading-tight mb-2 group-hover:text-slate-600 transition-colors">
                                    {featuredPost?.data.title}
                                </h3>
                                
                                <p class="text-[13px] md:text-[14px] font-serif text-slate-700 leading-snug line-clamp-2">
                                    {featuredPost?.data.description}
                                </p>
                            </div>
                        </a>
                    </article>
                </div>

                {/* KOLONA E MESIT (Lista Mobile) */}
                <div class="lg:col-span-4 flex flex-col lg:px-5 lg:border-r lg:border-slate-300 gap-4 md:gap-5 mt-2 md:mt-0">
                    {middlePosts.map((post) => (
                        <article class="group !p-0">
                            {/* EFEKTI TOUCH I SHTUAR */}
                            <a href={getPostUrl(post.slug)} class="no-underline text-inherit flex items-start gap-3 md:gap-4 max-md:active:bg-slate-100 max-md:active:scale-[0.98] max-md:rounded-xl max-md:p-2 max-md:-mx-2 transition-all duration-200">
                                <div class="shrink-0 w-[105px] md:w-[180px] aspect-[16/9] overflow-hidden bg-slate-100 rounded-sm">
                                    {post.data.heroImage && (
                                        <Image src={post.data.heroImage} alt={post.data.title} width={300} height={169} class="w-full h-full object-cover group-hover:opacity-90 transition-opacity" />
                                    )}
                                </div>
                                <div class="flex flex-col flex-1">
                                    <div class="text-[9px] font-bold text-[#b91c1c] uppercase tracking-wider mb-0.5 font-sans">
                                        {post.data.tags && post.data.tags.length > 0 ? getDisplayTag(post.data.tags[0]) : 'LAJM'}
                                    </div>
                                    <h3 class="font-serif text-sm! md:text-base! font-normal text-black leading-snug group-hover:underline decoration-1 underline-offset-2 transition-colors">
                                        {post.data.title}
                                    </h3>
                                </div>
                            </a>
                        </article>
                    ))}
                </div>

                {/* KOLONA E DJATHTË (Lista Mobile) */}
                <div class="lg:col-span-4 flex flex-col lg:pl-5 gap-4 md:gap-5 mt-1 md:mt-0">
                    {rightPosts.map((post) => (
                        <article class="group !p-0">
                            {/* EFEKTI TOUCH I SHTUAR */}
                            <a href={getPostUrl(post.slug)} class="no-underline text-inherit flex items-start gap-3 md:gap-4 max-md:active:bg-slate-100 max-md:active:scale-[0.98] max-md:rounded-xl max-md:p-2 max-md:-mx-2 transition-all duration-200">
                                <div class="shrink-0 w-[105px] md:w-[180px] aspect-[16/9] overflow-hidden bg-slate-100 rounded-sm">
                                    {post.data.heroImage && (
                                        <Image src={post.data.heroImage} alt={post.data.title} width={300} height={169} class="w-full h-full object-cover group-hover:opacity-90 transition-opacity" />
                                    )}
                                </div>
                                <div class="flex flex-col flex-1">
                                    <div class="text-[9px] font-bold text-[#b91c1c] uppercase tracking-wider mb-0.5 font-sans">
                                        {post.data.tags && post.data.tags.length > 0 ? getDisplayTag(post.data.tags[0]) : 'LAJM'}
                                    </div>
                                    <h3 class="font-serif text-sm! md:text-base! font-normal text-black leading-snug group-hover:underline decoration-1 underline-offset-2 transition-colors">
                                        {post.data.title}
                                    </h3>
                                </div>
                            </a>
                        </article>
                    ))}
                </div>

            {/* LINKU "SHIKO TË GJITHA" NË FUND TË SEKSIONIT */}
                <div class="col-span-1 lg:col-span-12 flex justify-center md:justify-end mt-0 md:mt-0 pt-1 md:pt-1">
                    
                    {/* MOBILE: Vetëm tekst i pastër */}
                    <a href="/te-fundit" class="md:hidden text-[11px] font-bold font-sans uppercase tracking-widest text-slate-500 hover:text-black transition-colors inline-flex items-center gap-1 active:scale-[0.95] transition-transform">
                        Shiko të gjitha <span class="text-[14px] leading-none">&rarr;</span>
                    </a>

                    {/* DESKTOP: Butoni Pill elegant */}
                    <a href="/te-fundit" class="hidden md:inline-flex bg-white text-black border border-slate-200 hover:bg-[#DC2626] hover:text-white hover:border-[#DC2626] px-5 py-2 rounded-full text-[11px] font-bold font-serif uppercase tracking-widest transition-all duration-300 items-center gap-1.5 shadow-sm">
                        Shiko të gjitha
                    </a>

                </div>

            </div> {/* <--- Mbyllja e Bllokut Editorial 1 */}

            {/* SEKSIONI I EDITORIALEVE TË VOGLA (Dizajn Premium) */}
            <div class="grid grid-cols-1 md:grid-cols-3 gap-x-8 gap-y-0 md:gap-y-10 pt-6 md:pt-8 pb-4 px-4 md:px-0">
                
                {/* 1. THËNIA E DITËS */}
                {/* EFEKTI TOUCH PËR BLLOKUN E THËNIES (Meqë është një bllok me link mbështjellës të pavarur) */}
                <div class="flex flex-col lg:border-r lg:border-slate-300 lg:pr-8 h-full border-b md:border-b-0 border-slate-200 py-6 md:py-0 md:pb-0 transition-all duration-200">
                    <h4 class="w-max font-sans font-bold text-[10px] md:text-[11px] tracking-[0.2em] uppercase border-b border-slate-300 pb-1.5 mb-4 md:mb-5 text-slate-500">
                        Thënia e Ditës
                    </h4>
                    
                    {/* Bëmë të gjithë tekstin dhe butonin të klikueshëm si një bllok */}
                    <a href={quoteUrl} class="flex flex-col h-full no-underline text-inherit group max-md:active:bg-slate-50 max-md:active:scale-[0.98] max-md:rounded-xl transition-all duration-200 max-md:-mx-3 max-md:p-3">
                        <p class="font-serif italic text-[16px] md:text-[19px] text-slate-900 leading-relaxed mb-4">
                            "{quoteText}"
                        </p>
                        {/* MOBILE: Vetëm tekst i pastër */}
                        <span class="md:hidden mt-auto text-[10px] font-sans font-bold uppercase tracking-widest text-[#b91c1c] group-hover:text-black transition-colors inline-flex items-center gap-1 w-max">
                            Lexo më shumë <span class="text-[14px] leading-none">&rarr;</span>
                        </span>

                        {/* DESKTOP: Butoni Pill elegant */}
                        <span class="hidden md:inline-flex mt-auto bg-white text-black border border-slate-200 group-hover:bg-[#DC2626] group-hover:text-white group-hover:border-[#DC2626] px-4 py-1.5 rounded-full text-[10px] font-bold font-serif uppercase tracking-widest transition-all duration-300 items-center gap-1 shadow-sm w-max">
                            Lexo më shumë
                        </span>
                    </a>
                </div>

                {/* 2. HOROSKOPI */}
                <div class="flex flex-col lg:border-r lg:border-slate-300 lg:pr-8 h-full border-b md:border-b-0 border-slate-200 py-6 md:py-0 md:pb-0">
                    <h4 class="w-max font-sans font-bold text-[10px] md:text-[11px] tracking-[0.2em] uppercase border-b border-slate-300 pb-1.5 mb-4 md:mb-5 text-slate-500">
                        Horoskopi
                    </h4>
                    <div id="horoscope-container" class="active:scale-[0.98] transition-transform duration-200">
                        <p class="text-sm text-slate-400 italic font-serif">Po konsultojmë yjet...</p>
                    </div>
                </div>

                {/* 3. SONDAZHI */}
                <div class="flex flex-col h-full py-6 md:py-0 md:pb-0">
                    <h4 class="w-max font-sans font-bold text-[10px] md:text-[11px] tracking-[0.2em] uppercase border-b border-slate-300 pb-1.5 mb-4 md:mb-5 text-slate-500">
                        Sondazhi
                    </h4>
                    {/* EFEKTI TOUCH I SHTUAR NË BLLOKUN E SONDAZHIT */}
                    <a href="/sondazh" class="block group no-underline flex flex-col h-full max-md:active:bg-slate-50 max-md:active:scale-[0.98] max-md:rounded-xl transition-all duration-200 max-md:-mx-3 max-md:p-3">
                        <h3 class="font-serif font-bold text-[18px] md:text-2xl text-black group-hover:text-[#b91c1c] transition-colors mb-2 md:mb-2">
                            Zëri yt nuk ka rëndësi.
                        </h3>
                        <p class="font-serif text-[14px] md:text-[15px] text-slate-700 leading-snug mb-5">
                            Sidoqoftë, mund të shprehësh mendimin tënd në sondazhin e ditës.
                        </p>
                        
                        {/* MOBILE: Vetëm tekst i pastër */}
                        <span class="md:hidden mt-auto text-[10px] font-sans font-bold uppercase tracking-widest text-[#b91c1c] group-hover:text-black transition-colors inline-flex items-center gap-1 w-max">
                            Voto tani <span class="text-[14px] leading-none">&rarr;</span>
                        </span>

                        <span class="hidden md:inline-flex mt-auto bg-white text-black border border-slate-200 group-hover:bg-[#DC2626] group-hover:text-white group-hover:border-[#DC2626] px-4 py-1.5 rounded-full text-[10px] font-bold font-serif uppercase tracking-widest transition-all duration-300 items-center gap-1 shadow-sm w-max">
                            Voto tani
                        </span>
                    </a>
                </div>

            </div>

            {/* HEADER I SEKSIONIT TË INJORUARA */}
            <div class="flex items-center gap-3 md:gap-4 mb-4 md:mb-6 mt-8 md:mt-10">
                <h2 class="text-[15px] md:text-lg font-normal font-sans text-black tracking-tight uppercase shrink-0 m-0">
                    Më të injoruarat
                </h2>
                <div class="flex-1 h-[1px] bg-slate-500 mt-1"></div>
            </div>

            {/* BLLOKU EDITORIAL 2: MË TË INJORUARAT (Mbushet nga JS) */}
            <div id="ignored-posts-container" class="grid grid-cols-1 lg:grid-cols-12 gap-y-6 md:gap-y-10 pb-4">
                <p class="col-span-12 text-center text-slate-400 italic">Po kërkojmë lajmet e fshehura...</p>
            </div>

            {/* ========================================== */}
            {/* PATREON HOMEPAGE BANNER (FULL WIDTH)       */}
            {/* ========================================== */}
            <div class="relative w-full bg-[#0f172a] border border-slate-700/60 mt-12 mb-8 overflow-hidden rounded-lg hover:border-[#DC2626]/50 transition-colors duration-300">
                
                <div class="absolute top-0 left-0 w-full h-[5px] bg-[#DC2626]"></div>

                <div class="p-6 md:p-10 pt-8 md:pt-12 flex flex-col md:flex-row gap-6 md:gap-10 items-start md:items-center justify-between">
                    
                    <h4 class="text-white font-serif font-black text-[22px] md:text-3xl leading-snug m-0">
                        Gazetaria jonë është e rreme,{" "}
                        <br class="hidden md:block" />
                        <span class="text-slate-400">por jo tarifat e serverit.</span>
                    </h4>

                    <a 
                        href="https://www.patreon.com/cw/LemzaNews" 
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 bg-[#DC2626] hover:bg-[#b91c1c] active:bg-[#991b1b] text-white font-black uppercase tracking-widest text-[11px] px-4 py-3 transition-colors duration-150 no-underline shrink-0 rounded-sm"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M14.82 2.41C18.78 2.41 22 5.65 22 9.62c0 3.96-3.22 7.18-7.18 7.18-3.96 0-7.17-3.22-7.17-7.18 0-3.97 3.21-7.21 7.17-7.21M2 21.6h3.5V2.41H2V21.6z"/>
                        </svg>
                        Na Mbështet në Patreon
                    </a>
                </div>

                <div class="absolute bottom-0 right-0 w-16 h-16 border-b-[3px] border-r-[3px] border-[#DC2626]/20 pointer-events-none"></div>
            </div>

        </div>

        <EditorsPick/>

        <Footer />

        {/* ========================================== */}
        {/* SKRIPTI CLIENT-SIDE (Përditësuar me dizajnin) */}
        {/* ========================================== */}
        <script is:inline define:vars={{ poolForIgnored, allHoroscopes }}>
            const initRandomSections = () => {
                const horoscopeContainer = document.getElementById('horoscope-container');
                const ignoredContainer = document.getElementById('ignored-posts-container');
                
                // Siguresë: Nëse nuk i gjen kontejnerët në këtë faqe, ndalo skriptin
                if (!horoscopeContainer || !ignoredContainer) return;

                // Krijojmë datën e sotme vetëm një herë për ta përdorur kudo
                const todayStr = new Date().toLocaleDateString('sq-AL');

                // --- 1. RANDOMIZIMI I HOROSKOPIT (1 HERË NË DITË) ---
                const getZodiacSymbol = (signName) => {
                    const symbols = {
                        "dashi": "♈", "demi": "♉", "binjakët": "♊", "binjaket": "♊",
                        "gaforrja": "♋", "luani": "♌", "virgjëresha": "♍", "virgjeresha": "♍",
                        "peshorja": "♎", "akrepi": "♏", "shigjetari": "♐", "bricjapi": "♑",
                        "ujori": "♒", "peshqit": "♓"
                    };
                    return symbols[signName.toLowerCase()] || "✨";
                };

                let selectedSign = null;

                // Kontrollojmë kujtesën për horoskopin e sotëm
                try {
                    const cachedHoroscope = localStorage.getItem('lemza_horoscope_daily');
                    if (cachedHoroscope) {
                        const parsedCache = JSON.parse(cachedHoroscope);
                        if (parsedCache.date === todayStr && parsedCache.signData) {
                            selectedSign = parsedCache.signData;
                        }
                    }
                } catch(e) { console.error("Kujtesa e horoskopit nuk funksionoi", e); }

                // Nëse s'ka asgjë për sot, zgjedhim një të ri dhe e ruajmë
                if (!selectedSign) {
                    selectedSign = allHoroscopes[Math.floor(Math.random() * allHoroscopes.length)];
                    try {
                        localStorage.setItem('lemza_horoscope_daily', JSON.stringify({
                            date: todayStr,
                            signData: selectedSign
                        }));
                    } catch(e) {}
                }

                const symbol = getZodiacSymbol(selectedSign.sign);
                
                const horoscopeHTML = `
                    <div class="flex items-center gap-2 mb-2 md:mb-3">
                        <span class="text-[28px] md:text-2xl leading-none font-serif text-slate-900">${symbol}</span>
                        <span class="font-serif font-bold text-[18px] md:text-xl capitalize text-black tracking-tight">${selectedSign.sign}</span>
                    </div>
                    <p class="font-serif text-[14px] md:text-[16px] text-slate-800 leading-relaxed">
                        "${selectedSign.text}"
                    </p>
                `;
                horoscopeContainer.innerHTML = horoscopeHTML;


                // --- 2. RANDOMIZIMI I LAJMEVE TË INJORUARA (1 HERË NË DITË) ---
                let selectedPosts = [];

                // Kontrollojmë kujtesën për lajmet e sotme
                try {
                    const cachedIgnored = localStorage.getItem('lemza_ignored_daily');
                    if (cachedIgnored) {
                        const parsedCache = JSON.parse(cachedIgnored);
                        if (parsedCache.date === todayStr && parsedCache.posts && parsedCache.posts.length > 0) {
                            selectedPosts = parsedCache.posts;
                        }
                    }
                } catch(e) { console.error("Kujtesa e lajmeve nuk funksionoi", e); }

                // Nëse NUK gjetëm lajme për sot, zgjedhim 7 të reja dhe i ruajmë!
                if (selectedPosts.length === 0) {
                    const shuffledPosts = [...poolForIgnored].sort(() => 0.5 - Math.random());
                    selectedPosts = shuffledPosts.slice(0, 7);
                    
                    try {
                        localStorage.setItem('lemza_ignored_daily', JSON.stringify({
                            date: todayStr,
                            posts: selectedPosts
                        }));
                    } catch(e) {}
                }

                if(selectedPosts.length > 0) {
                    const feat = selectedPosts[0];
                    const midPosts = selectedPosts.slice(1, 4);
                    const rightPosts = selectedPosts.slice(4, 7);

                    const formatDate = (dateString) => {
                        const date = new Date(dateString);
                        return date.toLocaleDateString('sq-AL', { year: 'numeric', month: 'short', day: 'numeric' });
                    };

                    const generateSmallCols = (posts) => {
                        return posts.map(post => `
                            <article class="group !p-0">
                                <a href="${post.slug}" class="no-underline text-inherit flex items-start gap-4 max-md:active:bg-slate-100 max-md:active:scale-[0.98] max-md:rounded-xl max-md:p-2 max-md:-mx-2 transition-all duration-200">
                                    <div class="shrink-0 w-[105px] md:w-[180px] aspect-[16/9] overflow-hidden bg-slate-100 rounded-sm">
                                        <img src="${post.heroImage}" alt="${post.title}" class="w-full h-full object-cover group-hover:opacity-90 transition-opacity" loading="lazy" />
                                    </div>
                                    <div class="flex flex-col flex-1">
                                        <div class="text-[9px] font-bold text-[#b91c1c] uppercase tracking-wider mb-1 font-sans">
                                            ${post.tag}
                                        </div>
                                        <h3 class="font-serif text-sm! md:text-base! font-normal text-black leading-snug group-hover:underline decoration-1 underline-offset-2 transition-colors">
                                            ${post.title}
                                        </h3>
                                    </div>
                                </a>
                            </article>
                        `).join('');
                    };

                    const ignoredHTML = `
                        <div class="lg:col-span-4 flex flex-col lg:pr-5 lg:border-r lg:border-slate-300">
                            <article class="group !p-0 flex flex-col">
                                <a href="${feat.slug}" class="no-underline text-inherit flex flex-col h-full max-md:active:bg-slate-100 max-md:active:scale-[0.98] max-md:rounded-xl max-md:p-2 max-md:-mx-2 transition-all duration-200">
                                    <div class="w-full aspect-[16/9] overflow-hidden bg-slate-100 mb-3 rounded-none md:rounded-sm">
                                        <img src="${feat.heroImage}" alt="${feat.title}" class="w-full h-full object-cover group-hover:opacity-90 transition-opacity" loading="lazy" />
                                    </div>
                                    <div class="flex flex-col">
                                        <div class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1.5 flex items-center gap-1.5 font-sans">
                                            <span class="text-[#b91c1c]">${feat.tag}</span>
                                            <span>&bull;</span>
                                            <span>${formatDate(feat.date)}</span>
                                        </div>
                                        <h3 class="text-[16px] md:text-[18px] font-serif font-bold text-black leading-tight mb-2 group-hover:text-slate-600 transition-colors">
                                            ${feat.title}
                                        </h3>
                                        <p class="text-[14px] font-serif text-slate-700 leading-snug line-clamp-2">
                                            ${feat.description}
                                        </p>
                                    </div>
                                </a>
                            </article>
                        </div>

                        <div class="lg:col-span-4 flex flex-col lg:px-5 lg:border-r lg:border-slate-300 gap-5 mt-2 md:mt-0">
                            ${generateSmallCols(midPosts)}
                        </div>

                        <div class="lg:col-span-4 flex flex-col lg:pl-5 gap-5 mt-1 md:mt-0">
                            ${generateSmallCols(rightPosts)}
                        </div>
                    `;

                    ignoredContainer.innerHTML = ignoredHTML;
                }
            };

            // 1. Ekzekutoje direkt tani që u lexua HTML-ja
            initRandomSections();

            // 2. Ekzekutoje prapë nëse Astro bën navigim të brendshëm (ViewTransitions)
            document.addEventListener('astro:page-load', initRandomSections);
            
            // 3. Ekzekutoje nëse kthehesh mbrapsht me butonin "Back" (Cache)
            window.addEventListener('pageshow', (event) => {
                if (event.persisted) {
                    initRandomSections();
                }
            });
        </script>
    </body>
</html>