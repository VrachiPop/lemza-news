---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const tagNames = {
    'politike': 'Politikë',
    'ekonomi': 'Ekonomi',
    'showbiz': 'Showbiz',
    'sport': 'Sport',
    'kulture': 'Kulturë',
    'teknologji': 'Teknologji'
    'kronike': 'Kronikë'
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			/* GLOBAL RESET */
			* { box-sizing: border-box; }
			body { margin: 0; padding: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; }

			/* HERO SECTION */
			.hero-section {
				background-color: #343a46;
				color: white;
				display: grid;
				grid-template-columns: 1fr 1fr;
				align-items: center;
				min-height: 500px;
				overflow: hidden;
				margin-bottom: 4rem;
			}
			.hero-content {
				padding: 4rem;
				display: flex;
				flex-direction: column;
				justify-content: center;
				z-index: 10;
			}
			.tag {
				background-color: #ff0033;
				color: white;
				padding: 5px 10px;
				text-transform: uppercase;
				font-weight: bold;
				font-size: 0.8rem;
				width: fit-content;
				margin-bottom: 1.5rem;
				border-radius: 2px;
			}
			.hero-title {
				color: #ffffff !important;
				font-size: 4.5rem;
				font-weight: 900;
				line-height: 0.9;
				margin: 0 0 1.5rem 0;
				text-transform: uppercase;
			}
			.hero-title span { color: #8890a0; }
			.hero-desc {
				font-size: 1.1rem;
				color: #d1d5db;
				margin-bottom: 1.5rem;
				max-width: 90%;
				line-height: 1.6;
			}
			.hero-quote {
				border-left: 3px solid #ff0033;
				padding-left: 1rem;
				font-style: italic;
				color: #9ca3af;
				margin-bottom: 2.5rem;
			}
			.hero-buttons { display: flex; gap: 1rem; }
			.btn {
				padding: 12px 24px;
				font-weight: bold;
				text-transform: uppercase;
				text-decoration: none;
				border-radius: 4px;
				transition: all 0.2s;
				display: inline-block;
				text-align: center;
			}
			.btn-primary { background-color: #ff0033; color: white; border: 2px solid #ff0033; }
			.btn-primary:hover { background-color: #cc0029; border-color: #cc0029; }
			.btn-outline { background-color: transparent; color: white; border: 2px solid #565e6d; }
			.btn-outline:hover { border-color: white; }
			.hero-image-container { height: 100%; width: 100%; position: relative; min-height: 500px; }
			.hero-image-container img {
				width: 100%; height: 100%; object-fit: cover;
				mask-image: linear-gradient(to right, transparent, black 20%);
				-webkit-mask-image: linear-gradient(to right, transparent, black 20%);
			}

			/* NEWS GRID SECTION */
			main { width: 1200px; max-width: 95%; margin: 0 auto; padding: 0 1rem; }
			.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; border-bottom: 1px solid #e5e7eb; padding-bottom: 1rem; }
			.section-title { font-size: 2rem; font-weight: 800; color: #1f2937; margin: 0; padding-left: 15px; border-left: 5px solid #ff0033; line-height: 1; }
			.view-all { color: #ff0033; text-decoration: none; font-weight: 700; font-size: 0.9rem; display: flex; align-items: center; gap: 5px; text-transform: uppercase; }
			.news-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-bottom: 4rem; }
			
			.news-card {
				background: white; border: 1px solid #e5e7eb; border-radius: 8px;
				overflow: hidden; display: flex; flex-direction: column;
				transition: transform 0.2s, box-shadow 0.2s;
			}
			.news-card:hover { transform: translateY(-5px); box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1); }
			
			.card-image { position: relative; height: 200px; width: 100%; background: #f3f4f6; }
			.card-image img { width: 100%; height: 100%; object-fit: cover; }
			
			.tags-container { position: absolute; top: 15px; left: 15px; z-index: 10; display: flex; flex-wrap: wrap; gap: 5px; }
			.card-category { background-color: #ff0033; color: white; padding: 4px 10px; font-size: 0.7rem; font-weight: bold; text-transform: uppercase; border-radius: 2px; }

			.card-content { padding: 1.5rem; display: flex; flex-direction: column; flex-grow: 1; }
			.card-meta { display: flex; gap: 15px; font-size: 0.75rem; color: #6b7280; margin-bottom: 1rem; align-items: center; }
			.meta-item { display: flex; align-items: center; gap: 6px; }
			.meta-icon { width: 16px; height: 16px; min-width: 16px; }
			.card-title { font-size: 1.25rem; font-weight: 800; color: #111827; margin: 0 0 0.75rem 0; line-height: 1.3; }
			.card-excerpt { font-size: 0.95rem; color: #4b5563; line-height: 1.5; margin-bottom: 1.5rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
			.read-more { margin-top: auto; color: #1f2937; text-decoration: none; font-weight: 800; font-size: 0.8rem; text-transform: uppercase; display: flex; align-items: center; gap: 5px; }
			.read-more span { color: #ff0033; font-size: 1.2em; }

			@media (max-width: 900px) {
				.hero-section { display: flex; flex-direction: column-reverse; text-align: center; }
				.hero-image-container { display: block; width: 100%; height: 300px; min-height: auto; }
				.hero-image-container img { mask-image: linear-gradient(to top, transparent, black 20%); -webkit-mask-image: linear-gradient(to top, transparent, black 20%); }
				.hero-content { padding: 3rem 1.5rem; }
				.hero-title { font-size: 3rem; }
				.hero-buttons { flex-direction: column; width: 100%; }
				.btn { width: 100%; padding: 10px 15px; font-size: 0.9rem; }
				.news-grid { grid-template-columns: 1fr; }
			}
		</style>
	</head>
	<body>
		<Header />
		
		<section class="hero-section">
			<div class="hero-content">
				<div class="tag">EKSKLUZIVE</div>
				<h1 class="hero-title">
					TË PARËT<br>
					<span>TE RRENA</span>
				</h1>
				<p class="hero-desc">
					Gazetaria investigative që gërmon <span style="color: #ff0033;">aty ku nuk ka asgjë</span> për të gjetur.
				</p>
				<div class="hero-quote">
					"Nëse është e vërtetë, ndoshta nuk e keni lexuar tek ne."
				</div>
				<div class="hero-buttons">
					<a href="#latest" class="btn btn-primary">DOKR RAT E FUNDIT</a>
					<a href="/about" class="btn btn-outline">RRETH NESH</a>
				</div>
			</div>
			<div class="hero-image-container">
				<img src="/hero-man.jpg" alt="" />
			</div>
		</section>

		<main id="latest">
			<div class="section-header">
				<h2 class="section-title">Lajmet e Fundit</h2>
				<a href="/te-fundit" class="view-all">
					Shiko të gjitha 
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
				</a>
			</div>

			<div class="news-grid">
				{posts.map((post) => {
					// 1. SCAN THE TEXT FOR IMAGES (REGEX)
					// This looks for ![alt](url) and captures the 'url' part
					const imageMatch = post.body.match(/!\[.*?\]\((.*?)\)/);
					
					// 2. DECIDE WHICH IMAGE TO USE
					// Use heroImage if it exists, OR use the one found in text
					const imageSrc = post.data.heroImage || (imageMatch ? imageMatch[1] : null);

					return (
					<article class="news-card">
						<a href={`/te-fundit/${post.id}/`} style="text-decoration: none; color: inherit; height: 100%; display: flex; flex-direction: column;">
							<div class="card-image">
								
								<div class="tags-container">
									{post.data.tags && post.data.tags.length > 0 ? (
										post.data.tags.map((t) => (
											<span class="card-category">
												{tagNames[t] || t}
											</span>
										))
									) : (
										<span class="card-category">LAJME</span>
									)}
								</div>

								{/* 3. SHOW THE IMAGE (Using standard IMG tag for safety) */}
								{imageSrc ? (
									<img src={imageSrc} alt="" />
								) : (
									<div style="background:#eee; width:100%; height:100%;"></div>
								)}
							</div>
							<div class="card-content">
								<div class="card-meta">
									<div class="meta-item">
										<svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
										<FormattedDate date={post.data.pubDate} />
									</div>
									<div class="meta-item">
										<svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
										<span>4 min read</span>
									</div>
								</div>
								<h3 class="card-title">{post.data.title}</h3>
								<p class="card-excerpt">
									{post.data.description || "Klikoni për të lexuar lajmin e plotë..."}
								</p>
								<div class="read-more">
									LEXO MË SHUMË <span>&rarr;</span>
								</div>
							</div>
						</a>
					</article>
				)})}
			</div>
		</main>
		<Footer />
	</body>
</html>