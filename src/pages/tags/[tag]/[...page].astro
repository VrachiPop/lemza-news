---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../../consts';
import FormattedDate from '../../../components/FormattedDate.astro';
import EditorialBanner from '../../../components/EditorialBanner.astro';
import { Image } from 'astro:assets';
import '../../../app.css';

// Importi qendror nga Helpers
import { getDisplayTag, getPostUrl } from '../../../utils/helpers';

export async function getStaticPaths({ paginate }: { paginate: Function }) {
  const allPosts = await getCollection('blog');
  
  const uniqueTags = [...new Set(allPosts
    .map((post) => post.data.tags)
    .flat()
    .filter(tag => tag) 
    .map(tag => tag.toLowerCase().trim()) 
  )];

  return uniqueTags.flatMap((tag) => {
    const filteredPosts = allPosts
      .filter((post) => post.data.tags?.some(t => t.toLowerCase().trim() === tag))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
    
    return paginate(filteredPosts, {
        params: { tag: tag },
        pageSize: 14
    });
  });
}

interface Props {
    page: any;
}

const { tag } = Astro.params;
const { page } = Astro.props; 

const capitalize = (s: string) => s ? s.charAt(0).toUpperCase() + s.slice(1) : "";
const safeTag = tag || ""; 
const cleanTag = safeTag.toLowerCase().trim(); 

const pageTitle = (getDisplayTag(cleanTag) !== "LAJME" ? getDisplayTag(cleanTag) : capitalize(cleanTag)) || "Kategoria";

function getFallbackImage(body: any) {
    if (!body || typeof body !== 'string') return null;
    const imageMatch = body.match(/!\[.*?\]\((.*?)\)/);
    return imageMatch ? imageMatch[1] : null;
}

// ==========================================
// NDARJA E LAJMEVE
// ==========================================
const allPosts = page.data;

// Për Mobile: 1 e madhe, 9 të vogla (Pjesa tjetër)
const mobileFeatured = allPosts[0];
const mobileList = allPosts.slice(1);

// Për Desktop (Stili NBC): 2 të mëdha sipër, 12 në 3 kolona
const desktopTopTwo = allPosts.slice(0, 2);
const desktopColOne = allPosts.slice(2, 6);
const desktopColTwo = allPosts.slice(6, 10);
const desktopColThree = allPosts.slice(10, 14);
---

<!doctype html>
<html lang="sq">
    <head>
        <BaseHead title={`${pageTitle} - Faqja ${page.currentPage} - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
        <style>
             html, body {
                background-color: #ffffff;
                color: #000000;
            }
        </style>
    </head>
    <body class="overflow-x-hidden w-full">
        <Header />
        
        <EditorialBanner title={pageTitle || "Kategoria"} />

        {/* ========================================== */}
        {/* 1. VERSIONI PËR CELULAR (ME EFEKTET E PREKJES) */}
        {/* ========================================== */}
        <div class="block lg:hidden w-full max-w-[1250px] mx-auto px-2 pt-6 pb-10">
            {allPosts.length === 0 ? (
                <p class="text-slate-500 italic font-serif text-lg">Nuk u gjetën lajme në këtë kategori.</p>
            ) : (
                <>
                    {/* Lajmi Kryesor Mobile */}
                    {mobileFeatured && (
                        <article class="group mb-6 pb-6 border-b border-black flex flex-col">
                            {/* EFEKTI TOUCH KËTU: active:bg-slate-100 active:scale-[0.99] rounded-xl p-2 -mx-2 */}
                            <a href={getPostUrl(mobileFeatured.slug || "")} class="no-underline text-inherit flex flex-col h-full active:bg-slate-100 active:scale-[0.99] rounded-xl p-2 -mx-2 transition-all duration-200">
                                <div class="w-full aspect-[16/9] overflow-hidden bg-slate-100 mb-3 rounded-sm">
                                    {mobileFeatured.data.heroImage ? (
                                        <Image src={mobileFeatured.data.heroImage} alt="" width={600} height={337} class="w-full h-full object-cover group-hover:opacity-90 transition-opacity" />
                                    ) : getFallbackImage(mobileFeatured.body) ? (
                                        <img src={getFallbackImage(mobileFeatured.body)} alt="" class="w-full h-full object-cover group-hover:opacity-90 transition-opacity" />
                                    ) : (
                                        <div class="w-full h-full bg-slate-200 flex items-center justify-center text-slate-400">IMG</div>
                                    )}
                                </div>
                                
                                <div class="flex flex-col">
                                    <div class="flex items-center gap-1.5 text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1 font-sans">
                                        <span class="text-[#b91c1c]">
                                            {mobileFeatured.data.tags && mobileFeatured.data.tags.length > 0 ? getDisplayTag(mobileFeatured.data.tags[0]) : "LAJM"}
                                        </span>
                                        <span>&bull;</span>
                                        <FormattedDate date={mobileFeatured.data.pubDate} />
                                    </div>

                                    <h3 class="text-[16px] font-serif font-bold text-black leading-tight mb-2 group-hover:underline decoration-2 underline-offset-2 transition-all">
                                        {mobileFeatured.data.title}
                                    </h3>
                                    
                                    <p class="text-[13px] font-serif text-slate-700 leading-snug line-clamp-2">
                                        {mobileFeatured.data.description}
                                    </p>
                                </div>
                            </a>
                        </article>
                    )}

                    {/* Lista e Lajmeve të tjera Mobile */}
                    <div class="flex flex-col gap-4">
                        {mobileList.map((post: any) => (
                            <article class="group !p-0">
                                {/* EFEKTI TOUCH KËTU: active:bg-slate-100 active:scale-[0.98] rounded-xl p-2 -mx-2 */}
                                <a href={getPostUrl(post.slug || "")} class="no-underline text-inherit flex items-start gap-3 active:bg-slate-100 active:scale-[0.98] rounded-xl p-2 -mx-2 transition-all duration-200">
                                    <div class="shrink-0 w-[105px] aspect-[16/9] overflow-hidden bg-slate-100 rounded-sm">
                                        {post.data.heroImage ? (
                                            <Image src={post.data.heroImage} alt="" width={300} height={169} class="w-full h-full object-cover group-hover:opacity-90 transition-opacity" />
                                        ) : getFallbackImage(post.body || "") ? (
                                            <img src={getFallbackImage(post.body || "")} alt="" class="w-full h-full object-cover group-hover:opacity-90 transition-opacity" />
                                        ) : (
                                            <div class="w-full h-full bg-slate-200 flex items-center justify-center text-slate-400">IMG</div>
                                        )}
                                    </div>
                                    <div class="flex flex-col flex-1">
                                        <div class="text-[9px] font-bold text-[#b91c1c] uppercase tracking-wider mb-0.5 font-sans">
                                            {post.data.tags && post.data.tags.length > 0 ? getDisplayTag(post.data.tags[0]) : "LAJM"}
                                        </div>
                                        <h3 class="font-serif text-[14px] font-normal text-black leading-snug group-hover:underline decoration-1 underline-offset-2 transition-all">
                                            {post.data.title}
                                        </h3>
                                    </div>
                                </a>
                            </article>
                        ))}
                    </div>

                    {/* Paginimi Mobile (Tekst) */}
                    <div class="flex w-full justify-between items-center text-[12px] font-bold font-sans uppercase tracking-widest text-slate-500 mt-8 border-t border-black pt-6 px-1">
                        {page.url.prev ? (
                            <a href={page.url.prev} class="hover:text-black transition-colors">&larr; Të reja</a>
                        ) : <span class="opacity-50">&larr; Të reja</span>}
                        <span class="text-slate-400 font-normal">Faqja {page.currentPage}</span>
                        {page.url.next ? (
                            <a href={page.url.next} class="hover:text-black transition-colors">Të vjetra &rarr;</a>
                        ) : <span class="opacity-50">Të vjetra &rarr;</span>}
                    </div>
                </>
            )}
        </div>


        {/* ========================================== */}
        {/* 2. VERSIONI PËR DESKTOP (Gridi me 3 kolona)  */}
        {/* ========================================== */}
        <div class="hidden lg:flex flex-col w-full max-w-[1400px] mx-auto px-8 py-12">
            
            {allPosts.length === 0 ? (
                <p class="text-slate-500 italic font-serif text-lg text-center mt-10">Nuk u gjetën lajme në këtë kategori.</p>
            ) : (
                <>
                    {/* BLLOKU SIPËR: 2 Lajmet Gjigante */}
                    <div class="grid grid-cols-2 gap-10 mb-10">
                        {desktopTopTwo.map((post: any) => (
                            <article class="group">
                                <a href={getPostUrl(post.slug || "")} class="no-underline text-inherit block">
                                    <div class="w-full aspect-[16/9] overflow-hidden rounded-sm bg-slate-100 mb-3 shadow-sm">
                                        {post.data.heroImage ? (
                                            <Image src={post.data.heroImage} alt="" width={800} height={450} class="w-full h-full object-cover group-hover:opacity-90 transition-opacity" />
                                        ) : getFallbackImage(post.body || "") ? (
                                            <img src={getFallbackImage(post.body || "")} alt="" class="w-full h-full object-cover group-hover:opacity-90 transition-opacity" />
                                        ) : (
                                            <div class="w-full h-full bg-slate-200 flex items-center justify-center text-slate-400">IMG</div>
                                        )}
                                    </div>

                                    <div class="flex flex-col mt-4">
                                        <div class="text-[11px] font-black text-[#DC2626] uppercase tracking-widest mb-1.5 font-sans">
                                            {post.data.tags && post.data.tags.length > 0 ? getDisplayTag(post.data.tags[0]) : "LAJM"}
                                        </div>
                                        <h3 class="text-[24px] xl:text-[28px] font-serif font-black text-slate-900 leading-tight group-hover:underline decoration-2 underline-offset-4 transition-all">
                                            {post.data.title}
                                        </h3>
                                    </div>
                                </a>
                            </article>
                        ))}
                    </div>

                    {/* Viza Ndarëse Masive */}
                    <div class="w-full border-t border-slate-300 mb-10"></div>

                    {/* BLLOKU POSHTË: Rrjeta me 3 Kolona fiks me lajmet e kategorisë */}
                    <div class="grid grid-cols-3 divide-x divide-slate-300 mb-12">
                        
                        {/* Kolona 1 */}
                        <div class="flex flex-col gap-6 pr-8">
                            {desktopColOne.map((post: any) => (
                                <article class="group !p-0">
                                    <a href={getPostUrl(post.slug || "")} class="no-underline text-inherit flex items-start gap-4">
                                        <div class="shrink-0 w-[100px] xl:w-[120px] aspect-[4/3] overflow-hidden bg-slate-100 rounded-sm shadow-sm">
                                            {post.data.heroImage ? (
                                                <Image src={post.data.heroImage} alt="" width={300} height={225} class="w-full h-full object-cover group-hover:opacity-90 transition-opacity" />
                                            ) : getFallbackImage(post.body || "") ? (
                                                <img src={getFallbackImage(post.body || "")} alt="" class="w-full h-full object-cover group-hover:opacity-90 transition-opacity" />
                                            ) : (
                                                <div class="w-full h-full bg-slate-200 flex items-center justify-center text-slate-400">IMG</div>
                                            )}
                                        </div>
                                        <div class="flex flex-col flex-1 mt-0.5">
                                            <div class="text-[10px] font-black text-[#DC2626] uppercase tracking-widest mb-1 font-sans">
                                                {post.data.tags && post.data.tags.length > 0 ? getDisplayTag(post.data.tags[0]) : "LAJM"}
                                            </div>
                                            <h3 class="font-serif text-[14px] xl:text-[15px] font-normal text-slate-900 leading-snug group-hover:underline decoration-1 underline-offset-2 transition-all line-clamp-3">
                                                {post.data.title}
                                            </h3>
                                        </div>
                                    </a>
                                </article>
                            ))}
                        </div>

                        {/* Kolona 2 */}
                        <div class="flex flex-col gap-6 px-8">
                            {desktopColTwo.map((post: any) => (
                                <article class="group !p-0">
                                    <a href={getPostUrl(post.slug || "")} class="no-underline text-inherit flex items-start gap-4">
                                        <div class="shrink-0 w-[100px] xl:w-[120px] aspect-[4/3] overflow-hidden bg-slate-100 rounded-sm shadow-sm">
                                            {post.data.heroImage ? (
                                                <Image src={post.data.heroImage} alt="" width={300} height={225} class="w-full h-full object-cover group-hover:opacity-90 transition-opacity" />
                                            ) : getFallbackImage(post.body || "") ? (
                                                <img src={getFallbackImage(post.body || "")} alt="" class="w-full h-full object-cover group-hover:opacity-90 transition-opacity" />
                                            ) : (
                                                <div class="w-full h-full bg-slate-200 flex items-center justify-center text-slate-400">IMG</div>
                                            )}
                                        </div>
                                        <div class="flex flex-col flex-1 mt-0.5">
                                            <div class="text-[10px] font-black text-[#DC2626] uppercase tracking-widest mb-1 font-sans">
                                                {post.data.tags && post.data.tags.length > 0 ? getDisplayTag(post.data.tags[0]) : "LAJM"}
                                            </div>
                                            <h3 class="font-serif text-[14px] xl:text-[15px] font-normal text-slate-900 leading-snug group-hover:underline decoration-1 underline-offset-2 transition-all line-clamp-3">
                                                {post.data.title}
                                            </h3>
                                        </div>
                                    </a>
                                </article>
                            ))}
                        </div>

                        {/* Kolona 3 */}
                        <div class="flex flex-col gap-6 pl-8">
                            {desktopColThree.map((post: any) => (
                                <article class="group !p-0">
                                    <a href={getPostUrl(post.slug || "")} class="no-underline text-inherit flex items-start gap-4">
                                        <div class="shrink-0 w-[100px] xl:w-[120px] aspect-[4/3] overflow-hidden bg-slate-100 rounded-sm shadow-sm">
                                            {post.data.heroImage ? (
                                                <Image src={post.data.heroImage} alt="" width={300} height={225} class="w-full h-full object-cover group-hover:opacity-90 transition-opacity" />
                                            ) : getFallbackImage(post.body || "") ? (
                                                <img src={getFallbackImage(post.body || "")} alt="" class="w-full h-full object-cover group-hover:opacity-90 transition-opacity" />
                                            ) : (
                                                <div class="w-full h-full bg-slate-200 flex items-center justify-center text-slate-400">IMG</div>
                                            )}
                                        </div>
                                        <div class="flex flex-col flex-1 mt-0.5">
                                            <div class="text-[10px] font-black text-[#DC2626] uppercase tracking-widest mb-1 font-sans">
                                                {post.data.tags && post.data.tags.length > 0 ? getDisplayTag(post.data.tags[0]) : "LAJM"}
                                            </div>
                                            <h3 class="font-serif text-[14px] xl:text-[15px] font-normal text-slate-900 leading-snug group-hover:underline decoration-1 underline-offset-2 transition-all line-clamp-3">
                                                {post.data.title}
                                            </h3>
                                        </div>
                                    </a>
                                </article>
                            ))}
                        </div>

                    </div>

                    {/* Paginimi Desktop (Pill Elegante e Lemzës) */}
                    <div class="flex justify-center w-full mb-8">
                        <div class="inline-flex items-center bg-white border border-slate-200 p-0.5 rounded-full shadow-sm">
                            {page.url.prev ? (
                                <a href={page.url.prev} class="flex items-center justify-center gap-1.5 px-6 py-2.5 rounded-full bg-transparent text-slate-700 hover:bg-[#DC2626] hover:text-white transition-all group whitespace-nowrap">
                                    <span class="text-xs group-hover:-translate-x-1 transition-transform">&larr;</span> 
                                    <span class="font-black text-xs uppercase tracking-wider">Të reja</span>
                                </a>
                            ) : (
                                <span class="flex items-center justify-center gap-1.5 px-6 py-2.5 rounded-full text-slate-300 whitespace-nowrap cursor-not-allowed">
                                    <span class="text-xs">&larr;</span> 
                                    <span class="font-black text-xs uppercase tracking-wider">Të reja</span>
                                </span>
                            )}

                            <div class="w-px h-5 bg-slate-200 mx-1"></div>

                            <span class="flex items-center justify-center px-5 font-black text-slate-800 text-sm whitespace-nowrap">
                                {page.currentPage} <span class="text-slate-400 font-medium mx-1.5">nga</span> {page.lastPage}
                            </span>

                            <div class="w-px h-5 bg-slate-200 mx-1"></div>

                            {page.url.next ? (
                                <a href={page.url.next} class="flex items-center justify-center gap-1.5 px-6 py-2.5 rounded-full bg-transparent text-slate-700 hover:bg-[#DC2626] hover:text-white transition-all group whitespace-nowrap">
                                    <span class="font-black text-xs uppercase tracking-wider">Të vjetra</span> 
                                    <span class="text-xs group-hover:translate-x-1 transition-transform">&rarr;</span>
                                </a>
                            ) : (
                                <span class="flex items-center justify-center gap-1.5 px-6 py-2.5 rounded-full text-slate-300 whitespace-nowrap cursor-not-allowed">
                                    <span class="font-black text-xs uppercase tracking-wider">Të vjetra</span> 
                                    <span class="text-xs">&rarr;</span>
                                </span>
                            )}
                        </div>
                    </div>
                </>
            )}
        </div>

        <Footer />
    </body>
</html>