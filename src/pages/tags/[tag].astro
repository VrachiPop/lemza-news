				color: #111827;
				margin: 0 0 0.75rem 0;
				line-height: 1.3;
			}

            .card-meta {
                font-size: 0.8rem;
                color: #666;
                margin-bottom: 1rem;
                display: flex;
                align-items: center;
                gap: 6px;
            }
            
            /* STRICT ICON SIZING */
            .meta-icon { 
                width: 16px; 
                height: 16px; 
                min-width: 16px; 
                opacity: 0.7; 
            }
			
			.read-more {
				margin-top: auto; color: #1f2937; text-decoration: none; font-weight: 800;
				font-size: 0