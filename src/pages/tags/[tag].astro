---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Sidebar from '../../components/Sidebar.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import FormattedDate from '../../components/FormattedDate.astro';
import EditorialBanner from '../../components/EditorialBanner.astro';
import { Image } from 'astro:assets';
import '../../app.css';

// --- LOGJIKA STATIKE (getStaticPaths) ---
export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  
  // 1. Gjej tag-et unike dhe pastroji
  const uniqueTags = [...new Set(allPosts
    .map((post) => post.data.tags)
    .flat()
    .filter(tag => tag) // Heqim vlerat null/undefined
    .map(tag => tag.toLowerCase().trim()) 
  )];

  // 2. Gjenero faqet për secilin tag
  return uniqueTags.map((tag) => {
    // Filtro postimet për këtë tag specifik dhe renditi (Më e reja -> Më e vjetra)
    const filteredPosts = allPosts
      .filter((post) => post.data.tags?.some(t => t.toLowerCase().trim() === tag))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
    
    return {
      params: { tag: tag },
      props: { posts: filteredPosts },
    };
  });
}

// --- MARRJA E TË DHËNAVE DHE NDARJA ---
const { tag } = Astro.params;
const { posts } = Astro.props; 

// I pari fare është "Featured"
const featuredPost = posts[0];
// Të tjerët (nga i dyti e tutje) janë lista
const restPosts = posts.slice(1);

// --- DICTIONARY (Përkthimet) ---
const tagNames = {
    'politike': 'Politikë', 'ekonomi': 'Ekonomi', 'showbiz': 'Showbiz',
    'kronike': 'Kronikë', 'sport': 'Sport', 'kulture': 'Kulturë',
    'tekno-shkence': 'Tekno & Shkencë', 'shendeti': 'Shëndeti',
    'rajoni': 'Rajoni', 'bota': 'Bota', 'sociale': 'Sociale'
};

const capitalize = (s: any) => s && s[0].toUpperCase() + s.slice(1);
const cleanTag = tag.toLowerCase().trim(); 
const pageTitle = (tagNames as any)[cleanTag] || capitalize(cleanTag);

// --- HELPER FUNKSIONE ---
function getPostUrl(slug: string) {
    const cleanSlug = slug.split('/').pop()?.replace(/\.md$/, '') || slug;
    return `/${cleanSlug}/`;
}

function getFallbackImage(body: string) {
    const imageMatch = body.match(/!\[.*?\]\((.*?)\)/);
    return imageMatch ? imageMatch[1] : null;
}
---

<!doctype html>
<html lang="sq">
    <head>
        <BaseHead title={`${pageTitle} - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
        <style>
             html, body {
                background-color: #F8FAFC;
                color: #1e293b;
            }
        </style>
    </head>
    <body>
        <Header />
        
        <EditorialBanner title={pageTitle} />

        <div class="w-full max-w-[1600px] mx-auto px-4 pt-6 md:px-8 py-12 grid grid-cols-1 lg:grid-cols-12 gap-12">
            
            <main class="lg:col-span-8">

                {posts.length === 0 ? (
                    <p class="text-slate-500 italic font-serif text-lg">Nuk u gjetën lajme në këtë kategori.</p>
                ) : (
                    <>
                        {/* FEATURED POST (Lajmi Kryesor i Tag-ut) */}
                        {featuredPost && (
                            <article class="group mb-12 pb-12 border-b border-slate-200">
                                <a href={getPostUrl(featuredPost.slug)} class="no-underline text-inherit block">
                                    
                                    <div class="relative w-full aspect-[16/9] overflow-hidden rounded-xl shadow-sm mb-6 bg-slate-100">
                                        {featuredPost.data.heroImage ? (
                                            <Image 
                                                src={featuredPost.data.heroImage} 
                                                alt={featuredPost.data.title} 
                                                width={1000}   
                                                height={600}
                                                class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-700 ease-out" 
                                            />
                                        ) : getFallbackImage(featuredPost.body) ? (
                                            <img 
                                                src={getFallbackImage(featuredPost.body)} 
                                                alt="" 
                                                class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-700 ease-out" 
                                            />
                                        ) : (
                                            <div class="w-full h-full bg-slate-200 flex items-center justify-center text-slate-400">IMG</div>
                                        )}

                                        <span class="absolute top-4 left-4 bg-[#DC2626] text-white text-xs font-black uppercase tracking-widest px-4 py-1.5 rounded-md shadow-lg z-10">
                                            {featuredPost.data.tags && featuredPost.data.tags.length > 0 ? ((tagNames as any)[featuredPost.data.tags[0].toLowerCase().trim()] || featuredPost.data.tags[0]) : 'LAJM'}
                                        </span>
                                    </div>

                                    <div class="flex flex-col gap-3">
                                        <div class="flex items-center gap-3 text-xs font-bold text-slate-400 uppercase tracking-widest">
                                            <FormattedDate date={featuredPost.data.pubDate} />
                                            <span class="text-[#DC2626]">&bull;</span>
                                            <span class="text-[#DC2626]">Kryesore</span>
                                        </div>

                                        <h3 class="text-3xl md:text-4xl font-serif font-black text-slate-900 leading-tight group-hover:text-[#0f172a] group-hover:underline decoration-4 underline-offset-8 transition-all">
                                            {featuredPost.data.title}
                                        </h3>

                                        <p class="text-lg text-slate-600 leading-relaxed line-clamp-3 font-sans mt-2">
                                            {featuredPost.data.description}
                                        </p>
                                    </div>
                                </a>
                            </article>
                        )}

                        {/* LISTA E LAJMEVE TË TJERA TË KËTIJ TAG-U */}
                        <div class="flex flex-col divide-y divide-slate-200">
                            {restPosts.map((post) => (
                                <article class="group py-8 first:pt-0">
                                    <a href={getPostUrl(post.slug)} class="no-underline text-inherit grid grid-cols-1 md:grid-cols-12 gap-6 items-start">
                                        
                                        <div class="md:col-span-4 lg:col-span-5 relative aspect-[16/10] overflow-hidden rounded-lg bg-slate-100 shadow-sm">
                                            {post.data.heroImage ? (
                                                <Image 
                                                    src={post.data.heroImage} 
                                                    alt={post.data.title} 
                                                    width={500}   
                                                    height={300} 
                                                    class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-700 ease-out"
                                                />
                                            ) : getFallbackImage(post.body) ? (
                                                <img 
                                                    src={getFallbackImage(post.body)} 
                                                    alt="" 
                                                    class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-700 ease-out" 
                                                />
                                            ) : (
                                                <div class="w-full h-full bg-slate-200 flex items-center justify-center text-slate-400">IMG</div>
                                            )}
                                            
                                            <span class="absolute top-3 left-3 bg-[#DC2626] text-white text-[10px] font-black uppercase tracking-widest px-3 py-1 rounded-md shadow-md z-10">
                                                {post.data.tags && post.data.tags.length > 0 ? ((tagNames as any)[post.data.tags[0].toLowerCase().trim()] || post.data.tags[0]) : 'LAJM'}
                                            </span>
                                        </div>

                                        <div class="md:col-span-8 lg:col-span-7 flex flex-col justify-between h-full">
                                            <div>
                                                <div class="flex items-center gap-2 mb-2 text-[11px] font-bold text-slate-400 uppercase tracking-widest">
                                                    <FormattedDate date={post.data.pubDate} />
                                                </div>

                                                <h3 class="text-xl font-serif font-bold text-slate-800 leading-tight mb-2 group-hover:text-[#0f172a] group-hover:underline decoration-2 underline-offset-4 transition-colors">
                                                    {post.data.title}
                                                </h3>

                                                <p class="text-slate-600 text-sm leading-relaxed line-clamp-2 font-sans">
                                                    {post.data.description}
                                                </p>
                                            </div>
                                            
                                            <div class="mt-3 md:mt-auto pt-2 flex items-center text-[#0f172a] font-bold text-xs uppercase tracking-widest opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300">
                                                Lexo të plotë &rarr;
                                            </div>
                                        </div>
                                    </a>
                                </article>
                            ))}
                        </div>
                    </>
                )}
            </main>

            <aside class="lg:col-span-4 lg:pl-10 border-l border-slate-200 hidden lg:block">
                <div class="sticky top-24">
                    <Sidebar />
                </div>
            </aside>
        </div>

        <Footer />
    </body>
</html>