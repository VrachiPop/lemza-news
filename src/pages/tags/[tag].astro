                font-size: 2.5rem;
                font-weight: 800;
                margin-bottom: 2rem;
                text-transform: uppercase;
                border-bottom: 2px solid #ff0033;
                display: inline-block;
                padding-bottom: 5px;
                color: #343a46;
            }

			.news-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 2rem;
			}

