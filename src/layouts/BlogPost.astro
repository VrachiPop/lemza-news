/* --- FIX FOR GIANT IMAGES --- */
	/* This forces all images inside the article to fit the screen */
	.prose img, article img {
		max-width: 100%;
		height: auto;
		border-radius: 8px; /* Optional: adds nice rounded corners */
		display: block;
		margin: 20px auto; /* Centers the image */
	}
	
	/* Also fixes the main hero image at the top */
	.hero-image img {
		max-width: 100%;
		height: auto;
		border-radius: 12px;
	}