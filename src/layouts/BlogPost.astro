---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		<style>
			/* --- 1. GLOBAL RESET --- */
			*, *::before, *::after {
				box-sizing: border-box;
			}

			body {
				margin: 0;
				padding: 0;
				width: 100%;
				overflow-x: hidden;
			}

			/* --- 2. MAIN CONTAINER --- */
			main {
				width: 100%;
				max-width: 900px;
				margin: 0 auto;
				padding: 20px;
			}

			/* --- 3. HERO IMAGE --- */
			.hero-image {
				width: 100%;
				margin-top: 1rem;
				margin-bottom: 2rem;
			}
			
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 8px;
				box-shadow: 0 4px 10px rgba(0,0,0,0.1);
				width: 100%;
				height: auto;
				object-fit: cover;
			}

			/* --- 4. TYPOGRAPHY --- */
			.prose {
				width: 100%;
				line-height: 1.6;
				color: #333;
				font-size: 1.1rem;
				text-align: justify; 
				hyphens: auto;       
			}
			
			.title {
				margin-bottom: 0.5em; 
				padding: 1em 0 0.5em 0;
				text-align: center;
				border-bottom: 1px solid #ddd;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
				font-size: 2.2rem;
				font-weight: 800;
				line-height: 1.2;
			}
			.date {
				margin-bottom: 0.5em;
				color: #666;
				font-size: 0.9rem;
			}

			/* --- 5. IMAGES INSIDE TEXT --- */
			.prose :global(img) {
				max-width: 100%;
				height: auto;
				border-radius: 8px;
				display: block;
				margin: 20px auto;
			}

            /* --- 6. ARTICLE DISCLAIMER (NEW) --- */
            .article-disclaimer {
                background-color: #fff5f5; /* Light Red Background */
                border-left: 5px solid #ff0033; /* The Red Line */
                padding: 1.5rem;
                margin-top: 4rem;  /* Space between article and disclaimer */
                margin-bottom: 1rem;
                border-radius: 4px;
                font-size: 0.95rem;
                color: #7f1d1d;
                line-height: 1.5;
            }
            .article-disclaimer strong {
                display: block;
                text-transform: uppercase;
                margin-bottom: 0.5rem;
                color: #c53030;
                font-weight: 800;
            }
			
			/* --- 7. MOBILE SPECIFIC --- */
			@media (max-width: 720px) {
				main {
					padding: 1rem;
				}
				.title h1 {
					font-size: 1.6rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<article>
				<div class="prose">
					
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{updatedDate && <div class="last-updated-on">
								Last updated on <FormattedDate date={updatedDate} />
							</div>}
						</div>
						<h1>{title}</h1>
					</div>

					<div class="hero-image">
						{heroImage && <img width={1020} height={510} src={heroImage} alt="" />}
					</div>

                    <slot />
					
                    <div class="article-disclaimer">
                        <strong>Mohim i Përgjegjësisë (Disclaimer)</strong>
                        <p style="margin: 0;">
                            Lemza News është një faqe satirike interneti. Artikujt, historitë dhe përmbajtja e publikuar në këtë faqe janë pjellë e imagjinatës ose parodi të ngjarjeve reale. Emrat e përdorur, përveç atyre të figurave publike të cilët janë subjekt i satirës, janë fiktivë. Çdo ngjashmëri me persona realë, të gjallë apo të vdekur, është krejtësisht e rastësishme. Përmbajtja nuk duhet të merret si faktike apo serioze.
                        </p>
                    </div>

				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>