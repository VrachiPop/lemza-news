---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { Image } from 'astro:assets';
import '../app.css';

interface Props {
    title: string;
    description?: string; 
    pubDate: Date;
    updatedDate?: Date;
    heroImage?: any; 
    tags?: string[];
}

const { title, description = "Lemza News - Lajme satirike.", pubDate, updatedDate, heroImage, tags } = Astro.props;

const tagNames: Record<string, string> = {
    'politike': 'Politikë', 'ekonomi': 'Ekonomi', 'showbiz': 'Showbiz',
    'kronike': 'Kronikë', 'sport': 'Sport', 'kulture': 'Kulturë',
    'tekno-shkence': 'Tekno & Shkencë', 'shendeti': 'Shëndeti',
    'rajoni': 'Rajoni', 'bota': 'Bota'
};

function getDisplayTag(tag: string) {
    if (!tag) return 'LAJME';
    const cleanTag = tag.trim().toLowerCase();
    return tagNames[cleanTag] || (tag.charAt(0).toUpperCase() + tag.slice(1));
}
---

<!doctype html>
<html lang="sq">
    <head>
        <BaseHead title={title} description={description} image={heroImage} />
        <style is:global>
            body { margin: 0; padding: 0; }
            
            /* SKELETI NGA PRIVACY.ASTRO */
            .page-container {
                width: 100%;
                max-width: 1600px;
                margin: 0 auto;
                padding: 3rem 1rem;
                display: grid;
                grid-template-columns: 1fr;
                gap: 3rem;
                box-sizing: border-box;
            }
            .sidebar-wrapper { display: none; }

            @media (min-width: 1024px) {
                .page-container {
                    grid-template-columns: 8fr 4fr;
                    padding: 4rem 2rem;
                }
                .sidebar-wrapper {
                    display: block;
                    padding-left: 2.5rem;
                    border-left: 1px solid #e5e7eb;
                }
            }

            /* STILI I ARTIKULLIT (Nga biseda jonë e mëparshme) */
            .lemza-artikull {
                word-wrap: break-word;
                overflow-wrap: break-word;
                width: 100%;
                max-width: 100%;
            }
            .lemza-artikull p {
                margin-bottom: 1.5rem;
                text-align: justify;
                font-size: 1.2rem;
                line-height: 1.8;
                color: #1e293b;
                font-family: 'Literata', Georgia, serif;
            }
            .lemza-artikull h2, .lemza-artikull h3 {
                margin-top: 2.5rem;
                margin-bottom: 1rem;
                font-weight: 800;
                color: #0f172a;
                line-height: 1.3;
                font-family: 'Literata', Georgia, serif;
            }
            .lemza-artikull img, .lemza-artikull iframe, .lemza-artikull video {
                max-width: 100% !important;
                height: auto !important;
                border-radius: 0.5rem;
                margin: 2rem auto;
                display: block;
            }
            .lemza-artikull p:last-of-type::after {
                content: "L"; 
                display: inline-block;
                background-color: #DC2626;
                color: white;
                font-weight: 900;
                font-size: 12px;
                padding: 0px 6px;
                border-radius: 2px;
                margin-left: 8px;
                vertical-align: middle;
            }
        </style>
    </head>
    <body class="bg-white overflow-x-hidden w-full">  
        <Header />
        
        <div class="relative w-full bg-[#0f172a] pt-32 pb-10 md:pt-36 md:pb-12 mt-0 overflow-hidden box-border">
            {heroImage && (
                <div class="absolute inset-0 z-0">
                    <Image width={1600} height={900} src={heroImage} alt="" class="w-full h-full object-cover opacity-25 mix-blend-luminosity blur-sm scale-105" />
                </div>
            )}
            <div class="absolute inset-0 bg-gradient-to-b from-[#0f172a]/80 via-transparent to-[#0f172a] pointer-events-none z-0"></div>

            <div class="relative max-w-[1600px] mx-auto px-4 md:px-8 z-10 box-border">
                <div class="flex flex-wrap items-center gap-2 text-[11px] md:text-xs font-black uppercase tracking-tight mb-4 md:mb-6">
                    {tags && tags.length > 0 ? (
                        tags.map((tag) => (
                            <div class="flex items-center gap-2"><span class="text-[#DC2626] font-bold">/</span> <span class="text-slate-200">{getDisplayTag(tag)}</span></div>
                        ))
                    ) : (
                        <div class="flex items-center gap-2"><span class="text-[#DC2626] font-bold">/</span> <span class="text-[#DC2626]">LAJME</span></div>
                    )}
                </div>
                <h1 class="font-serif font-black text-2xl md:text-3xl lg:text-4xl text-white mb-8 leading-[1.1] tracking-tight max-w-5xl drop-shadow-md break-words">{title}</h1>
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 border-t border-slate-700/50 pt-6 mt-8">
                    <div class="flex flex-wrap items-center gap-2 text-slate-100 text-[10px] md:text-[11px] lg:text-[12px] font-black uppercase tracking-widest break-words">
                        <FormattedDate date={pubDate} /><span class="text-slate-600">|</span><span>Nga: <span class="text-slate-200">Redaksia Lemza</span></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="page-container">
            <main style="min-width: 0;">
                <article class="w-full overflow-hidden box-border">
                    <header class="mb-8 w-full">
                        {heroImage && (
                            <div class="relative w-full aspect-video rounded-lg overflow-hidden bg-slate-50 shadow-sm mb-8">
                                <Image width={1200} height={675} src={heroImage} alt={title || ""} class="absolute inset-0 w-full h-full object-cover" />
                            </div>
                        )}
                    </header>

                    <div class="lemza-artikull">
                        <slot />
                    </div>
                    
                    <div class="mt-16 p-6 bg-slate-50 border-l-4 border-[#DC2626] rounded-r-lg w-full box-border">
                        <h4 class="text-[#DC2626] font-black text-xs uppercase tracking-widest mb-2">Mohim Përgjegjësie</h4>
                        <p class="text-slate-600 text-sm leading-relaxed m-0 italic font-sans break-words">
                            Lemza News është një publikim satirik. Artikujt, historitë dhe përmbajtja e publikuar në këtë faqe janë pjellë e imagjinatës ose parodi të ngjarjeve reale. Emrat e përdorur, përveç atyre të figurave publike të cilët janë subjekt i satirës, janë fiktivë. Çdo ngjashmëri me persona realë, të gjallë apo të vdekur, është krejtësisht e rastësishme. Përmbajtja nuk duhet të merret si faktike apo serioze.
                        </p>
                    </div>
                </article>
            </main>

            <aside class="sidebar-wrapper">
                <div style="position: sticky; top: 2rem;">
                    <Sidebar />
                </div>
            </aside>
        </div>

        <Footer />
    </body>
</html>