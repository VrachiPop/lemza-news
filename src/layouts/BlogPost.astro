---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import FormattedDate from '../components/FormattedDate.astro';
import '../app.css';

/* --- RREGULLIMI 1: Bëjmë description opsional me pikëpyetje (?) --- */
interface Props {
	title: string;
	description?: string; 
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: string;
	tags?: string[];
}

const { 
    title, 
    /* --- RREGULLIMI 2: I japim një vlerë automatike nëse mungon --- */
    description = "Lemza News - Lajme satirike dhe humor nga rajoni.",
    pubDate, 
    updatedDate, 
    heroImage, 
    tags 
} = Astro.props;

/* --- RREGULLIMI 3: E deklarojmë si Record<string, string> që të mos japë error --- */
const tagNames: Record<string, string> = {
    'politike': 'Politikë',
    'ekonomi': 'Ekonomi',
    'showbiz': 'Showbiz',
    'kronike': 'Kronikë',   
    'sport': 'Sport',
    'kulture': 'Kulturë',
    'tekno-shkence': 'Tekno & Shkencë',
    'shendeti': 'Shëndeti',
    'rajoni': 'Rajoni',
    'bota': 'Bota'
};

function getDisplayTag(tag: string) {
    if (!tag) return 'LAJME';
    const cleanTag = tag.trim().toLowerCase();
    return tagNames[cleanTag] || (tag.charAt(0).toUpperCase() + tag.slice(1));
}

---

<html lang="sq">
    <head>
        <BaseHead title={title} description={description} image={heroImage} />
        <style>
            .prose {
                width: 100%;
                line-height: 1.8;
                color: #334155;
                font-size: 1.1rem;
				text-align: justify;
                hyphens: auto;
                -webkit-hyphens: auto;
            }
            .prose p { margin-bottom: 1.5em; }
            .prose h2, .prose h3 {
                color: #0f172a; font-weight: 900; margin-top: 2em; margin-bottom: 1em;
                text-transform: uppercase; letter-spacing: -0.02em;
            }
            .prose ul, .prose ol { margin-bottom: 1.5em; padding-left: 1rem; }
            .prose li { margin-bottom: 0.5em; }
            .article-disclaimer {
                background-color: #fef2f2; border-left: 4px solid #DC2626;
                padding: 1.5rem; margin-top: 4rem; border-radius: 0 4px 4px 0;
                font-size: 0.95rem; color: #7f1d1d; line-height: 1.6;
            }
            .article-disclaimer strong {
                display: block; text-transform: uppercase; margin-bottom: 0.5rem;
                color: #DC2626; font-weight: 800; letter-spacing: 0.05em;
            }
            .prose :global(img) {
                max-width: 100%; height: auto; border-radius: 8px;
                display: block; margin: 2rem auto; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            }
            /* Shtoje këtë te pjesa <style> në krye të skedarit */

            /* --- Shto këtë te pjesa <style> --- */

            /* Përdorim :global() për të kapur paragrafin brenda artikullit */
            .prose :global(p:last-of-type)::after {
                content: "L"; 
                display: inline-block;
                background-color: #DC2626; /* E kuqe */
                color: white;
                font-weight: 900;
                font-size: 11px;
                line-height: 1.4;
                padding: 1px 6px;
                border-radius: 2px;
                margin-left: 8px; /* Hapësira nga pika */
                vertical-align: middle;
                position: relative;
                top: -1px;
                box-shadow: 0 1px 2px rgba(220, 38, 38, 0.3);
            }
			.article-end-signoff {
       			display: flex;
				align-items: center;
				justify-content: center;
				gap: 1.5rem;
				margin: 1.5rem 0; /* Hapësirë sipër dhe poshtë ikonës */
				opacity: 0.8;
    		}

			.signoff-line {
				height: 1px;
				flex: 1;
				background: linear-gradient(to right, transparent, #e2e8f0, transparent);
			}

			.signoff-icon .logo-box {
				background-color: #DC2626;
				color: white;
				font-weight: 900;
				font-size: 1rem;
				width: 28px;
				height: 28px;
				display: flex;
				align-items: center;
				justify-content: center;
				border-radius: 3px;
				box-shadow: 0 2px 4px rgba(220, 38, 38, 0.2);
			}
        </style>
    </head>
    
    <body class="bg-[#F1F5F9]">
        <Header />
        
        <div class="w-full max-w-[1600px] mx-auto px-4 md:px-6 py-10 grid grid-cols-1 lg:grid-cols-12 gap-12">
            
            <main class="lg:col-span-8">
                <article class="bg-white p-6 md:p-12 rounded-xl border border-slate-200 shadow-sm">
                    
                    <div class="mb-6 border-b border-slate-300 pb-2">
                        <div class="flex items-center gap-2 text-sm font-bold text-slate-400 mb-6 uppercase tracking-widest">
                            <span class="text-[#DC2626] font-black">/</span> 
                            
                            {tags && tags.length > 0 ? (
            	tags.map((tag, index) => (
                <>
                    <span class="hover:text-[#DC2626] transition-colors cursor-default">
                        {getDisplayTag(tag)}
                    </span>
                    {index < tags.length - 1 && <span class="text-slate-300">•</span>}
                </>
            ))
        ) : (
            <span>LAJME</span>
        )}
                            
                            <span class="text-slate-300 mx-2">|</span>
                            <FormattedDate date={pubDate} />
                            {updatedDate && (
                                <span class="italic text-slate-300 ml-1 text-xs normal-case">(Përditësuar)</span>
                            )}
                        </div>
                        
                        <h1 class="text-2xl! md:text-4xl lg:text-5xl font-black text-slate-900 mb-4! leading-tight tracking-tight">
                            {title}
                        </h1>

                        {heroImage && (
                            <div class="rounded-xl overflow-hidden shadow-md mb-6 border border-slate-100">
                                <img width={1020} height={510} src={heroImage} alt="" class="w-full h-auto object-cover" />
                            </div>
                        )}
                    </div>

                    <div class="prose prose-slate max-w-none 
    prose-p:my-3!        prose-ul:my-2       prose-li:my-0       prose-headings:mt-6 prose-headings:mb-3">
    
    <slot />
                    </div>
                    
                    <div class="article-disclaimer">
                        <strong>Mohim i Përgjegjësisë (Disclaimer)</strong>
                        <p style="margin: 0;">
                            Lemza News është një faqe satirike interneti. Artikujt, historitë dhe përmbajtja e publikuar në këtë faqe janë pjellë e imagjinatës ose parodi të ngjarjeve reale. Emrat e përdorur, përveç atyre të figurave publike të cilët janë subjekt i satirës, janë fiktivë. Çdo ngjashmëri me persona realë, të gjallë apo të vdekur, është krejtësisht e rastësishme. Përmbajtja nuk duhet të merret si faktike apo serioze.
                        </p>
                    </div>

                </article>
            </main>

            <aside class="lg:col-span-4 lg:pl-10 border-l border-slate-200 hidden lg:block">
                <div class="sticky top-8">
                    <Sidebar />
                </div>
            </aside>

        </div>

        <Footer />
    </body>
</html>