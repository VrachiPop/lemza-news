---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import "../app.css";

// Importi i trurit qendror për kategoritë dhe url
import { getDisplayTag, getPostUrl } from "../utils/helpers";

interface Props {
    title: string;
    description?: string;
    pubDate: Date;
    updatedDate?: Date;
    heroImage?: any;
    tags?: string[];
    // slug nuk na duhet më, e hoqa
}

const {
    title,
    description = "Lemza News - Lajme satirike.",
    pubDate,
    updatedDate,
    heroImage,
    tags,
} = Astro.props;

// ==========================================
// LOGJIKA PËR LAJMET E NGJASHME (Fix për lajmin aktual)
// ==========================================
// 1. Marrim të gjitha lajmet dhe i rendisim nga më i riu
const allPosts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// 2. Heqim lajmin aktual që po lexohet (Duke përdorur TITULLIN, e sigurt 100%)
const otherPosts = allPosts.filter(post => post.data.title !== title);

// 3. Gjejmë lajme që kanë TË PAKTËN NJË nga kategoritë e lajmit aktual
const currentTags = tags?.map(t => t.toLowerCase().trim()) || [];
let relatedPosts = otherPosts.filter(post => {
    const postTags = post.data.tags?.map(t => t.toLowerCase().trim()) || [];
    return postTags.some(t => currentTags.includes(t));
});

// 4. Krijojmë një "pishinë" me deri në 10 lajmet e para të ngjashme
let candidatePosts = relatedPosts.slice(0, 10);

// 5. Nëse pishina nuk ka 10 lajme, e mbushim me lajmet e tjera më të fundit
if (candidatePosts.length < 10) {
    const needed = 10 - candidatePosts.length;
    // Sigurohemi që lajmet shtesë të mos jenë tashmë në listën e kandidatëve
    const remainingPosts = otherPosts.filter(p => !candidatePosts.some(cp => cp.data.title === p.data.title));
    candidatePosts = [...candidatePosts, ...remainingPosts.slice(0, needed)];
}

// 6. Zgjedhim 3 lajme RASTËSISHT nga pishina prej 10 lajmesh
const finalRelatedPosts = [...candidatePosts]
    .sort(() => 0.5 - Math.random())
    .slice(0, 3);

// ==========================================
// LOGJIKA PËR SIDEBAR-IN E DJATHTË
// ==========================================
// 7. Përgatisim pishinën për Sidebar-in e djathtë (Të gjitha lajmet nga i 10-ti e pas)
const poolForSidebar = allPosts.slice(10).map(post => ({
    title: post.data.title,
    slug: getPostUrl(post.slug),
    heroImage: post.data.heroImage ? post.data.heroImage.src : '',
    tag: post.data.tags && post.data.tags.length > 0 ? getDisplayTag(post.data.tags[0]) : 'LAJM',
}));

---

<!DOCTYPE html>
<html lang="sq">
    <head>
        <BaseHead title={title} description={description} image={heroImage?.src || heroImage} />
        <style is:global>
            /* GLOBAL STYLES FIX */
            * {
                box-sizing: border-box;
            }
            body,
            html {
                margin: 0;
                padding: 0;
                max-width: 100vw;
                background-color: #ffffff;
            }

            .page-container {
                width: 100%;
                /* Heqim margin: 0 auto që e mbante në qendër */
                margin: 0; 
                padding: 2rem 1rem;
                display: flex;
                flex-direction: column;
                gap: 2rem;
            }

            @media (min-width: 1024px) {
                .page-container {
                    padding: 4rem 0; /* Heqim padding anësor sepse po e kontrollojmë me margin */
                    max-width: 55vw; /* Zë pak më shumë se gjysmën e ekranit */
                    margin-left: 4vw; /* Margjinë e vogël majtas (rreth 4% e ekranit) */
                }
            }

            /* STILI I ARTIKULLIT */
            .lemza-artikull {
                width: 100%;
                overflow: hidden;
                font-family: "Literata", Georgia, serif; 
            }

            /* RIKTHEJMË SAKTËSISHT PARAGRAFËT E TU ORIGJINALË */
            .lemza-artikull.prose p {
                margin-bottom: 1.5rem !important;
                text-align: justify !important;
                font-size: 1.1rem !important;
                line-height: 1.6 !important;
                color: #1e293b !important;
                word-wrap: break-word;
            }

            /* L-ja e kuqe në fund */
            .lemza-artikull p:last-of-type::after {
                content: "L";
                display: inline-block;
                background-color: #dc2626;
                color: white;
                font-weight: 900;
                font-size: 12px;
                padding: 0px 6px;
                border-radius: 2px;
                margin-left: 8px;
                vertical-align: middle;
            }
        </style>
    </head>
    <body class="overflow-x-hidden w-full">
        <Header />

        <div
            class="relative w-full bg-[#0f172a] pt-32 pb-10 md:pt-36 md:pb-12 mt-0"
        >
            {
                heroImage && (
                    <div class="absolute inset-0 z-0">
                        <Image
                            width={1600}
                            height={900}
                            src={heroImage}
                            alt=""
                            class="w-full h-full object-cover opacity-25 mix-blend-luminosity blur-sm scale-105"
                        />
                    </div>
                )
            }
            <div
                class="absolute inset-0 bg-gradient-to-b from-[#0f172a]/80 via-transparent to-[#0f172a] pointer-events-none z-0"
            >
            </div>

            <div class="relative w-full px-4 lg:px-[4vw] z-10">                    <div
                    class="flex flex-wrap items-center gap-2 text-[11px] md:text-xs font-black uppercase tracking-tight mb-4 md:mb-6"
                >
                    {
                        tags && tags.length > 0 ? (
                            tags.map((tag) => (
                                <div class="flex items-center gap-2">
                                    <span class="text-[#DC2626] font-bold">
                                        /
                                    </span>{" "}
                                    <span class="text-slate-200">
                                        {getDisplayTag(tag)}
                                    </span>
                                </div>
                            ))
                        ) : (
                            <div class="flex items-center gap-2">
                                <span class="text-[#DC2626] font-bold">/</span>{" "}
                                <span class="text-[#DC2626]">LAJME</span>
                            </div>
                        )
                    }
                </div>

                <h1
                    class="font-serif font-black text-2xl md:text-3xl lg:text-4xl text-white mb-8 leading-[1.1] tracking-tight max-w-full drop-shadow-md"
                >
                    {title}
                </h1>

                <div
                    class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 border-t border-slate-700/50 pt-6 mt-8"
                >
                    <div
                        class="flex items-center gap-2 text-slate-100 text-[10px] lg:text-[12px] font-black uppercase tracking-widest"
                    >
                        <FormattedDate date={pubDate} /><span
                            class="text-slate-600">|</span
                        ><span
                            >Nga: <span class="text-slate-200"
                                >Redaksia Lemza</span
                            >
                        </span>
                    </div>

                    <button
                        id="share-button"
                        class="shrink-0 flex items-center justify-start md:justify-center gap-2 text-[11px] font-black text-slate-300 hover:text-white uppercase tracking-widest transition-all group cursor-pointer md:bg-slate-800/50 md:hover:bg-[#DC2626] py-2 md:px-6 md:py-3 rounded-full md:border md:border-slate-700 md:hover:border-[#DC2626]"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="3"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="w-4 h-4 md:w-5 md:h-5 text-[#DC2626] md:text-current"
                        >
                            <circle cx="18" cy="5" r="3"></circle>
                            <circle cx="6" cy="12" r="3"></circle>
                            <circle cx="18" cy="19" r="3"></circle>
                            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"
                            ></line>
                            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"
                            ></line>
                        </svg>
                        {/* Hoqa klasën 'hidden' që teksti të dalë edhe në mobile */}
                        <span class="inline group-hover:underline"
                            >Shpërndaje</span
                        >
                    </button>
                </div>
            </div>
        </div>

        {/* KUTIA E RE FLEKSIBLE: Mban Artikullin Majtas dhe Sidebar-in Djathtas */}
        <div class="flex flex-col lg:flex-row w-full lg:pr-[4vw] justify-between items-start">
            
            <div class="page-container shrink-0">
                <main>
                    <article class="w-full">
                        <header class="mb-8 w-full">
                            {
                                heroImage && (
                                    <div class="relative w-full aspect-video rounded-lg overflow-hidden bg-slate-50 shadow-sm mb-8">
                                        <Image
                                            width={1200}
                                            height={675}
                                            src={heroImage}
                                            alt={title || ""}
                                            class="absolute inset-0 w-full h-full object-cover"
                                        />
                                    </div>
                                )
                            }
                        </header>

                        <div class="lemza-artikull prose prose-lg prose-slate max-w-none w-full mx-auto prose-a:text-[#DC2626]">
                            <slot />
                        </div>

                        <div
                            class="mt-16 p-6 bg-slate-50 border-l-4 border-[#DC2626] rounded-r-lg w-full box-border"
                        >
                            <h4
                                class="text-[#DC2626] font-black text-xs uppercase tracking-widest mb-2 mt-0"
                            >
                                Mohim Përgjegjësie
                            </h4>
                            <p
                                class="text-slate-600 text-sm leading-relaxed m-0 italic font-sans break-words"
                            >
                                Lemza News është një publikim satirik. Artikujt,
                                historitë dhe përmbajtja e publikuar në këtë faqe
                                janë pjellë e imagjinatës ose parodi të ngjarjeve
                                reale. Emrat e përdorur, përveç atyre të figurave
                                publike të cilët janë subjekt i satirës, janë
                                fiktivë. Çdo ngjashmëri me persona realë, të gjallë
                                apo të vdekur, është krejtësisht e rastësishme.
                                Përmbajtja nuk duhet të merret si faktike apo
                                serioze.
                            </p>
                        </div>

                        {/* ========================================== */}
                        {/* SEKSIONI "LEXO MË SHUMË"                   */}
                        {/* ========================================== */}
                        {finalRelatedPosts.length > 0 && (
                            <div class="relative mt-20 border-t-2 border-slate-800/50 pt-12 w-full">
                                
                                {/* Stema e Kuqe mbi vijën ndarëse */}
                                <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-[#0f172a] px-6 py-1.5 rounded-full shadow-sm whitespace-nowrap z-10">
                                    <span class="text-white font-black text-xs md:text-sm tracking-widest uppercase">
                                        Sugjerime për ty
                                    </span>
                                </div>
                                
                                <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                                    {finalRelatedPosts.map((post) => (
                                        <a href={getPostUrl(post.slug || "")} class="group block no-underline text-inherit">
                                            <div class="relative w-full aspect-video overflow-hidden rounded-lg shadow-sm mb-4 bg-slate-100">
                                                {post.data.heroImage ? (
                                                    <Image 
                                                        src={post.data.heroImage} 
                                                        alt={post.data.title || ""} 
                                                        width={400}   
                                                        height={225}
                                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out" 
                                                    />
                                                ) : (
                                                    <div class="w-full h-full bg-slate-200 flex items-center justify-center text-slate-400">IMG</div>
                                                )}
                                            </div>
                                            
                                            <div class="flex flex-col gap-2">
                                                <div class="flex items-center gap-2 text-[10px] font-bold text-[#DC2626] uppercase tracking-widest">
                                                    {post.data.tags && post.data.tags.length > 0 ? getDisplayTag(post.data.tags[0]) : "LAJM"}
                                                </div>
                                                <h4 class="font-serif text-base text-slate-800 leading-tight group-hover:text-[#DC2626] transition-colors line-clamp-3 m-0">
                                                    {post.data.title}
                                                </h4>
                                            </div>
                                        </a>
                                    ))}
                                </div>
                            </div>
                        )}
                    </article>
                </main>
            </div>

            {/* SIDEBAR-i I DJATHTË PËR KOMPJUTER */}
            <aside class="hidden lg:block w-[32vw] pt-[4rem] pb-12">
                <div> {/* Hoqa klasën "sticky top-24" siç kërkove */}
                    <div class="flex items-center gap-3 mb-6">
                        <h2 class="text-[15px] md:text-lg font-normal font-sans text-black tracking-tight uppercase shrink-0 m-0">
                            Më të injoruarat
                        </h2>
                        <div class="flex-1 h-[1px] bg-slate-500 mt-1"></div>
                    </div>
                    
                    {/* Këtu do të printohen 8 lajmet nga JavaScript */}
                    <div id="sidebar-random-posts" class="flex flex-col gap-5">
                        <p class="text-slate-400 italic text-sm">Po gërrmojmë arkivën...</p>
                    </div>
                </div>
            </aside>

        </div> {/* <-- Këtu mbyllet Kutia e Re Fleksible */}

        <Footer />

        <script>
            const shareBtn = document.getElementById("share-button");
            shareBtn?.addEventListener("click", async () => {
                if (navigator.share) {
                    try {
                        await navigator.share({
                            title: document.title,
                            url: window.location.href,
                        });
                    } catch (err) {
                        console.log("Error sharing:", err);
                    }
                } else {
                    navigator.clipboard.writeText(window.location.href);
                    const originalHTML = shareBtn.innerHTML;
                    shareBtn.innerHTML =
                        '<span class="text-white">✓ U kopjua</span>';
                    shareBtn.classList.add("bg-[#DC2626]", "border-[#DC2626]");

                    setTimeout(() => {
                        shareBtn.innerHTML = originalHTML;
                        shareBtn.classList.remove(
                            "bg-[#DC2626]",
                            "border-[#DC2626]"
                        );
                    }, 2000);
                }
            });
        </script>

        {/* ========================================== */}
        {/* SKRIPTI PËR RANDOMIZIMIN E SIDEBAR-IT       */}
        {/* ========================================== */}
        <script is:inline define:vars={{ poolForSidebar }}>
            const initSidebar = () => {
                const container = document.getElementById('sidebar-random-posts');
                if (!container) return;

                const shuffled = [...poolForSidebar].sort(() => 0.5 - Math.random());
                const selected = shuffled.slice(0, 6); // Zgjedhim fiks 8 lajme

                if(selected.length > 0) {
                    container.innerHTML = selected.map(post => `
                        <article class="group !p-0">
                            <a href="${post.slug}" class="no-underline text-inherit flex flex-col gap-2">
                                <div class="w-[85%] xl:w-[75%] aspect-[16/9] overflow-hidden bg-slate-100 rounded-sm shadow-sm">
                                    <img src="${post.heroImage}" alt="${post.title}" class="w-full h-full object-cover group-hover:opacity-90 transition-opacity" loading="lazy" />
                                </div>
                                
                                <div class="flex flex-col w-[85%] xl:w-[75%] mt-1">
                                    <div class="text-[9px] font-bold text-[#b91c1c] uppercase tracking-wider mb-0.5 font-sans">
                                        ${post.tag}
                                    </div>
                                    <h3 class="font-serif text-[14px] xl:text-[15px] font-bold text-black leading-snug group-hover:underline decoration-1 underline-offset-2 transition-colors">
                                        ${post.title}
                                    </h3>
                                </div>
                            </a>
                        </article>
                    `).join('');
                }
            };

            // Sigurohemi që ekzekutohet gjithmonë
            initSidebar();
            document.addEventListener('astro:page-load', initSidebar);
            window.addEventListener('pageshow', (event) => {
                if (event.persisted) initSidebar();
            });
        </script>

    </body>
</html>