---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			/* --- 1. MAIN CONTAINER (Fixes text touching edges) --- */
			main {
				width: 100%;
				max-width: 900px; /* Limits width so lines aren't too long to read */
				margin: 0 auto;   /* Centers the article in the middle of screen */
				padding: 2rem 1rem; /* Adds breathing room on Top/Sides */
			}

			/* --- 2. HERO IMAGE (Fixes the messy image) --- */
			.hero-image {
				width: 100%;
				margin-bottom: 2rem; /* Space between image and title */
			}
			
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 8px; /* Nice rounded corners */
				box-shadow: 0 4px 10px rgba(0,0,0,0.1); /* Subtle shadow */
				
				/* CRITICAL FIXES: */
				width: 100%;      /* Force image to fill the width */
				max-width: 100%;  /* Never overflow */
				height: auto;     /* Keep correct shape (don't squash) */
				object-fit: cover;
			}

			/* --- 3. TYPOGRAPHY (Makes text look professional) --- */
			.prose {
				width: 100%;
				max-width: 100%;
				line-height: 1.6;
				color: #333;
				font-size: 1.1rem;
			}
			
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				border-bottom: 1px solid #ddd;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
				font-size: 2.2rem;
				font-weight: 800;
				line-height: 1.2;
			}
			.date {
				margin-bottom: 0.5em;
				color: #666;
				font-size: 0.9rem;
			}

			/* --- 4. IMAGES INSIDE TEXT --- */
			/* This ensures images you paste into the article also look good */
			.prose :global(img) {
				max-width: 100%;
				height: auto;
				border-radius: 8px;
				display: block;
				margin: 20px auto;
			}
			
			/* MOBILE TWEAKS */
			@media (max-width: 720px) {
				main { padding: 1rem; } /* Smaller padding on phones */
				.title h1 { font-size: 1.8rem; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <img width={1020} height={510} src={heroImage} alt="" />}
				</div>
				
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{updatedDate && <div class="last-updated-on">
								Last updated on <FormattedDate date={updatedDate} />
							</div>}
						</div>
						<h1>{title}</h1>
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>